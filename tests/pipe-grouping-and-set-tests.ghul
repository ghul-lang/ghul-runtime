namespace Tests is
    use Ghul

    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class PipeGroupingAndSetOperationsShould is
        init() is
        si

        @Test()
        Chunk_SizeDividesEvenly_ReturnsEqualSizedChunks() is
            let pipe = [1, 2, 3, 4, 5, 6]

            let chunks = pipe |> chunk(2) |> LIST()

            are_equal(3, chunks.count)
            CollectionAssert.are_equal(LIST[int]([1, 2]), chunks[0] |> LIST())
            CollectionAssert.are_equal(LIST[int]([3, 4]), chunks[1] |> LIST())
            CollectionAssert.are_equal(LIST[int]([5, 6]), chunks[2] |> LIST())
        si

        @Test()
        Chunk_SizeDoesNotDivideEvenly_ReturnsShorterFinalChunk() is
            let pipe = [1, 2, 3, 4, 5]

            let chunks = pipe |> chunk(2) |> LIST()

            are_equal(3, chunks.count)
            CollectionAssert.are_equal(LIST[int]([1, 2]), chunks[0] |> LIST())
            CollectionAssert.are_equal(LIST[int]([3, 4]), chunks[1] |> LIST())
            CollectionAssert.are_equal(LIST[int]([5]), chunks[2] |> LIST())
        si

        @Test()
        Chunk_EmptySequence_ReturnsNoChunks() is
            let pipe = empty`[int]()

            are_equal(0, (pipe |> chunk(3) |> LIST()).count)
        si

        @Test()
        Windows_MoreElementsThanSize_ReturnsEachSlidingWindow() is
            let pipe = [1, 2, 3, 4]

            let windows = pipe |> windows(2) |> LIST()

            are_equal(3, windows.count)
            CollectionAssert.are_equal(LIST[int]([1, 2]), windows[0] |> LIST())
            CollectionAssert.are_equal(LIST[int]([2, 3]), windows[1] |> LIST())
            CollectionAssert.are_equal(LIST[int]([3, 4]), windows[2] |> LIST())
        si

        @Test()
        Windows_FewerElementsThanSize_ReturnsNoWindows() is
            let pipe = [1, 2]

            are_equal(0, (pipe |> windows(3) |> LIST()).count)
        si

        @Test()
        GroupBy_Elements_BucketsByKey() is
            let pipe = ["a", "bb", "ccc", "dd", "e"]

            let groups = pipe |> group_by(s => s.length)

            CollectionAssert.are_equal(LIST[string](["a", "e"]), groups[1] |> LIST())
            CollectionAssert.are_equal(LIST[string](["bb", "dd"]), groups[2] |> LIST())
            CollectionAssert.are_equal(LIST[string](["ccc"]), groups[3] |> LIST())
        si

        @Test()
        UnionWith_OverlappingSequences_ReturnsDistinctElementsFromBoth() is
            let pipe = [1, 2, 3]

            assert_are_equal([1, 2, 3, 4], pipe | [3, 4])
        si

        @Test()
        IntersectWith_OverlappingSequences_ReturnsDistinctCommonElements() is
            let pipe = [1, 2, 2, 3]

            assert_are_equal([2, 3], pipe |> intersect([2, 3, 4]))
        si

        @Test()
        Except_OverlappingSequences_ReturnsDistinctElementsNotInOther() is
            let pipe = [1, 2, 2, 3]

            assert_are_equal([1], pipe |> except([2, 3, 4]))
        si

        @Test()
        set_operators__union_intersection_and_difference__give_each_element_once() is
            assert_are_equal([1, 2, 3, 4], [1, 2, 3, 3] | [3, 4])
            assert_are_equal([3], [1, 2, 3, 3] & [3, 4])
            assert_are_equal([1, 2], [1, 2, 3, 3] -- [3, 4])
            assert_are_equal([2, 3], [1, 2] ++ [3] -- [1])
            assert_are_equal([3, 2, 4, 9], [1, 2, 3] & [3, 4] | [2, 4, 9])
        si

        @Test()
        set_operators__leave_integer_and_flags_operators_alone() is
            are_equal(7, 5 | 2)
            are_equal(2, 6 & 3)
            are_equal(3, [1, 2, 3] |> reduce(0, (a, b) => a | b))
        si
    si
si
