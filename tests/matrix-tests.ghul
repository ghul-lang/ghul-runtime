namespace Tests is
    use Collections
    use Microsoft.VisualStudio.TestTools.UnitTesting

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class MatrixShould is
        init() is
        si

        thrown(action: () -> void) -> bool is
            try
                action()
            catch e: System.Exception
                return true
            yrt

            return false
        si

        @Test()
        Array_2_FromRows_ReadsElementsAndRows() is
            let m = ARRAY_2([[1, 2, 3], [4, 5, 6]])

            are_equal(2, m.count)
            are_equal(6, m[1, 2])
            are_equal("[4, 5, 6]", "{m[1]}")
            are_equal(3, m.lengths.columns)
            are_equal("1 2 3 4 5 6", m.elements |> Ghul.Pipes.join(" "))
            are_equal("[[1, 2, 3], [4, 5, 6]]", "{m}")
        si

        @Test()
        Array_2_FromRowsOfDifferentLengths_Throws() is
            is_true(thrown(() is ARRAY_2([[1, 2], [3]]); si))
        si

        @Test()
        Array_2_FillFromFunction_PutsEachCellInPlace() is
            let m = ARRAY_2(2, 3, (row: int, column: int) -> int => row * 10 + column)

            are_equal(12, m[1, 2])
            are_equal(0, m[0, 0])
        si

        @Test()
        Indexing_OutOfRange_Throws() is
            let m = ARRAY_2([[0, 0, 0], [0, 0, 0]])

            is_true(thrown(() is m[2, 0]; si))
            is_true(thrown(() is m[0, 3]; si))
            is_true(thrown(() is m[-1, 0]; si))
        si

        @Test()
        Matrix_2_SetsElementsVisibleThroughRows() is
            let m = MATRIX[int](2, 3)
            let row = m[1]

            m[1, 2] = 7

            are_equal(7, m[1, 2])
            are_equal(7, row[2])
            are_equal(0, m[0, 2])
        si

        @Test()
        Matrix_2_FromFunction_FillsEveryCell() is
            let m = MATRIX(3, 2, (row: int, column: int) -> int => row + column)

            are_equal(3, m[2, 1])
        si

        @Test()
        Matrix_2_CopiesFromRows() is
            let source = ARRAY_2([[1, 2], [3, 4]])
            let copy = MATRIX(source)

            copy[0, 0] = 9

            are_equal(9, copy[0, 0])
            are_equal(1, source[0, 0])
        si

        @Test()
        Equality_ComparesExtentsAndElements() is
            let a = ARRAY_2([[1, 2], [3, 4]])
            let b = MATRIX(a)
            let c = ARRAY_2([[1, 2, 3, 4]])

            is_true(a =~ b)
            is_false(a =~ c)
            are_equal(a.get_hash_code(), b.get_hash_code())

            b[1, 1] = 0

            is_false(a =~ b)
        si

        @Test()
        Matrix2_IsCovariant() is
            let strings: Matrix2[string] = ARRAY_2([["a", "b"]])
            let objects: Matrix2[object] = strings

            are_equal("b", "{objects[0, 1]}")
        si

        @Test()
        Matrix_3_ReadsPlanesRowsAndElements() is
            let m = MATRIX[int](2, 2, 3)

            m[1, 0, 2] = 5

            are_equal(5, m[1, 0, 2])
            are_equal(5, m[1][0, 2])
            are_equal(2, m.count)
            are_equal("[[0, 0, 0], [0, 0, 0]]", "{m[0]}")
        si

        @Test()
        Array_3_FillFromFunction_PutsEachCellInPlace() is
            let m = ARRAY_3(2, 2, 2, (plane: int, row: int, column: int) -> int => plane * 100 + row * 10 + column)

            are_equal(111, m[1, 1, 1])
            are_equal(10, m[0, 1, 0])
        si

        // A grid of function values is built from its rows, or by a
        // function returning the function for each cell.
        @Test()
        Matrix_2_OfFunctions_IsBuiltByAFunctionReturningThem() is
            let m = MATRIX(1, 2, (row: int, column: int) -> (int -> int) => (x: int) -> int => x + column)

            are_equal(11, m[0, 1](10))
        si

        @Test()
        Array_3_FromPlanesOfDifferentShapes_Throws() is
            is_true(thrown(() is ARRAY_3([[[1, 2]], [[1], [2]]]); si))
        si

        @Test()
        Matrix3_PlanesAreViews() is
            let m = MATRIX(2, 1, 2, (plane: int, row: int, column: int) -> int => 0)
            let plane = m[1]

            m[1, 0, 1] = 3

            are_equal(3, plane[0, 1])
        si
    si
si
