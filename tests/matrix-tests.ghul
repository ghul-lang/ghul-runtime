namespace Tests is
    use Collections
    use Ghul.Pipes
    use Microsoft.VisualStudio.TestTools.UnitTesting

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class MatrixShould is
        init() is
        si

        thrown(action: () -> void) -> bool is
            try
                action()
            catch e: System.Exception
                return true
            yrt

            return false
        si

        @Test()
        Array_2_FromRows_ReadsElementsAndRows() is
            let m = ARRAY_2([[1, 2, 3], [4, 5, 6]])

            are_equal(2, m.count)
            are_equal(6, m[1, 2])
            are_equal("[4, 5, 6]", "{m[1]}")
            are_equal(3, m.lengths.columns)
            are_equal("1 2 3 4 5 6", m.elements |> join(" "))
            are_equal("[[1, 2, 3], [4, 5, 6]]", "{m}")
        si

        @Test()
        Array_2_FromRowsOfDifferentLengths_Throws() is
            is_true(thrown(() is ARRAY_2([[1, 2], [3]]); si))
        si

        @Test()
        Array_2_FromSource_FillsRowByRow() is
            let m = ARRAY_2(1::6, 2, 3)

            are_equal(6, m[1, 2])
            are_equal(2, m[0, 1])
        si

        @Test()
        Indexing_OutOfRange_Throws() is
            let m = repeat(0) |> ARRAY_2(2, 3)

            is_true(thrown(() is m[2, 0]; si))
            is_true(thrown(() is m[0, 3]; si))
            is_true(thrown(() is m[-1, 0]; si))
        si

        @Test()
        Matrix_2_FromAnUnboundedSource_TakesOnlyWhatItNeeds() is
            let m = repeat('.') |> MATRIX(5, 4)

            are_equal('.', m[4, 3])
            are_equal(5, m.count)
        si

        @Test()
        Matrix_2_FromAShortSource_Throws() is
            is_true(thrown(() is [1, 2, 3] |> MATRIX(2, 2); si))
        si

        @Test()
        Matrix_2_SetsElementsVisibleThroughRows() is
            let m = repeat(0) |> MATRIX(2, 3)
            let row = m[1]

            m[1, 2] = 7

            are_equal(7, m[1, 2])
            are_equal(7, row[2])
            are_equal(0, m[0, 2])
        si

        @Test()
        Matrix_2_FromCountingSource_FillsInOrder() is
            let m = from(1) |> MATRIX(3, 3)

            are_equal(9, m[2, 2])
            are_equal(4, m[1, 0])
        si

        @Test()
        Matrix_2_CopiesFromRows() is
            let source = ARRAY_2([[1, 2], [3, 4]])
            let copy = source |> MATRIX()

            copy[0, 0] = 9

            are_equal(9, copy[0, 0])
            are_equal(1, source[0, 0])
        si

        @Test()
        Equality_ComparesExtentsAndElements() is
            let a = ARRAY_2([[1, 2], [3, 4]])
            let b = MATRIX(a)
            let c = ARRAY_2([[1, 2, 3, 4]])

            is_true(a =~ b)
            is_false(a =~ c)
            are_equal(a.get_hash_code(), b.get_hash_code())

            b[1, 1] = 0

            is_false(a =~ b)
        si

        @Test()
        Matrix2_IsCovariant() is
            let strings: Matrix2[string] = ARRAY_2([["a", "b"]])
            let objects: Matrix2[object] = strings

            are_equal("b", "{objects[0, 1]}")
        si

        // A matrix of function values is built from a source of them.
        @Test()
        Matrix_2_OfFunctions_IsBuiltFromASourceOfThem() is
            let m = [(x: int) -> int => x + 1, (x: int) -> int => x * 2] |> MATRIX(1, 2)

            are_equal(20, m[0, 1](10))
        si

        @Test()
        Matrix_3_ReadsPlanesRowsAndElements() is
            let m = repeat(0) |> MATRIX(2, 2, 3)

            m[1, 0, 2] = 5

            are_equal(5, m[1, 0, 2])
            are_equal(5, m[1][0, 2])
            are_equal(2, m.count)
            are_equal("[[0, 0, 0], [0, 0, 0]]", "{m[0]}")
        si

        @Test()
        Array_3_FromSource_FillsPlaneByPlane() is
            let m = from(0) |> ARRAY_3(2, 2, 2)

            are_equal(7, m[1, 1, 1])
            are_equal(2, m[0, 1, 0])
        si

        @Test()
        Array_3_FromPlanesOfDifferentShapes_Throws() is
            is_true(thrown(() is ARRAY_3([[[1, 2]], [[1], [2]]]); si))
        si

        // Planes of rows are also rows of lists, so the rank comes from the
        // type argument: `MATRIX(planes)` is a matrix of lists.
        @Test()
        Matrix_3_FromPlanes_Copies() is
            let m = MATRIX[int]([[[1, 2]], [[3, 4]]])

            are_equal(4, m[1, 0, 1])
        si

        @Test()
        Matrix3_PlanesAreViews() is
            let m = repeat(0) |> MATRIX(2, 1, 2)
            let plane = m[1]

            m[1, 0, 1] = 3

            are_equal(3, plane[0, 1])
        si
        // m[i, j] is fast on .NET only while each class's index helper is
        // inlined into the indexer, which the JIT doesn't do by itself once
        // the helper calls out to throw.
        @Test()
        Element_Index_Helpers_AreMarkedForInlining() is
            let flags = System.Reflection.BindingFlags.INSTANCE | System.Reflection.BindingFlags.NON_PUBLIC

            for (type, name) in [
                (typeof MATRIX_2_VIEW[int], "_view_index"),
                (typeof ARRAY_2[int], "_array_index"),
                (typeof MATRIX_2[int], "_position"),
                (typeof MATRIX_3_VIEW[int], "_view_index"),
                (typeof ARRAY_3[int], "_array_index"),
                (typeof MATRIX_3[int], "_position")
            ] do
                let method = type.get_method(name, flags)!
                let inlined = (cast int(method.method_implementation_flags) & cast int(System.Reflection.MethodImplAttributes.AGGRESSIVE_INLINING)) != 0

                are_equal("{type.name}.{name} inlined", "{type.name}.{name} {if inlined then "inlined" else "not inlined" fi}")
            od
        si
    si
si
