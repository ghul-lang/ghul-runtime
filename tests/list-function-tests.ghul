namespace Tests is
    use Ghul
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // Coverage for sum_by, last, group, transpose, permutations, scan and iterate.
    @TestClass()
    class ListFunctionsShould is
        init() is
        si

        @Test()
        SumBy_SumsTheProjection() is
            are_equal(20, Ghul.Pipes.sum_by([1, 2, 3, 4], n => n * 2))
        si

        @Test()
        SumBy_OfNothing_IsZero() is
            are_equal(0, Ghul.Pipes.sum_by(empty`[int](), n => n))
        si

        @Test()
        Last_ReturnsTheFinalElement() is
            are_equal(MAYBE(3), Ghul.Pipes.last([1, 2, 3]))
        si

        @Test()
        Last_OfNothing_IsAbsent() is
            are_equal(MAYBE[int](), Ghul.Pipes.last(empty`[int]()))
        si

        @Test()
        Group_GathersAdjacentEquals() is
            let runs =
                Ghul.Pipes.group([1, 1, 2, 3, 3, 3])
                    |> map(run => run |> join(""))
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST(["11", "2", "333"]), runs)
        si

        @Test()
        Group_SeparatesEqualsThatAreNotAdjacent() is
            let runs =
                Ghul.Pipes.group([1, 2, 1])
                    |> map(run => run.count)
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST([1, 1, 1]), runs)
        si

        @Test()
        Group_OfNothing_YieldsNothing() is
            are_equal(0, Ghul.Pipes.group(empty`[int]()) |> count())
        si

        @Test()
        Group_ReadTwice_YieldsTheSameRuns() is
            let runs = Ghul.Pipes.group([1, 1, 2])

            are_equal(2, runs |> count())
            are_equal(2, runs |> count())
        si

        @Test()
        Transpose_ExchangesRowsAndColumns() is
            let rows = LIST([LIST([1, 2, 3]), LIST([4, 5, 6])])

            let columns =
                Ghul.Pipes.transpose(rows)
                    |> map(column => column |> join(""))
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST(["14", "25", "36"]), columns)
        si

        @Test()
        Transpose_RaggedRows_StopsAtTheShortest() is
            let rows = LIST([LIST([1, 2, 3]), LIST([4, 5])])

            are_equal(2, Ghul.Pipes.transpose(rows) |> count())
        si

        @Test()
        Transpose_OfNothing_YieldsNothing() is
            are_equal(0, Ghul.Pipes.transpose(LIST[LIST[int]]()) |> count())
        si

        @Test()
        Transpose_ArrayOfArrays_ExchangesRowsAndColumns() is
            let rows = [[1, 2, 3], [4, 5, 6]]

            let columns =
                Ghul.Pipes.transpose(rows)
                    |> map(column => column |> join(""))
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST(["14", "25", "36"]), columns)
        si

        @Test()
        Transpose_PipeOfPipes_ExchangesRowsAndColumns() is
            let rows =
                [[1, 2, 3], [4, 5, 6]]
                    |> map(row => row |> filter(n => true))

            let columns =
                Ghul.Pipes.transpose(rows)
                    |> map(column => column |> join(""))
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST(["14", "25", "36"]), columns)
        si

        @Test()
        Permutations_ProducesEveryOrdering() is
            let orderings =
                Ghul.Pipes.permutations([1, 2, 3])
                    |> map(one => one |> join(""))
                    |> collect_mutable()

            CollectionAssert.are_equal(
                LIST(["123", "132", "213", "231", "312", "321"]), orderings)
        si

        @Test()
        Permutations_OfNothing_YieldsTheEmptyOrdering() is
            are_equal(1, Ghul.Pipes.permutations(empty`[int]()) |> count())
        si

        @Test()
        Permutations_CountIsFactorial() is
            are_equal(24, Ghul.Pipes.permutations([1, 2, 3, 4]) |> count())
        si

        @Test()
        GroupWithJoins_SplitsWhereNeighboursDoNotJoin() is
            let runs =
                Ghul.Pipes.group([0, 1, 2, 4, 6, 7, 8, 11], (a, b) => b == a + 1)
                    |> map(run => run |> join(","))
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST(["0,1,2", "4", "6,7,8", "11"]), runs)
        si

        @Test()
        GroupWithJoins_ComparesEachElementWithTheOneBeforeIt() is
            let runs =
                Ghul.Pipes.group([1, 2, 3, 4], (a, b) => b - a == 1)
                    |> map(run => run.count)
                    |> collect_mutable()

            CollectionAssert.are_equal(LIST([4]), runs)
        si

        @Test()
        GroupWithJoins_OfNothing_YieldsNothing() is
            are_equal(0, Ghul.Pipes.group(empty`[int](), (a, b) => true) |> count())
        si

        @Test()
        GroupWithJoins_ReadTwice_YieldsTheSameRuns() is
            let runs = Ghul.Pipes.group([1, 2, 5], (a, b) => b == a + 1)

            are_equal(2, runs |> count())
            are_equal(2, runs |> count())
        si

        @Test()
        Scan_StartsWithTheSeedThenEachRunningTotal() is
            CollectionAssert.are_equal(
                LIST([0, 1, 3, 6]),
                Ghul.Pipes.scan([1, 2, 3], 0, (total, n) => total + n) |> collect_mutable())
        si

        @Test()
        Scan_LastElementIsTheReduceResult() is
            let xs = [3, 1, 4, 1, 5]

            are_equal(
                xs |> reduce(1, (p, n) => p * n),
                Ghul.Pipes.scan(xs, 1, (p, n) => p * n) |> last() ?? -1)
        si

        @Test()
        Scan_CanChangeTheElementType() is
            are_equal(
                "|a|ab|abc",
                Ghul.Pipes.scan(["a", "b", "c"], "", (text, s) => "{text}{s}") |> join("|"))
        si

        @Test()
        Scan_OfNothing_IsJustTheSeed() is
            CollectionAssert.are_equal(
                LIST([7]),
                Ghul.Pipes.scan(empty`[int](), 7, (total, n) => total + n) |> collect_mutable())
        si

        @Test()
        Scan_IsLazyOverAnUnboundedSource() is
            CollectionAssert.are_equal(
                LIST([0, 1, 3, 6, 10]),
                Ghul.Pipes.scan(from(1), 0, (total, n) => total + n) |> take(5) |> collect_mutable())
        si

        @Test()
        Scan_ReadTwice_StartsAgainFromTheSeed() is
            let totals = Ghul.Pipes.scan([1, 2], 10, (total, n) => total + n)

            are_equal("10,11,13", totals |> join(","))
            are_equal("10,11,13", totals |> join(","))
        si

        @Test()
        Iterate_StartsWithTheSeedThenAppliesNextRepeatedly() is
            CollectionAssert.are_equal(
                LIST([1, 2, 4, 8, 16]),
                Ghul.Pipes.iterate(1, n => n * 2) |> take(5) |> collect_mutable())
        si

        @Test()
        Iterate_SpreadsATupleSeedOverNext() is
            let fibonacci =
                Ghul.Pipes.iterate((0, 1), (a, b) => (b, a + b))
                    |> map((a, _) => a)
                    |> take(8)
                    |> join(",")

            are_equal("0,1,1,2,3,5,8,13", fibonacci)
        si

        @Test()
        Iterate_ReadTwice_StartsAgainFromTheSeed() is
            let powers = Ghul.Pipes.iterate(3, n => n * 3)

            are_equal("3,9,27", powers |> take(3) |> join(","))
            are_equal("3,9,27", powers |> take(3) |> join(","))
        si
    si
si
