namespace Tests is
    use Ghul
    use Collections

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use Ghul.Pipes
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    // A total several iterators bump, so a test can count what a
    // source has handed out across reads.
    class TOTAL is
        count: int public

        init() is
        si

        bump() is
            count = count + 1
        si
    si

    // An iterator that counts the elements it hands out into a total a
    // test reads, so a test can tell a read that continues a positioned
    // iterator from one that re-derives from the source.
    class COUNTING_ITERATOR[T]: Iterator[T] is
        values: ARRAY[T]
        _at: int
        _total: TOTAL

        init(values: ARRAY[T], total: TOTAL) is
            self.values = values
            _total = total
        si

        current: T => values[_at - 1]

        move_next() -> bool is
            if _at < values.count then
                _at = _at + 1
                _total.bump()
                return true
            fi

            return false
        si

        reset() is
            _at = 0
        si

        dispose() is
        si
    si

    // A source each read of which takes a fresh counting iterator, all
    // bumping one total.
    class COUNTING_READER_SOURCE[T]: Iterable[T] is
        values: ARRAY[T]
        total: TOTAL field

        handed_out: int => total.count

        init(values: ARRAY[T]) is
            self.values = values
            total = TOTAL()
        si

        iterator: Iterator[T] => COUNTING_ITERATOR[T](values, total)
    si

    // Coverage for the buffered pipe stages: the prefix comes first on
    // every read, the first read continues the iterator the stage was
    // built from without re-reading the source, and every later read
    // re-derives from the source, skipping to where the prefix ends, so
    // nothing of the tail is ever buffered.
    @TestClass()
    class BUFFERED_PIPEShould is
        init() is
        si

        @Test()
        Read_YieldsPrefixThenTailInOrder() is
            let source = [3, 4, 5]
            let p = BUFFERED_1_PIPE[int](1, source, 0, source.iterator)

            assert_elements([1, 3, 4, 5], drain(p))
        si

        @Test()
        Read_NoPrefix_SkipsToWhereThePrefixWouldEnd() is
            let source = [1, 2, 3, 4]
            let p = BUFFERED_0_PIPE[int](source, 2, null)

            assert_elements([3, 4], drain(p))
        si

        @Test()
        Read_SkipAdjustsTheTail() is
            let source = ["a", "b", "c", "d"]
            let p = BUFFERED_1_PIPE[string]("x", source, 2, null)

            assert_elements(["x", "c", "d"], drain(p))
        si

        @Test()
        Read_ContinuesTheLiveIteratorWithoutRereadingTheSource() is
            let source = COUNTING_READER_SOURCE[int]([1, 2, 3, 4])
            let live = source.iterator

            // The pull a pattern would have made: two elements taken.
            is_true(live.move_next())
            is_true(live.move_next())
            are_equal(2, source.handed_out)

            // One element was pulled past what the arm matched.
            let p = BUFFERED_1_PIPE[int](2, source, 2, live)

            assert_elements([2, 3, 4], drain(p))
            are_equal(4, source.handed_out)
        si

        @Test()
        Read_Twice_SecondReadReDerivesFromTheSource() is
            let source = COUNTING_READER_SOURCE[int]([1, 2, 3, 4])
            let live = source.iterator

            is_true(live.move_next())
            are_equal(1, source.handed_out)

            let p = BUFFERED_1_PIPE[int](0, source, 1, live)

            assert_elements([0, 2, 3, 4], drain(p))
            are_equal(4, source.handed_out)

            // The second read replays the prefix from the stage's fields
            // and re-derives the tail: one skipped element and the tail
            // again.
            assert_elements([0, 2, 3, 4], drain(p))
            are_equal(8, source.handed_out)
        si

        @Test()
        Read_EmptyTail_YieldsOnlyThePrefix() is
            let source = ["x", "y"]
            let p = BUFFERED_2_PIPE[string]("a", "b", source, 2, null)

            assert_elements(["a", "b"], drain(p))

            let first = p.iterator

            is_true(first.move_next())
            is_true(first.move_next())
            is_false(first.move_next())
        si

        @Test()
        Read_SkipPastTheEnd_YieldsOnlyThePrefix() is
            let source = ["x"]
            let p = BUFFERED_1_PIPE[string]("a", source, 5, null)

            assert_elements(["a"], drain(p))
        si

        @Test()
        Read_OverInfiniteTail_PullsOnlyWhatIsConsumed() is
            let naturals = stream(0, n => n || n + 1)
            let p = BUFFERED_1_PIPE[int](-1, naturals, 0, null)

            are_equal("-1, 0, 1", p |> take(3) |> join(", "))

            // A later read re-derives: the prefix replays, the two tail
            // elements are taken from a fresh iterator, and the stream
            // is asked for one more.
            are_equal("-1, 0, 1, 2", p |> take(4) |> join(", "))
        si
    si
si
