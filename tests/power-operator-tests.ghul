namespace Tests is
    use Ghul
    use Ghul.Math.`**

    use Microsoft.VisualStudio.TestTools.UnitTesting

    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute

    @TestClass()
    class PowerOperatorShould is
        init() is si

        @Test()
        Raise_each_integer_type() is
            are_equal(1024, 2 ** 10)
            are_equal(-27, -3 ** 3)
            are_equal(1099511627776L, 2L ** 40)
            are_equal(3486784401u, 3u ** 20)
            are_equal(12157665459056928801ul, 3ul ** 40)
            are_equal(cast word(1024), cast word(2) ** 10)
            are_equal(cast uword(1024), cast uword(2) ** 10)
            are_equal(1267650600228229401496703205376n, 2n ** 100)
        si

        @Test()
        Give_one_for_a_zero_exponent() is
            are_equal(1, 0 ** 0)
            are_equal(1L, 7L ** 0)
            are_equal(1ul, 0ul ** 0)
            are_equal(1m, 0m ** 0)
            are_equal(1n, 0n ** 0)
            are_equal(1.0, 0.0 ** 0.0)
        si

        @Test()
        Reach_the_edges_of_each_range() is
            are_equal(1073741824, 2 ** 30)
            are_equal(-2147483647 - 1, -2 ** 31)
            are_equal(4611686018427387904L, 2L ** 62)
            are_equal(-9223372036854775807L - 1L, -2L ** 63)
            are_equal(2147483648u, 2u ** 31)
            are_equal(9223372036854775808ul, 2ul ** 63)
            are_equal(1, -1 ** 2147483647 * -1)
        si

        @Test()
        Throw_on_overflow() is
            throws_overflow(() => 2 ** 31)
            throws_overflow(() => -2 ** 32)
            throws_overflow(() => 10 ** 10)
            throws_overflow(() => 2L ** 63)
            throws_overflow(() => 3L ** 40)
            throws_overflow(() => 2u ** 32)
            throws_overflow(() => 2ul ** 64)
            throws_overflow(() => 3ul ** 41)
        si

        @Test()
        Name_the_power_and_type_on_overflow() is
            try
                2 ** 31
                fail("expected 2 ** 31 to throw")
            catch e: System.OverflowException
                are_equal("2 ** 31 is too large for int: raise a bigint for an exact result", e.message)
            yrt
        si

        @Test()
        Throw_on_a_negative_integer_exponent() is
            throws_out_of_range(() => 2 ** -1)
            throws_out_of_range(() => 2L ** -1)
            throws_out_of_range(() => 2u ** -1)
            throws_out_of_range(() => 2ul ** -1)
            throws_out_of_range(() => 2n ** -1)
        si

        @Test()
        Take_a_reciprocal_for_a_negative_decimal_exponent() is
            are_equal(1024m, 2m ** 10)
            are_equal(0.125m, 2m ** -3)
            are_equal(1.21m, 1.1m ** 2)
        si

        @Test()
        Match_pow_for_floats() is
            are_equal(System.Math.pow(2.0, 0.5), 2.0 ** 0.5)
            are_equal(System.Math.pow(10.0, -2.0), 10.0 ** -2.0)
            are_equal(single(System.Math.pow(2.0, 10.0)), 2.0s ** 10.0s)
            is_true(Ghul.Math.is_nan(-8.0 ** (1.0 / 3.0)))
        si

        throws_overflow[T](f: () -> T) is
            try
                f()
                fail("expected OverflowException")
            catch e: System.OverflowException
            yrt
        si

        throws_out_of_range[T](f: () -> T) is
            try
                f()
                fail("expected ArgumentOutOfRangeException")
            catch e: System.ArgumentOutOfRangeException
            yrt
        si
    si
si
