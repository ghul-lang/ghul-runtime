@@suppress("pipe-fusion")

// A runtime terminal disposes the iterator it took, whether it reads to the
// end or stops early, and a stage passes the dispose on to its source. A
// cursor borrows its iterator, so reading one disposes nothing.
use IO.Std.write_line
use Ghul.Pipes

class LOGGED: Collections.Iterable[int] is
    _name: string

    init(name: string) is
        _name = name
    si

    iterator: Collections.Iterator[int] =>
        LOGGED_ITERATOR(_name)
si

class LOGGED_ITERATOR: Collections.Iterator[int] is
    _name: string
    _next: int

    init(name: string) is
        _name = name
        write_line("open {name}")
    si

    current: int => _next

    move_next() -> bool is
        _next = _next + 1

        return _next <= 5
    si

    reset() is
        _next = 0
    si

    dispose() is
        write_line("dispose {_name}")
    si
si

entry() is
    write_line("first {LOGGED("first") |> first()}")
    write_line("find {LOGGED("find") |> find(x => x == 2)}")
    write_line("any {LOGGED("any") |> any(x => x > 1)}")
    write_line("all {LOGGED("all") |> all(x => x < 3)}")
    write_line("count {LOGGED("count") |> count()}")
    write_line("reduce {LOGGED("reduce") |> reduce(0, (a, x) => a + x)}")
    write_line("take {LOGGED("take") |> take(2) |> count()}")
    write_line("map {LOGGED("map") |> map(x => x * 2) |> first()}")

    let twice = LOGGED("twice") |> map(x => x + 1)

    write_line("twice {twice |> count()}")
    write_line("twice {twice |> count()}")

    let it = LOGGED("cursor").iterator
    let header = cursor(it) |> first()

    write_line("cursor {header}")
    write_line("cursor rest {cursor(it) |> count()}")

    it.dispose()
si
