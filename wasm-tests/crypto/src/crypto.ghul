// The digests, with the Crypto functions and through the types under their
// Crypto and System.Security.Cryptography names.
use default
use Crypto.md5
use Crypto.sha1
use Crypto.sha256
use Crypto.random_bytes
use Crypto.random_int
use Text.to_hex_lower

let abc = Text.Encoding.ascii.get_bytes("abc")

write_line(to_hex_lower(md5(abc)))
write_line(to_hex_lower(sha1(abc)))
write_line(to_hex_lower(sha256(abc)))
write_line(to_hex_lower(sha256(Text.Encoding.ascii.get_bytes(""))))
write_line("{to_hex_lower(Crypto.MD5.hash_data(abc)) =~ to_hex_lower(System.Security.Cryptography.MD5.hash_data(abc))}")
write_line("{to_hex_lower(Crypto.SHA256.hash_data(abc)) =~ to_hex_lower(sha256(abc))}")

let draws = 0::999 |> map(_ => random_int(7)) |> ARRAY()
let ranged = 0::999 |> map(_ => random_int(-3, 4)) |> ARRAY()
write_line("{random_bytes(16).count} {random_bytes(0).count} {draws |> all(d => d >= 0 /\ d < 7)} {ranged |> all(d => d >= -3 /\ d < 4)} {random_int(5, 6)}")

let random: Crypto.RandomNumberGenerator = System.Security.Cryptography.RandomNumberGenerator.create()
write_line("{Crypto.RandomNumberGenerator.get_bytes(4).count} {random == random} {Crypto.RandomNumberGenerator.get_int32(1)}")
