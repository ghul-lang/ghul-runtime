// The pipe functions that sort, group, index, collect into maps and sets
// and combine sequences, compiled for the wasm target, print what the same
// program prints on .NET, ties in a sort included.
use IO.Std.write_line
use Ghul.Pipes
use Ghul.MAYBE

let xs = [5, 3, 8, 1, 3]
write_line("{xs |> sort() |> join(", ")}")
write_line("{xs |> distinct() |> join(", ")}")
write_line("{xs |> index() |> map(iv => iv.index * iv.value) |> join(", ")}")
let m = xs |> distinct() |> collect_map(x => x, x => x * x)
write_line("{m[8]}")
let g = xs |> group_by(x => x % 2)
write_line("{g[1].count}")
write_line("{xs |> collect_set() |> count()}")
write_line("{xs |> sort_by(x => -x) |> join(", ")}")
let words = ["pear", "fig", "kiwi", "apple", "date", "plum", "lime", "nut", "yam"]
write_line("{words |> sort_by(w => w.length) |> join(" ")}")
write_line("{words |> sort_by_descending(w => w.length) |> join(" ")}")
write_line("{words |> group_by(w => w.length) |> map(kv => "{kv.key}:{kv.value.count}") |> join(" ")}")
write_line("{xs |> sort_descending() |> join(", ")}")
write_line("{xs |> sort((a, b) => b - a) |> join(", ")}")
write_line("{[1, 2, 3] |> except([2]) |> join(", ")} {[1, 2, 3] |> intersect_with([2, 3, 4]) |> join(", ")} {[1, 2] |> union_with([2, 3]) |> join(", ")}")
write_line("{[1, 1, 2, 2, 2, 3] |> group() |> map(g => g.count) |> join(", ")}")
write_line("{xs |> index(10) |> map(iv => iv.index) |> join(", ")}")
write_line("{[0, 1, 2, 4, 6, 7, 11] |> group((a, b) => b == a + 1) |> map(g => g.count) |> join(", ")}")
write_line("{[1, 2, 3, 4] |> scan(0, (total, n) => total + n) |> join(", ")}")
write_line("{iterate((0, 1), (a, b) => (b, a + b)) |> map((a, _) => a) |> take(8) |> join(", ")}")
write_line("{digits(1234) |> join(", ")} {digits(0) |> join(", ")} {digits(255, 16) |> join(", ")} {digits(-12) |> sum()}")
write_line("{Ghul.Pipes.words("  the quick\tfox\n") |> join("|")} {Ghul.Pipes.words(" ") |> count()}")
write_line("{[[1, 2], [], [3]] |> flatten() |> join(", ")}")
write_line("{[1, 2, 4, 7] |> pairwise() |> map((a, b) => b - a) |> join(", ")} {[1, 2, 3, 4, 5] |> take_last(2) |> join(", ")} {[1, 2, 3, 4, 5] |> skip_last(2) |> join(", ")}")
write_line("{([10, 20, 30] |> nth(1))!} {[1, 2, 3] |> Ghul.Pipes.contains(2)} {("hello" |> frequencies())['l']} {([1, 2, 3, 4] |> reduce((a, b) => a * b))!}")
write_line("{["1", "x", "3"] |> filter_map(s => if s =~ "x" then MAYBE[int]() else MAYBE(int.parse(s)) fi) |> join(", ")}")
