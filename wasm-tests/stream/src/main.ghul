use default

// A two-part state, taken spread out.
let fibonacci = stream((0, 1), (a, b) => (a, (b, a + b)))
write_line(fibonacci |> take(10) |> join(","))

// A stream that ends itself by returning null.
let counted = stream(1, n => if n > 5 then null else (n, n + 1) fi)
write_line(counted |> join(","))

let countdown = stream(3, i => if i == 0 then null else (i, i - 1) fi)
write_line(countdown |> join(","))

// A scalar state with an element of the same type.
let squares = stream(1, n => (n * n, n + 1))
write_line(squares |> take(5) |> join(","))

// A tuple state taken as one destructured parameter.
let pell = stream((0, 1), ((x, y)) => (x, (y, 2 * y + x)))
write_line(pell |> take(6) |> join(","))

// A state with named parts.
let named = stream((prev = 0, current = 1), (prev, current) => (current, (prev = current, current = prev + current)))
write_line(named |> take(6) |> join(","))

// A string state.
let doubling = stream("a", s => (s, "{s}{s}"))
write_line(doubling |> take(4) |> join(","))

// The element differs in type from the state.
let labels = stream(1, n => if n > 3 then null else ("step {n}", n + 1) fi)
write_line(labels |> join(","))
