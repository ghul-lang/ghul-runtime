// The set operators over sequences: union `|`, intersection `&` and
// difference `--`, beside the integer, bigint and flags meanings of `|` and
// `&`, which they leave alone.
use default

@Ghul.Flags()
enum Perm is
    READ = 1,
    WRITE = 2
si

class Animal(name: string) is
    to_string() -> string => name
si

class Cat: Animal is
    init(name: string) is super.init(name) si
si

class Dog: Animal is
    init(name: string) is super.init(name) si
si

entry() is
    let xs = [1, 2, 3, 3]
    let ys = [3, 4]
    let zs = [2, 4, 9]

    write_line("{5 | 2} {6 & 3} {Perm.READ | Perm.WRITE} {0xFF0n | 0x00Fn} {0xFF0n & 0x0F0n}")
    write_line("{xs | ys} {xs & ys} {xs -- ys}")
    write_line("{SET([1, 2]) | LIST([2, 5])} {SET([1, 2]) & LIST([2, 5])}")
    write_line("{"abc" | "bcd" |> string()}")
    write_line("{(1::3) | (2::5)} {(1::3) & (2::5)}")
    write_line("{xs | ys |> count()} {xs ++ ys | zs} {xs & ys | zs} {[1, 2] ++ [3] -- [1]}")
    write_line("{[1, 2] | xs} {xs | [7]}")

    let none: int{} = []
    write_line("{xs | none} {none | xs}")
    write_line("{[1, 2, 3] |> reduce(0, (a, b) => a | b)} {[[1, 2], [2, 3]] |> reduce(none, (acc, s) => acc | s)}")

    let cats = [Cat("tom")]
    let dogs = [Dog("rex")]
    write_line("{cats | dogs}")
si
