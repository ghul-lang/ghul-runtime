namespace Ghul.Internal is
    use Collections

    /// Reverse iterators the compiler's fused loops call where a chain's
    /// innermost stage is `reverse` and the source's static type proves
    /// it indexable, instead of reading the source forwards. Not
    /// reachable from source; `Ghul.Pipes.reverse` is the spelling users
    /// write.
    class REVERSE_ITERATORS is
        /// A reverse iterator over `source`'s elements, with no storage
        /// allocated for them.
        reverse_iterator[T](source: List[T]) -> Iterator[T] static pure =>
            LIST_REVERSE_ITERATOR[T](source)

        /// A reverse iterator over a `..` range's elements, with no
        /// storage allocated for them.
        reverse_iterator(source: INT_RANGE) -> Iterator[int] static pure =>
            INT_RANGE_REVERSED(source.from, source.to)

        /// A reverse iterator over a `::` range's elements, with no
        /// storage allocated for them.
        reverse_iterator(source: INT_RANGE_INCLUSIVE) -> Iterator[int] static pure =>
            INT_RANGE_REVERSED(source.from, source.to + 1)
    si
si
