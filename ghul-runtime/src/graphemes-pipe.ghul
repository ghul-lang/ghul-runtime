namespace Ghul.Pipes is
    use Collections
    use System.Globalization.StringInfo

    /// The text elements of a string, in order: each is what a reader sees
    /// as one character, a grapheme cluster, as
    /// `System.Globalization.StringInfo` finds them.
    class GRAPHEMES_PIPE: PipeStage[string] is
        /// The most recently produced text element.
        current: string

        _text: string

        // Where the next text element starts, in UTF-16 code units.
        _at: int

        init(text: string) is
            super.init()

            _text = text
            _at = 0
            current = ""
        si

        /// A new sequence of the same text elements, not yet read.
        fresh() -> PipeStage[string] => GRAPHEMES_PIPE(_text)

        /// Produces the next text element; ends at the end of the string.
        move_next() -> bool is
            if _at >= _text.length then
                return false
            fi

            let length = StringInfo.get_next_text_element_length(_text, _at)

            current = _text.substring(_at, length)
            _at = _at + length

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si
si
