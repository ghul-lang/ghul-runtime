@@IF.dotnet()
namespace Ghul.Internal is
    use System

    // Marker attribute emitted by the compiler on a function declared
    // `@holds_resource()`: the sequence it returns holds something, such as
    // an open file, that its iterator's dispose releases. Read on
    // cross-assembly import, so a fused chain over such a call disposes its
    // iterator as a runtime terminal does. Compiler-emitted; user code never
    // spells this name.
    class HOLDS_RESOURCE_ATTRIBUTE: Attribute is
        init() is
        si
    si
si
