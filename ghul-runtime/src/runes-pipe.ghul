namespace Ghul.Pipes is
    use Collections
    use System.Text.Rune

    /// The code points of a string, in order, as runes. A surrogate pair is
    /// one rune, and a surrogate that is not part of a pair is the
    /// replacement character, U+FFFD.
    class RUNES_PIPE: PipeStage[Rune] is
        /// The most recently produced rune.
        current: Rune

        _text: string

        // Where the next rune starts, in UTF-16 code units.
        _at: int

        init(text: string) is
            super.init()

            _text = text
            _at = 0
        si

        /// A new sequence of the same runes, not yet read.
        fresh() -> PipeStage[Rune] => RUNES_PIPE(_text)

        /// Produces the next rune; ends at the end of the string.
        move_next() -> bool is
            if _at >= _text.length then
                return false
            fi

            let c = _text[_at]

            if char.is_high_surrogate(c) /\ _at + 1 < _text.length /\ char.is_low_surrogate(_text[_at + 1]) then
                current = Rune(c, _text[_at + 1])
                _at = _at + 2
            elif char.is_surrogate(c) then
                current = Rune.replacement_char
                _at = _at + 1
            else
                current = Rune(c)
                _at = _at + 1
            fi

            return true
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Has no effect.
        dispose() is
        si
    si
si
