/// Helpers for programs that call foreign code through `@extern`.
namespace Ghul.Interop is
    /// The C library's description of the error `code`, an errno value such
    /// as an extern declared with `errno =` answers in its ERROR variant. On
    /// .NET it is the platform's message for the code. There is no errno on
    /// wasm, so this is not declared there.
    ///
    /// - code: the errno value
    @IF.llvm()
    error_text(code: int) -> string => _strerror(code) ?? "unknown error {code}"

    @IF.llvm()
    @extern("", "strerror", result = "copy")
    _strerror(code: int) -> string?

    /// The C library's description of the error `code`, an errno value such
    /// as an extern declared with `errno =` answers in its ERROR variant. On
    /// .NET it is the platform's message for the code. There is no errno on
    /// wasm, so this is not declared there.
    ///
    /// - code: the errno value
    @IF.dotnet()
    error_text(code: int) -> string => System.Runtime.InteropServices.Marshal.get_p_invoke_error_message(code)

    /// The value of type `T` at `offset` bytes past `address`: a scalar at its width, a
    /// `bool` as one byte where nonzero is true, a `char` as one UTF-16 unit, a reference
    /// as a pointer, and a struct as its fields in place, laid out as C lays them out
    /// where it is marked `@layout("c")`. The read is unaligned and unchecked: an address
    /// that isn't readable, or memory that doesn't hold a `T`, is undefined behaviour, as
    /// it is in C.
    ///
    /// - address: where the memory starts, as foreign code handed it over
    /// - offset: how many bytes past `address` the value starts
    @IF.llvm()
    @intrinsic("interop.read")
    read[T](address: word, offset: int) -> T

    /// Writes `value` at `offset` bytes past `address`, laid out as for `read`. The write is unaligned and unchecked: an address that isn't writable is
    /// undefined behaviour, as it is in C.
    ///
    /// - address: where the memory starts, as foreign code handed it over
    /// - offset: how many bytes past `address` the value starts
    /// - value: what to write
    @IF.llvm()
    @intrinsic("interop.write")
    write[T](address: word, offset: int, value: T)

    /// The address of `array`'s first element, valid for as long as `array` is kept
    /// alive and only that long: for an address foreign code keeps, use `PINNER.pin`.
    /// The elements are held one after another, laid out as for `read`.
    ///
    /// - array: the array whose elements foreign code is handed
    @IF.llvm()
    @intrinsic("interop.elements")
    elements[T](array: ARRAY[T]) -> word

    /// The number of bytes a value of `T` takes where it is stored, as one element of an
    /// `ARRAY[T]`: C's `sizeof` for a struct marked `@layout("c")`, and the size of a pointer
    /// for a reference.
    @IF.llvm()
    @intrinsic("type.size_of")
    size_of[T]() -> int

    /// A copy of the NUL-terminated UTF-8 text at `address`, or null where `address` is
    /// zero. Reads up to the first NUL; unchecked, as `read` is.
    ///
    /// - address: the first byte of the text
    @IF.llvm()
    read_utf8(address: word) -> string? =>
        if address == 0w then null else read_utf8(address, int(_strlen(address))) fi

    /// A copy of the `length` bytes of UTF-8 text at `address`, NUL bytes included.
    /// Unchecked, as `read` is.
    ///
    /// - address: the first byte of the text
    /// - length: how many bytes the text is
    @IF.llvm()
    read_utf8(address: word, length: int) -> string =>
        Text.Encoding.utf8.get_string(copy_bytes(address, length))

    /// A copy of the `length` bytes at `address`. Unchecked, as `read` is.
    ///
    /// - address: the first byte
    /// - length: how many bytes to copy
    @IF.llvm()
    copy_bytes(address: word, length: int) -> ARRAY[ubyte] is
        let bytes = Ghul.Pipes.repeat(0ub, length) |> ARRAY()

        if length > 0 then
            _copy_out(bytes, address, word(length))
        fi

        return bytes
    si

    /// Copies every byte of `bytes` to `address`. Unchecked, as `write` is: the memory at
    /// `address` must have room for them all.
    ///
    /// - bytes: what to copy
    /// - address: where the first byte goes
    @IF.llvm()
    copy_bytes(bytes: ARRAY[ubyte], address: word) is
        if bytes.count > 0 then
            _copy_in(address, bytes, word(bytes.count))
        fi
    si

    @IF.llvm()
    @extern("", "strlen")
    _strlen(address: word) -> word

    @IF.llvm()
    @extern("", "memcpy")
    _copy_out(destination: ARRAY[ubyte], source: word, length: word) -> word

    @IF.llvm()
    @extern("", "memmove")
    _copy_in(destination: word, source: ARRAY[ubyte], length: word) -> word

    /// Keeps the values foreign code holds alive until it is disposed, and gives the
    /// addresses of the arrays it pins. A foreign argument is otherwise valid for the
    /// call only: anything the C library keeps a pointer to after the call returns must
    /// be pinned or kept here for as long as the library may use it. The collector
    /// doesn't move objects, so an address stays good while its pin is held.
    ///
    /// Disposing releases every pin at once. Foreign code that still holds an address
    /// after that is a use-after-free, which nothing checks. A facade that owns a C
    /// resource disposes its pinner after it has released the resource, never before.
    ///
    /// The pins are held in a list that grows with each one. Code that pins on every
    /// call, in a loop, makes a pinner for each call and disposes it there, rather
    /// than one that lives as long as the loop.
    @IF.llvm()
    class PINNER: Ghul.Disposable is
        _held: Collections.LIST[object]?

        /// A pinner holding nothing.
        init() is
            _held = Collections.LIST[object]()
        si

        /// The address of `array`'s first element, valid until the pinner is disposed;
        /// `array` is kept alive until then. The elements are held one after another:
        /// a scalar at its width, a reference as a pointer, and a struct in place, laid
        /// out as C lays it out where it is marked `@layout("c")`. An empty array still
        /// answers an address, which foreign code must not read through. Throws once the
        /// pinner is disposed.
        ///
        /// - array: the array foreign code is handed the address of
        pin[T](array: ARRAY[T]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[bool]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[char]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[byte]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[ubyte]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[short]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[ushort]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[int]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[uint]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[long]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[ulong]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[word]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[uword]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[single]) -> word is
            _hold(array)
            return elements(array)
        si

        /// The address of `array`'s first element, as for `pin[T]`: an overload for each
        /// scalar type and `word`, kept beside it.
        ///
        /// - array: the array foreign code is handed the address of
        pin(array: ARRAY[double]) -> word is
            _hold(array)
            return elements(array)
        si

        /// `value` copied into memory that stays put until the pinner is disposed, for
        /// a struct foreign code keeps the address of across calls, such as zlib's
        /// `z_stream`. Foreign code reads and writes the copy, not `value`: read it back
        /// through the answer's `value`. Throws once the pinner is disposed.
        ///
        /// - value: what to copy, usually a struct marked `@layout("c")`
        pin_struct[T](value: T) -> PINNED[T] is
            let array = Ghul.Pipes.repeat(value, 1) |> ARRAY()

            return PINNED[T](array, pin(array))
        si

        /// The address of a NUL-terminated UTF-8 copy of `text`, valid until the pinner
        /// is disposed. The copy is the pinner's: foreign code's changes to it aren't
        /// seen by `text`. Throws once the pinner is disposed.
        ///
        /// - text: the text to copy
        pin_utf8(text: string) -> word is
            let bytes = Collections.LIST[ubyte](Text.Encoding.utf8.get_bytes(text))

            bytes.add(0ub)

            return pin(bytes.to_array())
        si

        /// Keeps `value` alive until the pinner is disposed: a function value passed to
        /// foreign code that stores it, or any object foreign code holds the address of.
        /// Throws once the pinner is disposed.
        ///
        /// - value: what to keep alive
        keep(value: object) is
            _hold(value)
        si

        /// Releases every pin. Disposing again does nothing.
        dispose() is
            _held = null
        si

        _hold(value: object) is
            if let held = _held then
                held.add(value)
            else
                throw Ghul.ObjectDisposedException("PINNER", "the pinner has been disposed")
            fi
        si
    si

    /// A value held in place by a `PINNER`, as `PINNER.pin_struct` answers it.
    @IF.llvm()
    class PINNED[T] is
        _array: ARRAY[T]

        /// The address of the value, valid until the pinner that holds it is disposed.
        address: word public

        /// The value as it is now, with any changes foreign code has made to it.
        /// Assigning writes it in place, where foreign code reads it.
        value: T public => _array[0], = v is write[T](address, 0, v); si

        /// A value held as the one element of `array`, which a pinner keeps at
        /// `address`. `PINNER.pin_struct` makes these.
        ///
        /// - array: the one-element array holding the value
        /// - address: the address the pinner gave for `array`
        init(array: ARRAY[T], address: word) is
            _array = array
            self.address = address
        si
    si

    /// A resource foreign code owns, held by its address, and released through the
    /// library's own deallocator exactly once. A binding declares one subclass per kind
    /// of resource, giving `release` the call that frees it; its `@extern` declarations
    /// keep taking and answering `word`, and pass `address`.
    ///
    /// There is no finaliser: release is explicit, through `dispose` or `use`. A facade
    /// that wants a backstop adds a finaliser of its own.
    @IF.llvm()
    class HANDLE: Ghul.Disposable abstract open is
        _address: word

        /// The resource's address. Throws once the handle has been released, so a
        /// released handle can't be passed to foreign code by mistake.
        address: word is
            if _address == 0w then
                throw Ghul.ObjectDisposedException(null, "the handle has been released")
            fi

            return _address
        si

        /// Whether the handle has been released.
        is_released: bool => _address == 0w

        /// A handle to the resource at `address`.
        ///
        /// - address: the resource's address, as foreign code answered it
        init(address: word) is
            _address = address
        si

        /// Frees the resource at `address` with the library's deallocator. Called once,
        /// by `dispose`, with a nonzero address. Every subclass overrides it; the handle
        /// itself frees nothing.
        ///
        /// - address: the resource's address
        release(address: word) is
        si

        /// Releases the resource, if it hasn't been already; disposing again does
        /// nothing.
        dispose() is
            let held = _address

            if held != 0w then
                _address = 0w
                release(held)
            fi
        si
    si
si
