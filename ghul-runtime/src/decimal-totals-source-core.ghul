namespace Ghul.Pipes is
    use Collections

    // Where the core library is compiled from source, `decimal` implements
    // none of the generic-math traits the generic `sum` and `product` are
    // bounded on, so its totals are declared here instead, and
    // a call reads the same on every target.

    /// The total of `source`'s elements, or zero when it's empty.
    @IF.source_core()
    sum(source: Iterable[decimal]) -> decimal pure is
        let total mut = 0m

        for value in source do
            total = total + value
        od

        return total
    si

    /// The product of `source`'s elements, or one when it's empty.
    @IF.source_core()
    product(source: Iterable[decimal]) -> decimal pure is
        let running mut = 1m

        for value in source do
            running = running * value
        od

        return running
    si

si
