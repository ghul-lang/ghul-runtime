namespace Ghul.Pipes is
    use Collections

    // Where the core library is compiled from source, `sum_by` is declared
    // once per result type rather than bounded on `Ghul.Math.Number`, so a
    // selector whose result type only the overload can settle - a literal
    // over a tuple pack, a function group, a conversion - still infers.

    /// The total of what `selector` returns for each of `source`'s elements,
    /// or zero when it's empty.
    @IF.source_core()
    sum_by[T..](source: Iterable[T], selector: T.. -> int pure) -> int pure is
        let total mut = 0

        for value in source do
            total = total + selector(value)
        od

        return total
    si

    /// The total of what `selector` returns for each of `source`'s elements,
    /// or zero when it's empty.
    @IF.source_core()
    sum_by[T..](source: Iterable[T], selector: T.. -> uint pure) -> uint pure is
        let total mut = 0u

        for value in source do
            total = total + selector(value)
        od

        return total
    si

    /// The total of what `selector` returns for each of `source`'s elements,
