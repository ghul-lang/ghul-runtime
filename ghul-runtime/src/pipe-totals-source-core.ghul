namespace Ghul.Pipes is
    use Collections

    // Where the core library is compiled from source, the scalar types
    // cannot satisfy the generic-math bounds `sum`, `product` and `sum_by`
    // take on .NET, since a ghūl type cannot implement an interface's
    // static members. They are declared here once per scalar type instead,
    // so a call reads the same on every target.

    /// The total of `source`'s elements, or zero when it's empty.
    @IF.source_core()
    sum(source: Iterable[int]) -> int pure is
        let total mut = 0

        for value in source do
            total = total + value
        od

        return total
    si

    /// The product of `source`'s elements, or one when it's empty.
    @IF.source_core()
    product(source: Iterable[int]) -> int pure is
        let running mut = 1

        for value in source do
            running = running * value
        od

        return running
    si

    /// The total of what `selector` returns for each of `source`'s elements,
    /// or zero when it's empty.
    @IF.source_core()
    sum_by[T..](source: Iterable[T], selector: T.. -> int pure) -> int pure is
        let total mut = 0

        for value in source do
            total = total + selector(value)
        od

        return total
    si

