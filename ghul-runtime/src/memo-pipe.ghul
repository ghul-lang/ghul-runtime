namespace Ghul.Pipes is
    use Collections

    // What every cursor over one `memo` shares: the source's iterator,
    // until the source is exhausted, and the elements pulled from it so far.
    class MEMO_CACHE[T] is
        iterator: Iterator[T]?
        elements: LIST[T]

        init(source: Iterable[T]) is
            iterator = source.iterator
            elements = LIST[T]()
        si

        // Makes sure the cache holds more than `at` elements, pulling from
        // the source if it doesn't yet; false once the source can't supply it.
        has_element(at: int) -> bool is
            if at < elements.count then
                return true
            fi

            let it = iterator

            while it? /\ it.move_next() do
                elements.add(it.current)

                if at < elements.count then
                    return true
                fi
            od

            it?.dispose()
            iterator = null

            return false
        si
    si

    // A pipe that pulls its upstream once and replays what it pulled on
    // every later read. Each read is a cursor of its own over a cache the
    // cursors share: a read runs through the cached prefix and only asks
    // the source again once it runs past it. The source's iterator is
    // dropped once the source is exhausted, since nothing will ask it
    // for more.
    /// A pipe that pulls its upstream once and replays the cached elements
    /// on every later read. It is also a list: reading by position pulls
    /// the source only as far as the position read.
    class MEMO_PIPE[T]: PipeStage[T], List[T] is
        _cache: MEMO_CACHE[T]
        _at: int

        init(cache: MEMO_CACHE[T]) is
            super.init()

            _cache = cache
        si

        /// A new read of the same cache, from its start.
        fresh() -> PipeStage[T] => MEMO_PIPE[T](_cache)

        /// The element at `index`, counting from zero, pulling the source
        /// until it is cached; throws when the source ends before `index`.
        [index: int]: T pure is
            if index < 0 \/ !_cache.has_element(index) then
                throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
            fi

            return _cache.elements[index]
        si

        /// The number of elements in the whole sequence, pulling the rest
        /// of the source to count them. Never returns over an unbounded
        /// source.
        count: int pure is
            while _cache.has_element(_cache.elements.count) do
            od

            return _cache.elements.count
        si

        /// The element at `index`, or absent when the source ends before
        /// `index` or `index` is negative, pulling the source only as far
        /// as `index`.
        try_get(index: int) -> MAYBE[T] =>
            if index >= 0 /\ _cache.has_element(index) then
                MAYBE(_cache.elements[index])
            else
                MAYBE[T]()
            fi

        /// The most recently produced element.
        current: T => _cache.elements[_at - 1]

        /// Advances within the cache while there's more of it, otherwise
        /// pulls and caches the next source element.
        move_next() -> bool is
            if _cache.has_element(_at) then
                _at = _at + 1

                return true
            fi

            return false
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Has no effect: the source's iterator is shared by every read of
        /// this memo, and is released when the source runs out.
        dispose() is
        si
    si
si
