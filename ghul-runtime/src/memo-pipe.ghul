namespace Ghul.Pipes is
    use ARRAY = Ghul.Intrinsics.Staging.ARRAY
    use Collections

    /// What every cursor over one `memo` sequence shares: the source's
    /// iterator, until the source is exhausted, and the elements pulled from
    /// it so far. Created by `memo`; not meant to be used directly.
    class MEMO_CACHE[T] is
        iterator: Iterator[T]?
        elements: LIST[T]

        init(source: Iterable[T]) is
            iterator = source.iterator
            elements = LIST[T]()
        si

        // Makes sure the cache holds more than `at` elements, pulling from
        // the source if it doesn't yet; false once the source can't supply it.
        has_element(at: int) -> bool is
            if at < elements.count then
                return true
            fi

            let it = iterator

            while it? /\ it.move_next() do
                elements.add(it.current)

                if at < elements.count then
                    return true
                fi
            od

            it?.dispose()
            iterator = null

            return false
        si

        // Discards the source and every cached element, so the sequence
        // is empty and no element will ever be pulled again.
        clear() is
            iterator?.dispose()
            iterator = null
            elements.clear()
        si
    si

    // A pipe that pulls its upstream once and replays what it pulled on
    // every later read. Each read is a cursor of its own over a cache the
    // cursors share: a read runs through the cached prefix and only asks
    // the source again once it runs past it. The source's iterator is
    // dropped once the source is exhausted, since nothing will ask it
    // for more.
    /// A pipe that pulls its upstream once and replays the cached elements
    /// on every later read. It is also a list: reading by position pulls
    /// the source only as far as the position read.
    ///
    /// It is also a mutable list: assigning, inserting and removing by
    /// position pull the source only as far as the position touched,
    /// and unpulled elements follow whatever has been cached. Adding
    /// appends at the end, so it pulls the rest of the source first,
    /// and `count` does the same; neither returns over an unbounded
    /// source. Clearing discards the source and the cache.
    class MEMO_PIPE[T]: PipeStage[T], List[T], MutableList[T] is
        _cache: MEMO_CACHE[T]
        _at: int

        init(cache: MEMO_CACHE[T]) is
            super.init()

            _cache = cache
        si

        /// A new read of the same cache, from its start.
        fresh() -> PipeStage[T] => MEMO_PIPE[T](_cache)

        /// The element at `index`, counting from zero, pulling the source
        /// until it is cached; throws when the source ends before `index`.
        /// Assigning replaces the cached element at `index`, pulling the
        /// source only as far as `index`; it throws on the same terms.
        [index: int]: T pure =>
            if index < 0 \/ !_cache.has_element(index) then
                throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
            else
                _cache.elements[index]
            fi,
            = value is
                if index < 0 \/ !_cache.has_element(index) then
                    throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
                fi

                _cache.elements[index] = value
            si

        /// The number of elements in the whole sequence, pulling the rest
        /// of the source to count them. Never returns over an unbounded
        /// source.
        count: int pure is
            while _cache.has_element(_cache.elements.count) do
            od

            return _cache.elements.count
        si

        /// Adds `value` at the end. The end is not known until the
        /// source is exhausted, so this pulls the rest of the source
        /// first; it never returns over an unbounded source.
        add(value: T) is
            while _cache.has_element(_cache.elements.count) do
            od

            _cache.elements.add(value)
        si

        /// Removes every element, discarding the source as well.
        clear() is
            _cache.clear()
        si

        /// Inserts `value` at `index`, moving the elements from there
        /// on up by one, pulling the source only as far as `index`;
        /// elements not yet pulled follow the cached ones. Throws when
        /// the source ends before `index`.
        insert(index: int, value: T) is
            if index < 0 then
                throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
            fi

            while _cache.elements.count < index /\ _cache.has_element(_cache.elements.count) do
            od

            if _cache.elements.count < index then
                throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
            fi

            _cache.elements.insert(index, value)
        si

        /// Removes the element at `index`, moving the elements after
        /// it down by one, pulling the source only as far as `index`;
        /// elements not yet pulled follow the cached ones. Throws when
        /// the source ends before `index`.
        remove_at(index: int) is
            if index < 0 \/ !_cache.has_element(index) then
                throw Ghul.ArgumentOutOfRangeException("index", "{index} is not within the memoised sequence")
            fi

            _cache.elements.remove_at(index)
        si

        /// The position of the first element `=~` to `item`, or -1 where
        /// none is, pulling the source only as far as needed to find
        /// one; a miss exhausts it.
        index_of(item: T) -> int pure is
            let index mut = 0

            while _cache.has_element(index) do
                if _cache.elements[index] =~ item then
                    return index
                fi

                index = index + 1
            od

            return -1
        si

        /// Whether any element is `=~` to `value`, pulling the source
        /// only as far as needed to find one; a miss exhausts it.
        contains(value: T) -> bool => index_of(value) >= 0

        /// Removes the first element `=~` to `value`, answering whether
        /// there was one, pulling the source only as far as needed to
        /// find it; a miss exhausts the source.
        remove(value: T) -> bool is
            let index mut = 0

            while _cache.has_element(index) do
                if _cache.elements[index] =~ value then
                    _cache.elements.remove_at(index)

                    return true
                fi

                index = index + 1
            od

            return false
        si

        /// Whether the list is read-only. It never is.
        is_read_only: bool pure => false

        /// Copies every element into `array`, starting at `array_index`,
        /// pulling the rest of the source first. Never returns over an
        /// unbounded source.
        copy_to(array: ARRAY[T], array_index: int) is
            while _cache.has_element(_cache.elements.count) do
            od

            _cache.elements.copy_to(array, array_index)
        si

        /// The element at `index`, or absent when the source ends before
        /// `index` or `index` is negative, pulling the source only as far
        /// as `index`.
        try_get(index: int) -> MAYBE[T] =>
            if index >= 0 /\ _cache.has_element(index) then
                MAYBE(_cache.elements[index])
            else
                MAYBE[T]()
            fi

        /// The most recently produced element.
        current: T => _cache.elements[_at - 1]

        /// Advances within the cache while there's more of it, otherwise
        /// pulls and caches the next source element.
        move_next() -> bool is
            if _cache.has_element(_at) then
                _at = _at + 1

                return true
            fi

            return false
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Has no effect: the source's iterator is shared by every read of
        /// this memo, and is released when the source runs out.
        dispose() is
        si
    si
si
