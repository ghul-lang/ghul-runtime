namespace Ghul.Pipes is
    use Collections

    /// Drives a state-stepping `advance` function through the `Pipe[T]` surface.
    class STREAM_PIPE[T, S]: PipeStage[T] is
        _initial: S
        _state:   S
        _advance: S -> (T, S)?

        /// The most recently yielded element.
        current: T

        init(initial: S, advance: S -> (T, S)?) is
            super.init()

            assert advance?

            _initial = initial
            _state   = initial
            _advance = advance
        si

        /// A new sequence from the initial state, not yet read.
        fresh() -> PipeStage[T] => STREAM_PIPE[T, S](_initial, _advance)

        /// Calls `advance` with the current state: where it returns an
        /// element and the next state, takes them and returns true; where it
        /// returns null, returns false.
        move_next() -> bool is
            if let (value, state) = _advance(_state) then
                current = value
                _state  = state
                return true
            fi

            return false
        si

        /// Renders the pipe's elements, in order, as text.
        @IF.dotnet()
        to_string() -> string => $(self)

        /// Renders the pipe's elements, in order, as text.
        @IF.source_core()
        to_string() -> string => Ghul.DISPLAY_STATE.elements_text(self)

        /// Has no effect.
        dispose() is
        si
    si

    /// A sequence made by stepping a state: each read calls `advance` with
    /// the current state, which returns the next element together with the
    /// state to step from next, or null to end the sequence. Where the state
    /// is a tuple, `advance` can take its parts as separate parameters.
    ///
    /// ```ghul
    /// let fibonacci = stream((0, 1), (a, b) => (a, (b, a + b)))
    /// let countdown = stream(3, n => if n == 0 then null else (n, n - 1) fi)
    /// ```
    ///
    /// - initial: the state the first read steps from
    /// - advance: the step: the next element and state, or null at the end. It
    ///   must be pure, as `iterate`'s step must: the sequence calls it again each
    ///   time it is read.
    stream[T, S..](initial: S, advance: S.. -> (T, S)? pure) -> Iterable[T] pure is
        return STREAM_PIPE[T, S](initial, advance)
    si
si
