namespace Ghul.Functional is
    use Collections

    // Function combinators: composition in both reading orders, arity
    // reshaping for the two-argument case, a call cache, and an
    // attempt-limited decorator. They live apart from Ghul.Pipes because
    // none of them is about sequences. From compiler 67.4.0, `use
    // default` imports this namespace.

    // Left-to-right composition: `f >> g` applies f, then g - the
    // reading that matches the thread-first operator's direction. The
    // composed function keeps f's own arity: one argument is threaded
    // as it is, several are gathered into the tuple the pack binds to.
    /// Composes `f` and `g`: applies `f` first, then passes its result to `g`.
    >>[T.., B, C](f: T.. -> B, g: (B) -> C) -> T.. -> C => v => g(f(v))

    // Right-to-left composition, the mathematical reading: `f << g`
    // applies g, then f, keeping the second stage's arity.
    /// Composes `f` and `g`: applies `g` first, then passes its result to `f`.
    <<[T.., B, C](f: (B) -> C, g: T.. -> B) -> T.. -> C => v => f(g(v))

    // Reshape a two-argument function into unary functions returning
    // functions, so one argument can be supplied and the rest passed
    // later: `curry(add)(3)` is the function that adds 3.
    /// `f` reshaped to take its two arguments one at a time: `curry(f)(a)(b)` is `f(a, b)`.
    curry[A, B, C](f: (A, B) -> C) -> (A) -> (B) -> C =>
        a => b => f(a, b)

    // The inverse reshape: a function built by currying, or by any
    // step-by-step construction of the same shape, as a plain
    // two-argument function.
    /// The inverse of `curry`: `f` reshaped to take both arguments at once.
    uncurry[A, B, C](f: (A) -> (B) -> C) -> (A, B) -> C =>
        (a, b) => f(a)(b)

    // Call a function with the arguments of the call itself, of any
    // arity: `apply(f, x, y)` is `f(x, y)`. The argument pack gathers
    // the arguments, so both the spread spelling and the written-out
    // tuple reach the same formal.
    /// Calls `f` with `v`, spreading `v`'s elements as separate arguments
    /// when `f` takes more than one.
    apply[T.., U](f: T.. -> U, v: T..) -> U => f(v)

    // A function that answers from a map of the results it has already
    // computed, so repeated calls with the same arguments compute once.
    // The cache is an ordinary MAP, keyed on the tuple the argument
    // pack binds to: single-threaded use.
    /// `f`, wrapped to remember each call's result and skip calling `f` again for
    /// arguments already seen. Not safe to call from more than one thread at a time.
    memo[T.., U](f: T.. -> U) -> T.. -> U is
        let cache mut = MAP[T, U]()

        return v => (
            if cache.contains_key(v) then cache[v]
            else
                let r = f(v)
                cache.add(v, r)
                r
            fi
        )
    si

    // memo_rec hands `f` the memoised function itself as its first
    // argument, so a recursive call made through it is answered from the
    // cache too: a function that calls itself directly would bypass any
    // wrapper. One overload per arity, rather than an argument pack, so
    // the parameter types of a literal passed in decide A, B and so on,
    // and the function `f` receives takes its arguments spread out.

    /// `f` with its results remembered: each argument is computed once, and
    /// later calls with it are answered from a cache. `f` takes the memoised
    /// function as its first argument and makes its recursive calls through
    /// it, so every level is cached:
    /// `memo_rec((fib, n: int) => if n < 2 then bigint(n) else fib(n - 1) + fib(n - 2) fi)`.
    /// The cache is not safe to use from more than one thread at a time.
    memo_rec[A, U](f: ((A) -> U, A) -> U) -> (A) -> U is
        let cache = MAP[A, U]()

        return a rec => (
            if cache.contains_key(a) then cache[a]
            else
                let result = f(rec, a)
                cache[a] = result
                result
            fi
        )
    si

    /// `f` with its results remembered, keyed on both arguments together.
    /// See the one-argument `memo_rec`.
    memo_rec[A, B, U](f: ((A, B) -> U, A, B) -> U) -> (A, B) -> U is
        let cache = MAP[(A, B), U]()

        return (a, b) rec => (
            let key = (a, b)

            if cache.contains_key(key) then cache[key]
            else
                let result = f(rec, a, b)
                cache[key] = result
                result
            fi
        )
    si

    /// `f` with its results remembered, keyed on all three arguments together.
    /// See the one-argument `memo_rec`.
    memo_rec[A, B, C, U](f: ((A, B, C) -> U, A, B, C) -> U) -> (A, B, C) -> U is
        let cache = MAP[(A, B, C), U]()

        return (a, b, c) rec => (
            let key = (a, b, c)

            if cache.contains_key(key) then cache[key]
            else
                let result = f(rec, a, b, c)
                cache[key] = result
                result
            fi
        )
    si

    /// `f` with its results remembered, keyed on all four arguments together.
    /// See the one-argument `memo_rec`.
    memo_rec[A, B, C, D, U](f: ((A, B, C, D) -> U, A, B, C, D) -> U) -> (A, B, C, D) -> U is
        let cache = MAP[(A, B, C, D), U]()

        return (a, b, c, d) rec => (
            let key = (a, b, c, d)

            if cache.contains_key(key) then cache[key]
            else
                let result = f(rec, a, b, c, d)
                cache[key] = result
                result
            fi
        )
    si

    // A function that calls f, retrying the whole call up to `attempts`
    // times when it throws, and throwing the last failure when every
    // attempt does. The returned function keeps f's own arity.
    /// `f`, wrapped to call it again on failure until `attempts` calls have been made,
    /// throwing the last failure if every one of them throws.
    retry[T.., U](f: T.. -> U, attempts: int) -> T.. -> U is
        return v => (
            let n mut = attempts

            while true do
                try
                    return f(v)
                catch e: Ghul.Exception
                    n = n - 1

                    if n <= 0 then
                        throw e
                    fi
                yrt
            od

            throw Ghul.Exception("unreachable")
        )
    si
si
