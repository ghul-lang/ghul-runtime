namespace IO is
    use Collections.Iterable

    /// What running a program with `Process.run` gave: its exit status and
    /// everything it wrote to standard output and standard error.
    class ProcessResult(exit_code: int, output: string, error: string) is
        /// The program's exit status. A program killed by a signal has 128
        /// plus the signal's number, as .NET reports it.
        exit_code: int

        /// Everything the program wrote to standard output.
        output: string

        /// Everything the program wrote to standard error.
        error: string
    si

    /// Runs other programs, waiting for each to finish.
    class Process is
        /// Runs `file_name` with `arguments` to completion and waits for it,
        /// as `Process.run` does. Throws `IO.FileNotFoundException` where
        /// the program cannot be found or is not allowed to run, and
        /// `Ghul.InvalidOperationException` where it cannot be started for
        /// any other reason.
        ///
        /// - file_name: the program to run; a name with no directory is
        ///   looked for on the `PATH`
        /// - arguments: the arguments to pass, each as one argument
        run(file_name: string, arguments: Iterable[string]) -> ProcessResult static is
            let output = Ghul.Internal.PROCESS_HOST.run_and_wait(file_name, arguments)

            return ProcessResult(output.exit_code, output.output, output.error)
        si
    si
si

namespace Process is
    use Collections.Iterable
    use Collections.LIST
    use Concurrency.Future

    /// What a program run with `run` did: its exit status and everything it
    /// wrote to standard output and standard error. A program that ran and
    /// failed is still an `Output`; its failure is its `exit_code`.
    class Output(exit_code: int, output: string, error: string) is
        /// The program's exit status. A program killed by a signal has 128
        /// plus the signal's number, as .NET reports it.
        exit_code: int

        /// Everything the program wrote to standard output.
        output: string

        /// Everything the program wrote to standard error.
        error: string
    si

    /// Why `run` could not start a program.
    union Error: Ghul.Error is
        /// There is no program by that name, or none on the `PATH`.
        NOT_FOUND(program: string)

        /// The program exists but is not allowed to run.
        PERMISSION_DENIED(program: string)

        /// The program could not be started for another reason, described.
        OTHER(description: string)
    si

    /// Runs `file_name` with `arguments`, sharing this process's standard
    /// input and capturing its standard output and standard error. The
    /// future completes when the program has finished, with its `Output`
    /// whatever its exit status, or with an `Error` where it could not be
    /// started. On .NET and the llvm target the program runs while the
    /// caller's other tasks go on; on the wasm target the program has
    /// finished by the time `run` returns, and a wasm program run anywhere
    /// but Node cannot start a program, and is told so.
    ///
    /// - file_name: the program to run; a name with no directory is
    ///   looked for on the `PATH`
    /// - arguments: the arguments to pass, each as one argument
    @IF.dotnet()
    run(file_name: string, arguments: Iterable[string]) -> Future[Ghul.Result[Output, Error]] is
        let start_info = System.Diagnostics.ProcessStartInfo(file_name)

        for argument in arguments do
            start_info.argument_list.add(argument)
        od

        start_info.use_shell_execute = false
        start_info.redirect_standard_output = true
        start_info.redirect_standard_error = true

        let process: System.Diagnostics.Process? mut = null
        let failure: Error? mut = null

        try
            process = System.Diagnostics.Process.start(start_info)
        catch e: System.ComponentModel.Win32Exception
            failure = Ghul.Internal.PROCESS_HOST.start_failure(file_name, e.native_error_code, e.message)
        yrt

        if let started = process then
            // Both pipes are read together, so a program that fills one
            // while nothing reads the other cannot stop.
            let error = started.standard_error.read_to_end_async()
            let output = started.standard_output.read_to_end_async()

            await started.wait_for_exit_async(System.Threading.CancellationToken.none)

            return Ghul.Result.OK[Output, Error](Output(started.exit_code, await output, await error))
        fi

        return Ghul.Result.ERROR[Output, Error](failure ?? Error.OTHER("Could not start {file_name}"))
    si

    /// Runs `file_name` with `arguments`, sharing this process's standard
    /// input and capturing its standard output and standard error. The
    /// future completes when the program has finished, with its `Output`
    /// whatever its exit status, or with an `Error` where it could not be
    /// started. On .NET and the llvm target the program runs while the
    /// caller's other tasks go on; on the wasm target the program has
    /// finished by the time `run` returns, and a wasm program run anywhere
    /// but Node cannot start a program, and is told so.
    ///
    /// - file_name: the program to run; a name with no directory is
    ///   looked for on the `PATH`
    /// - arguments: the arguments to pass, each as one argument
    @IF.llvm()
    run(file_name: string, arguments: Iterable[string]) -> Future[Ghul.Result[Output, Error]] is
        let copied = arguments |> LIST()

        return await Concurrency.start(() => Ghul.Internal.PROCESS_HOST.run_here(file_name, copied))
    si

    /// Runs `file_name` with `arguments`, sharing this process's standard
    /// input and capturing its standard output and standard error. The
    /// future completes when the program has finished, with its `Output`
    /// whatever its exit status, or with an `Error` where it could not be
    /// started. On .NET and the llvm target the program runs while the
    /// caller's other tasks go on; on the wasm target the program has
    /// finished by the time `run` returns, and a wasm program run anywhere
    /// but Node cannot start a program, and is told so.
    ///
    /// - file_name: the program to run; a name with no directory is
    ///   looked for on the `PATH`
    /// - arguments: the arguments to pass, each as one argument
    @IF.wasm()
    run(file_name: string, arguments: Iterable[string]) -> Future[Ghul.Result[Output, Error]] =>
        Future.from_result(Ghul.Internal.PROCESS_HOST.run_here(file_name, arguments))
si

namespace Ghul.Internal is
    use Collections.Iterable
    use Concurrency.Future

    use Output = Process.Output
    use Error = Process.Error

    // What Process.run needs from the host, and a way to reach Process.run
    // from inside namespace IO, where `Process` names the IO.Process class.
    class PROCESS_HOST is
        // Runs the program and waits for it, throwing where it could not start.
        run_and_wait(file_name: string, arguments: Iterable[string]) -> Output static is
            let result = Concurrency.run(Process.run(file_name, arguments))

            if let failed: Ghul.Result.ERROR = result then
                let error = failed.error

                if isa Error.OTHER(error) then
                    throw Ghul.InvalidOperationException("Could not run {file_name}: {error.message}")
                fi

                throw IO.FileNotFoundException("Could not run {file_name}: {error.message}")
            fi

            return result!
        si

        // The failure .NET reports for a program it could not start, by its
        // system error number: ENOENT or ERROR_FILE_NOT_FOUND, then EACCES
        // or ERROR_ACCESS_DENIED.
        @IF.dotnet()
        start_failure(file_name: string, code: int, description: string) -> Error static =>
            if code == 2 then
                Error.NOT_FOUND(file_name)
            elif code == 13 \/ code == 5 then
                Error.PERMISSION_DENIED(file_name)
            else
                Error.OTHER(description)
            fi

        // Runs the program on the calling thread, which waits for it.
        @IF.source_core()
        run_here(file_name: string, arguments: Iterable[string]) -> Ghul.Result[Output, Error] static is
            begin(file_name)

            for argument in arguments do
                add_argument(argument)
            od

            let exit_code = run()

            if exit_code == -1 then
                let reason = failure()

                if reason == 1 then
                    return Ghul.Result.ERROR[Output, Error](Error.NOT_FOUND(file_name))
                elif reason == 3 then
                    return Ghul.Result.ERROR[Output, Error](Error.PERMISSION_DENIED(file_name))
                fi

                return Ghul.Result.ERROR[Output, Error](Error.OTHER("Could not start {file_name}"))
            fi

            return Ghul.Result.OK[Output, Error](Output(exit_code, output() ?? "", error() ?? ""))
        si

        // Starts the command `begin` and `add_argument` built, waits for it,
        // and answers its exit status, or -1 where it could not start, with
        // `failure` saying why: 1 for no such program, 3 for not allowed to
        // run it, 2 for anything else.
        @IF.source_core()
        @intrinsic("host.process_begin")
        begin(file_name: string) static

        @IF.source_core()
        @intrinsic("host.process_add_argument")
        add_argument(argument: string) static

        @IF.source_core()
        @intrinsic("host.process_run")
        run() -> int static

        @IF.source_core()
        @intrinsic("host.process_failure")
        failure() -> int static

        @IF.source_core()
        @intrinsic("host.process_output")
        output() -> string? static

        @IF.source_core()
        @intrinsic("host.process_error")
        error() -> string? static
    si
si
