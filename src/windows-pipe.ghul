namespace Ghul.Pipes is
    use Collections

    /// Overlapping lists of `size` consecutive elements of `source`,
    /// sliding one element at a time.
    class WINDOWS_PIPE[T]: Pipe[LIST[T]] is
        /// This pipe, as its own iterator.
        iterator: Iterator[LIST[T]] => self

        /// The most recently produced window.
        current: LIST[T]

        _source: Iterable[T]
        _iterator: Iterator[T]
        _pending: PENDING_CURSOR[T]?

        _size: int

        _buffer: LIST[T]

        /// Throws if `size` isn't positive.
        init(source: Iterable[T], size: int) is
            assert size > 0 else "window size must be positive"

            _source = source
            _iterator = source.iterator
            _size = size
            _buffer = LIST[T]()
        si

        /// Fills the buffer to `size` elements and drops the oldest one
        /// after producing the window; rewinds once the source can't fill it.
        move_next() -> bool is
            while _buffer.count < _size /\ _iterator.move_next() do
                _buffer.add(_iterator.current)
            od

            if _buffer.count < _size then
                reset()

                return false
            fi

            current = LIST[T](_buffer)

            _buffer.remove_at(0)

            return true
        si

        /// Rewinds the source and clears the buffer.
        reset() is
            _iterator = rewind(_iterator, pending())
            _buffer = LIST[T]()
        si

        /// The placeholder cursor installed after a rewind, created once and reused.
        pending() -> PENDING_CURSOR[T] is
            if let p = _pending then
                return p
            fi

            let p = PENDING_CURSOR[T](_source, (it: Iterator[T]) is _iterator = it si)

            _pending = p

            return p
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Disposes the underlying iterator.
        dispose() => _iterator.dispose()
    si
si
