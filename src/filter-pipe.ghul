namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements that `predicate` accepts, in order.
    class FilterPipe[T]: FilterPipeBase[T] is
        _predicate: T -> bool

        init(source: Iterable[T], predicate: T -> bool) is
            super.init(source)

            _predicate = predicate
        si

        /// Accepts an element when `predicate` does.
        should_include() -> bool => _predicate(current)
    si
si
