namespace Json is
    use Collections.LIST
    use Collections.MAP
    use Collections.SET
    use Collections.KEY_VALUE_PAIR
    use System.Reflection.BindingFlags
    use System.Reflection.ConstructorInfo
    use System.Reflection.FieldInfo
    use System.Reflection.PropertyInfo

    // The field a union variant's name is written under.
    _KIND: string static => "kind"

    // The members of one level of a type that JSON reads and writes: its
    // own public instance properties and fields.
    _LEVEL: BindingFlags static =>
        BindingFlags.PUBLIC | BindingFlags.INSTANCE | BindingFlags.DECLARED_ONLY

    /// The JSON value for `value`: a scalar read directly, a sequence as
    /// an array of its elements, and any other object as its public
    /// properties and fields, its own and its base types', each under its
    /// own name. A union variant leads with a `kind` field holding the
    /// variant's name in lower case. A member whose
    /// name starts with `$`, which the compiler synthesises, is left out.
    /// `null` and an absent optional both give `Value.NULL`.
    ///
    /// - value: the value to convert, read through its own runtime type
    to_json(value: object?) -> Value static is
        if !value? then
            return Value.NULL
        fi

        if let b: bool = value then
            return Value.BOOLEAN(b)
        fi

        if let s: string = value then
            return Value.STRING(s)
        fi

        if let n: double = value then
            return Value.NUMBER(n)
        fi

        if let n: int = value then
            return Value.NUMBER(double(n))
        fi

        if let n: long = value then
            return Value.NUMBER(double(n))
        fi

        if let sequence: Collections.NonGenericIterable = value then
            let items = LIST[Value]()

            for element in System.Linq.Enumerable.cast[object](sequence) do
                items.add(to_json(element))
            od

            return Value.ARRAY(items)
        fi

        let type = value.get_type()
        let fields = LIST[KEY_VALUE_PAIR[string, Value]]()

        if type.is_defined(typeof Ghul.Internal.VARIANT_ATTRIBUTE, false) then
            fields.add(KEY_VALUE_PAIR[string, Value](_KIND, Value.STRING(type.name.to_lower())))
        fi

        for member in _members(type) do
            fields.add(KEY_VALUE_PAIR[string, Value](member.name, to_json(member.read(value))))
        od

        return Value.OBJECT(fields)
    si

    // A member JSON reads and writes: its name, its declared type, how to
    // read it, and how to write it where it can be written.
    class _MEMBER(name: string public, type: System.Type public, read: (object) -> object? public, write: ((object, object?) -> void)? public)

    // `type`'s public instance properties and then fields, level by level
    // from `type` itself to its root, each name once, leaving out those
    // the compiler synthesises.
    _members(type: System.Type) -> LIST[_MEMBER] static is
        let result = LIST[_MEMBER]()
        let seen = SET[string]()
        let level: System.Type? mut = type

        while let current = level do
            for property in current.get_properties(_LEVEL) do
                if property.get_get_method()? /\ property.get_index_parameters().count == 0 /\ !property.name.starts_with('$') /\ seen.add(property.name) then
                    let writable = property.get_set_method()?

                    result.add(
                        _MEMBER(
                            property.name,
                            property.property_type,
                            instance => _read(property, instance),
                            if writable then (instance, value) -> void => property.set_value(instance, value) else null fi))
                fi
            od

            for `field in current.get_fields(_LEVEL) do
                if !`field.name.starts_with('$') /\ seen.add(`field.name) then
                    result.add(
                        _MEMBER(
                            `field.name,
                            `field.field_type,
                            instance => `field.get_value(instance),
                            if `field.is_init_only then null else (instance, value) -> void => `field.set_value(instance, value) fi))
                fi
            od

            level = current.base_type
        od

        return result
    si

    // `property`'s value on `value`: the value itself for an ordinary
    // property, and `MAYBE[T]`'s own value, or null where it holds none,
    // for one whose declared type is that carrier - boxing a `Nullable[T]`
    // already gives the same answer with no help needed here.
    _read(property: PropertyInfo, value: object) -> object? static is
        if Ghul.MAYBE[object].underlying_type(property.property_type)? then
            let maybe = property.get_value(value)!
            let maybe_type = maybe.get_type()
            let has_value = cast bool(maybe_type.get_property("has_value")!.get_value(maybe))

            return if has_value then maybe_type.get_property("value")!.get_value(maybe) else null fi
        fi

        return property.get_value(value)
    si

    /// The value `type` describes, read from `json`. A scalar is read
    /// directly, and an array is read into an array, or into a sequence
    /// type: a class one through its parameterless constructor, and a trait
    /// one as an array. A union is built from its `kind` field, matched
    /// against the variant names
    /// `Ghul.Internal.UNION_ATTRIBUTE` lists for the union - a union
    /// compiled without that list cannot be read this way. Any other type
    /// is built through its parameterless constructor, or else its only
    /// one, each parameter read from the field of the same name in any
    /// case; the remaining fields are then written to the public properties
    /// and fields of the same name. A field `json` carries that the type
    /// has no member for is ignored. `Value.NULL` gives `null`.
    ///
    /// - json: the JSON value to read
    /// - type: the type to build
    from_json(json: Value, type: System.Type) -> object? static is
        if isa Value.NULL(json) then
            return null
        fi

        let maybe_underlying = Ghul.MAYBE[object].underlying_type(type)

        if let underlying = maybe_underlying then
            return System.Activator.create_instance(type, [from_json(json, underlying)])
        fi

        let target = System.Nullable.get_underlying_type(type) ?? type

        if target =~ typeof bool then
            return as_bool(json)!
        fi

        if target =~ typeof string then
            return as_string(json)!
        fi

        if target =~ typeof double then
            return as_number(json)!
        fi

        if target =~ typeof int then
            return int(as_number(json)!)
        fi

        if target =~ typeof long then
            return long(as_number(json)!)
        fi

        if target.is_defined(typeof Ghul.Internal.UNION_ATTRIBUTE, false) then
            return _build_variant(json, target)
        fi

        if let items = as_array(json) then
            return _build_sequence(items, target)
        fi

        return _build_object(json, target, null)
    si

    // An instance of `type` holding `items`: an array of the element type
    // for an array or a sequence trait, and otherwise `type` itself made
    // through its parameterless constructor, each item added to it.
    _build_sequence(items: LIST[Value], type: System.Type) -> object static is
        let element_type = _element_type(type)

        if type.is_array \/ type.is_interface then
            let result = System.Array.create_instance(element_type, items.count)

            for i in 0..items.count do
                result.set_value(from_json(items[i], element_type), i)
            od

            return result
        fi

        let result = System.Activator.create_instance(type)!

        if let list: DotNet.NonGeneric.Collections.IList = result then
            for item in items do
                list.add(from_json(item, element_type))
            od

            return result
        fi

        throw Ghul.Exception("{type.name} cannot be built from a JSON array")
    si

    // What a sequence of `type` holds: an array's element type, or the one
    // type argument of a generic sequence, and `object` otherwise.
    _element_type(type: System.Type) -> System.Type is
        if type.is_array then
            return type.get_element_type()!
        fi

        let arguments = type.get_generic_arguments()

        if arguments.count == 1 then
            return arguments[0]
        fi

        return typeof object
    si

    // `union_type`'s own `UNION_ATTRIBUTE`, read off its custom attributes.
    _union_attribute(union_type: System.Type) -> Ghul.Internal.UNION_ATTRIBUTE static is
        for attribute in union_type.get_custom_attributes(typeof Ghul.Internal.UNION_ATTRIBUTE, false) do
            if let found: Ghul.Internal.UNION_ATTRIBUTE = attribute then
                return found
            fi
        od

        throw Ghul.Exception("{union_type.name} is not a union")
    si

    // The variant of `union_type` that `json`'s discriminator field names,
    // built from `json`'s other fields.
    _build_variant(json: Value, union_type: System.Type) -> object static is
        let attribute = _union_attribute(union_type)

        if attribute.variants.count == 0 then
            throw Ghul.Exception("{union_type.name} was compiled without a variant list and cannot be read this way")
        fi

        let kind = get(json, _KIND)

        if !kind? then
            throw Ghul.Exception("{union_type.name} is missing its \"kind\" field")
        fi

        let discriminator = as_string(kind)

        if !discriminator? then
            throw Ghul.Exception("{union_type.name}'s \"kind\" field is not a string")
        fi

        for variant in attribute.variants do
            if variant.name.to_lower() =~ discriminator then
                return _build_object(json, variant, _KIND)
            fi
        od

        throw Ghul.Exception("{union_type.name} has no variant named \"{discriminator}\"")
    si

    // An instance of `type` built from `json`'s fields: through its
    // parameterless constructor, or else its only constructor with each
    // parameter read from the field of the same name in any case, and then
    // each remaining field written to the member of the same name.
    // `discriminator` names a field that is not a member.
    _build_object(json: Value, type: System.Type, discriminator: string?) -> object static is
        let fields = as_object(json)

        if !fields? then
            throw Ghul.Exception("{type.name} cannot be built from a JSON value that is not an object")
        fi

        let constructors = type.get_constructors(BindingFlags.PUBLIC | BindingFlags.INSTANCE)
        let chosen: ConstructorInfo? mut = null

        for constructor in constructors do
            if !chosen? /\ constructor.get_parameters().count == 0 then
                chosen = constructor
            fi
        od

        if !chosen? then
            if constructors.count != 1 then
                throw Ghul.Exception("{type.name} has no constructor to build it with")
            fi

            chosen = constructors[0]
        fi

        let consumed = SET[string]()
        let arguments = LIST[object?]()

        for parameter in chosen.get_parameters() do
            let found: Value? mut = null

            for pair in fields do
                if !found? /\ string.equals(pair.key, parameter.name, Ghul.StringComparison.ORDINAL_IGNORE_CASE) then
                    found = pair.value
                    consumed.add(pair.key)
                fi
            od

            arguments.add(from_json(found ?? Value.NULL, parameter.parameter_type))
        od

        let result = System.Activator.create_instance(type, arguments.to_array())!

        let members = _members(type)

        for pair in fields do
            if consumed.contains(pair.key) \/ pair.key =~ (discriminator ?? "") then
                continue
            fi

            for member in members do
                if member.name =~ pair.key then
                    if let write = member.write then
                        write(result, from_json(pair.value, member.type))
                    fi
                fi
            od
        od

        return result
    si
si
