namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements up to, but not including, the first one
    /// `predicate` rejects.
    class TAKE_WHILE_PIPE[T]: FilterPipeBase[T] is
        _predicate: (T) -> bool
        _done: bool

        init(source: Iterable[T], predicate: (T) -> bool) is
            super.init(source)
            _predicate = predicate
            _done = false
        si

        /// Stops the pass at the first element `predicate` rejects.
        should_continue() -> bool is
            if _done then
                return false
            fi

            if !_predicate(current) then
                _done = true

                return false
            fi

            return true
        si

        /// Always accepts.
        should_include() -> bool => true

        /// Rewinds the source and resumes taking while `predicate` accepts.
        reset() is
            super.reset()
            _done = false
        si
    si
si
