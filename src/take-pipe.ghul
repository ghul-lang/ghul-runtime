namespace Ghul.Pipes is
    use Collections

    /// The first `take_count` elements of `source`.
    class TAKE_PIPE[T]: FilterPipeBase[T] is
        _initial_take_count: int
        _take_count: int

        init(source: Iterable[T], take_count: int) is
            super.init(source)
            _initial_take_count = take_count
            _take_count = take_count
        si

        /// Whether the quota of `take_count` elements has yet to be reached.
        should_pull() -> bool => _take_count > 0

        /// Counts down the remaining quota.
        have_moved() is
            _take_count = _take_count - 1
        si

        /// Always accepts.
        should_include() -> bool => true

        /// Rewinds the source and restores the quota to `take_count`.
        reset() is
            super.reset()
            _take_count = _initial_take_count
        si
    si
si
