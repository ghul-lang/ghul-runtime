namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements grouped into lists of `size`, with a final
    /// shorter list when `source`'s count isn't a multiple of `size`.
    class CHUNK_PIPE[T]: Pipe[LIST[T]] is
        /// This pipe, as its own iterator.
        iterator: Iterator[LIST[T]] => self

        /// The most recently produced chunk.
        current: LIST[T]

        _source: Iterable[T]
        _iterator: Iterator[T]
        _pending: PENDING_CURSOR[T]?

        _size: int

        // Set when the source signals exhaustion partway through a chunk.
        // The source rewinds itself at that point, so asking it again
        // would start pulling from the beginning; this pipe ends the pass
        // on its own instead.
        _done: bool

        /// Throws if `size` isn't positive.
        init(source: Iterable[T], size: int) is
            assert size > 0 else "chunk size must be positive"

            _source = source
            _iterator = source.iterator
            _size = size
            _done = false
        si

        /// Pulls up to `size` elements from the source into the next chunk;
        /// rewinds once the source runs out.
        move_next() -> bool is
            if _done then
                reset()

                return false
            fi

            let chunk = LIST[T]()

            while chunk.count < _size /\ _iterator.move_next() do
                chunk.add(_iterator.current)
            od

            if chunk.count < _size then
                _done = true
            fi

            if chunk.count == 0 then
                reset()

                return false
            fi

            current = chunk

            return true
        si

        /// Rewinds the source and clears the exhaustion flag.
        reset() is
            _iterator = rewind(_iterator, pending())
            _done = false
        si

        /// The placeholder cursor installed after a rewind, created once and reused.
        pending() -> PENDING_CURSOR[T] is
            if let p = _pending then
                return p
            fi

            let p = PENDING_CURSOR[T](_source, (it: Iterator[T]) is _iterator = it si)

            _pending = p

            return p
        si

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string => $(self)

        /// Disposes the underlying iterator.
        dispose() => _iterator.dispose()
    si
si
