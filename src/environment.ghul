namespace Ghul is
    use Collections

    // A live, forgiving string-keyed map: reading a key that was never set
    // answers absent rather than throwing, and setting a key to null
    // removes it - an accurate model of how a process environment actually
    // behaves, which Collections.MutableMap's IDictionary-shaped contract
    // (a value type with no null, add() that throws on a duplicate key,
    // the dictionary invariant that a written key is then present) is not.
    // to_map() is the escape hatch for code that wants the ordinary
    // Collections.Map contract instead - an immutable snapshot, not a view.
    //
    // Iteration yields Collections.KeyValuePair rather than a named tuple:
    // a tuple's element names don't survive being read back from another
    // assembly's metadata, and every real consumer of this trait is in a
    // different assembly from ghul-runtime by construction.
    /// A live view of a string-keyed environment: reading a key that isn't set gives an absent value, and writing null removes the key.
    trait Environment: Iterable[KeyValuePair[string, string]] is
        /// Reads or writes the value for `key`, absent if it isn't set.
        [key: string]: string?, = value

        /// Whether `key` is currently set.
        contains_key(key: string) -> bool

        /// Removes `key`, and returns whether it was set.
        remove(key: string) -> bool

        /// The keys currently set.
        keys: Iterable[string]

        /// The values of the keys currently set.
        values: Iterable[string]

        /// A snapshot of every key and value, as an ordinary `Map`.
        to_map() -> Map[string, string]
    si

    // A live view over the process environment - a read reaches
    // System.Environment.get_environment_variable on every access, and a
    // write reaches System.Environment.set_environment_variable, taking
    // effect for any process started afterwards. There is deliberately no
    // snapshot behind the indexer itself: a read twice can disagree if
    // something else in the process changed the variable in between, which
    // is also how a shell's own environment behaves. Enumeration (keys,
    // values, iteration, to_map) does take a one-off snapshot via
    // System.Environment.get_environment_variables() at the moment it is
    // asked for, which is the same snapshot .NET's own Dictionary-backed
    // collections take.
    /// The live process environment, backed by `System.Environment`.
    class ENVIRONMENT: Environment is
        _instance: ENVIRONMENT static

        init() static is
            _instance = ENVIRONMENT()
        si

        init() is
        si

        /// The process environment.
        instance: ENVIRONMENT static => _instance

        /// Reads or writes `key` in the process environment directly, with no snapshot behind it.
        [key: string]: string? =>
            System.Environment.get_environment_variable(key),
            = value is
                System.Environment.set_environment_variable(key, value)
            si

        /// Whether `key` is currently set in the process environment.
        contains_key(key: string) -> bool => self[key]?

        /// Removes `key` from the process environment, and returns whether it was set.
        remove(key: string) -> bool is
            if !contains_key(key) then
                return false
            fi

            self[key] = null

            return true
        si

        _snapshot() -> LIST[KeyValuePair[string, string]] is
            let result = LIST[KeyValuePair[string, string]]()
            let raw = System.Environment.get_environment_variables()

            for key in System.Linq.Enumerable.cast[string](raw.keys) do
                if let value: string = self[key] then
                    result.add(KeyValuePair[string, string](key, value))
                fi
            od

            return result
        si

        /// The keys set in the process environment, as of when this is read.
        keys: Iterable[string] is
            let result = LIST[string]()

            for entry in _snapshot() do
                result.add(entry.key)
            od

            return result
        si

        /// The values of the keys set in the process environment, as of when this is read.
        values: Iterable[string] is
            let result = LIST[string]()

            for entry in _snapshot() do
                result.add(entry.value)
            od

            return result
        si

        /// Iterates a snapshot of the process environment taken when this is read.
        iterator: Iterator[KeyValuePair[string, string]] => _snapshot().iterator

        /// A snapshot of the process environment as an ordinary `Map`.
        to_map() -> Map[string, string] is
            let result = MAP[string, string]()

            for entry in _snapshot() do
                result.add(entry.key, entry.value)
            od

            return result
        si
    si
si
