namespace Ghul.Pipes is
    use System.InvalidOperationException
    use System.NotImplementedException

    use System.Text.StringBuilder

    use Collections

    use System.Numerics.INumber

    // The arithmetic operators on a bounded type parameter are reachable
    // only once imported by name, and each comes from the interface that
    // declares it rather than from the bound.
    use System.Numerics.IAdditionOperators.`+
    use System.Numerics.IMultiplyOperators.`*

    // A pipe is a cursor over its source that rewinds itself at its end:
    // driven part way it carries on from wherever the last consumer
    // stopped, whoever that consumer was, and once it has run out the
    // next pull starts it over. A pipe source is rewound in place, so
    // every holder of that pipe sees it start over too. Nothing ever
    // calls `reset()` on a .NET enumerator - they are permitted to reject
    // it, and compiler-generated ones must - and none is fetched on the
    // rewind itself: the spent one is released and a fresh one is taken
    // from the source only when something next pulls.

    // Stands in for a stage's cursor between the end of one pass and the
    // first pull of the next. That pull takes a fresh iterator from the
    // source, installs it as the stage's cursor so every later pull goes
    // straight to it, and forwards itself. One per stage, made the first
    // time the stage runs out and kept for every rewind after.
    /// The cursor a pipe stage uses between the end of one pass and the first
    /// pull of the next. The first `move_next` call takes a fresh iterator
    /// from the source and installs it as the stage's own cursor.
    class PENDING_CURSOR[T]: Iterator[T] is
        _source: Iterable[T]
        _install: (Iterator[T]) -> void

        init(source: Iterable[T], install: (Iterator[T]) -> void) is
            _source = source
            _install = install
        si

        /// Always throws: this cursor never holds an element of its own.
        current: T => throw InvalidOperationException("no current element")

        /// Takes a fresh iterator from the source, installs it as the
        /// stage's cursor, and asks that iterator to move.
        move_next() -> bool is
            let it = _source.iterator

            _install(it)

            return it.move_next()
        si

        /// Has no effect.
        reset() is
        si

        /// Has no effect.
        dispose() is
        si
    si

    // Rewind a stage's cursor at the end of a pass. A pipe is rewound in
    // place, which rewinds whatever it draws from in turn, and stays the
    // cursor. Any other iterator is released, and `pending` takes its
    // place until the next pull.
    /// Rewinds `cursor` in place if it's itself a pipe; otherwise disposes
    /// it and returns `pending` for the stage to use until its next pull.
    rewind[T](cursor: Iterator[T], pending: PENDING_CURSOR[T]) -> Iterator[T] is
        if isa Pipe[T](cursor) then
            cursor.reset()

            return cursor
        fi

        if cursor != pending then
            cursor.dispose()
        fi

        return pending
    si

    // Lift an `Iterable[T]` (any producer with a `.iterator` —
    // includes any existing `Pipe[T]`, which is short-circuited via
    // an `isa` check) to `Pipe[T]`. For state-stepping producers,
    // use `stream(initial, advance)` (see `stream.ghul`).

    /// `source` as a `Pipe[T]`, unchanged if it already is one.
    pipe[T](source: Iterable[T]) -> Pipe[T] pure is
        if isa Pipe[T](source) then
            return cast Pipe[T](source)
        else
            return ADAPTOR_PIPE[T](source)
        fi
    si

    // T can't carry a bound inside Pipe[T] itself, so min/max are free
    // functions rather than trait members - min_by/max_by don't have
    // that problem, since the key type is a fresh per-call parameter.
    /// The least element of `values`, or absent when `values` is empty.
    min[T: Ghul.Comparable[T]](values: Iterable[T]) -> MAYBE[T] pure is
        let it = values.iterator

        if it.move_next() then
            let result mut = it.current

            while it.move_next() do
                if it.current < result then
                    result = it.current
                fi
            od

            return MAYBE(result)
        fi

        return MAYBE[T]()
    si

    /// The greatest element of `values`, or absent when `values` is empty.
    max[T: Ghul.Comparable[T]](values: Iterable[T]) -> MAYBE[T] pure is
        let it = values.iterator

        if it.move_next() then
            let result mut = it.current

            while it.move_next() do
                if it.current > result then
                    result = it.current
                fi
            od

            return MAYBE(result)
        fi

        return MAYBE[T]()
    si

    // Addition and multiplication each have an identity, so the total of
    // nothing is that identity rather than an absent value: `sum` and
    // `product` return `T` where `min` and `max` return `MAYBE[T]`, which
    // is what lets a total be used without unwrapping it first. The bound
    // is what makes `T.zero` and `T.one` reachable as well as the
    // operators. As with `min` and `max`, these are free functions
    // because `Pipe[T]` cannot bound its own `T`.
    /// The total of `source`'s elements, or `T.zero` when it's empty.
    sum[T: INumber[T]](source: Iterable[T]) -> T pure is
        let total mut = T.zero

        for value in source do
            total = total + value
        od

        return total
    si

    /// The product of `source`'s elements, or `T.one` when it's empty.
    product[T: INumber[T]](source: Iterable[T]) -> T pure is
        let running mut = T.one

        for value in source do
            running = running * value
        od

        return running
    si

    /// The total of what `selector` returns for each of `source`'s elements,
    /// or `N.zero` when it's empty.
    sum_by[T..,N: INumber[N]](source: Iterable[T], selector: T.. -> N pure) -> N pure is
        let total mut = N.zero

        for value in source do
            total = total + selector(value)
        od

        return total
    si

    // A pipe is an iterator that is also iterable, so it can be walked
    // by `for` and passed to the combinators in this namespace. The
    // combinators are the free functions above, called with `|>`; a pipe
    // carries no methods of its own beyond the iterator protocol.
    /// A cursor over a sequence that can be driven directly, or chained
    /// with the combinators in `Ghul.Pipes` through `|>`.
    trait Pipe[T: out]: Iterable[T], Iterator[T] is
        /// This pipe, as its own iterator.
        iterator: Iterator[T] => self

        /// Renders the pipe's elements, in order, as text.
        to_string() -> string =>
            $(self)

        /// Has no effect by default; a stage that holds a resource overrides
        /// it to release that resource.
        dispose() is
        si
    si
si
