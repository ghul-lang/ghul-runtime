namespace Ghul.Pipes is
    use Collections

    /// `source`'s elements that are also in `included`, with duplicates
    /// dropped after their first occurrence.
    class INTERSECT_PIPE[T]: FilterPipeBase[T] is
        _included: SET[T]
        _seen: SET[T]

        init(source: Iterable[T], included: Iterable[T]) is
            super.init(source)
            _included = SET[T](included)
            _seen = SET[T]()
        si

        /// Accepts an element the first time it's seen, provided it's also
        /// in `included`.
        should_include() -> bool is
            if !_included.contains(current) \/ _seen.contains(current) then
                return false
            fi

            _seen.add(current)

            return true
        si

        /// Rewinds the source and clears the set of elements seen so far.
        reset() is
            super.reset()
            _seen.clear()
        si
    si
si
