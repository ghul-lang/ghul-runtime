    /// Bitwise and.
    @INTRINSIC_ATTRIBUTE("arithmetic.and") &(a: ubyte, b: ubyte) -> ubyte pure
    /// Bitwise or.
    @INTRINSIC_ATTRIBUTE("arithmetic.or") |(a: ubyte, b: ubyte) -> ubyte pure
