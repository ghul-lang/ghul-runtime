namespace Ghul.Intrinsics.Staging is
    use INTRINSIC_ATTRIBUTE = Ghul.Internal.INTRINSIC_ATTRIBUTE
    // The compiler's intrinsic operators and magic types. Each carries
    // `INTRINSIC_ATTRIBUTE`, which is what makes the compiler reconstruct
    // it as an intrinsic — a call lowers straight to IL opcodes rather
    // than to a call of the method emitted here.
    //
    // They are declared under `Ghul.Intrinsics.Staging` but the compiler
    // registers them in `Ghul.Intrinsics`, the namespace every
    // compilation imports without a `use`. That relocation is what lets
    // this assembly declare its own intrinsics and still be compiled by
    // a compiler that reflects them: the declarations here and the
    // registrations they produce never occupy the same namespace, so
    // neither hides the other.

    /// The type of a `T ref` argument or local: a managed reference to a value of type `E`.
    @INTRINSIC_ATTRIBUTE("type.reference")
    struct REFERENCE[E] is
        /// Reads or writes the referenced value.
        value: E => throw System.NotImplementedException(), = value is si

        // TODO:
        // value: E innate reference.read, = value innate reference.assign;
    si

    /// The type of an array, `E[]`.
    @INTRINSIC_ATTRIBUTE("type.array")
    trait ARRAY[E]: Collections.List[E] is
    si

    /// The type of an unmanaged pointer to a value of type `E`, used at a native interop boundary.
    @INTRINSIC_ATTRIBUTE("type.pointer")
    struct POINTER[E] is
        /// Reads or writes the pointed-to value.
        value: E => throw System.NotImplementedException(), = value is si

        // TODO:
        // value: E innate pointer.read, = value innate pointer.assign;
    si

    // Generic equality: bit-compare any two values of the same
    // statically-known type. The `compare.value` innate lowers to a
    // single `ceq`, correct for value types (compares bits) and
    // reference types (compares references). Also covers `bool`,
    // which has no dedicated overload.
    /// Whether `a` and `b` are the same value, bit for bit.
    @INTRINSIC_ATTRIBUTE("compare.value") ==[T](a: T, b: T) -> bool pure

    // Handles null comparisons (`x == null`), where inference cannot
    // pin the generic's T, and explicit cross-type reference
    // comparisons. Both operands are `object?` so a nullable left or
    // right is accepted uniformly; `compare.reference` lowers to `ceq`,
    // which already handles null on either side (null == null is true,
    // null == ref is false). Mixed value/ref operands box and still
    // compare correctly.
    /// Whether `a` and `b` are the same object, or both null.
    @INTRINSIC_ATTRIBUTE("compare.reference") ==(a: object?, b: object?) -> bool pure

    /// Logical negation.
    @INTRINSIC_ATTRIBUTE("bool.not") !(a: bool) -> bool pure
    /// Logical negation.
    @INTRINSIC_ATTRIBUTE("bool.not") ¬(a: bool) -> bool pure

    /// Logical and, evaluating `b` only if `a` is true.
    @INTRINSIC_ATTRIBUTE("bool.and_then") /\ (a: bool, b: bool) -> bool pure
    /// Logical or, evaluating `b` only if `a` is false.
    @INTRINSIC_ATTRIBUTE("bool.or_else") \/ (a: bool, b: bool) -> bool pure

    /// Negates `a`.
    @INTRINSIC_ATTRIBUTE("arithmetic.neg") -(a: char) -> char pure
    /// Adds two `char` values.
    @INTRINSIC_ATTRIBUTE("arithmetic.add") +(a: char, b: char) -> char pure
    /// Subtracts `b` from `a`.
    @INTRINSIC_ATTRIBUTE("arithmetic.sub") -(a: char, b: char) -> char pure
    /// Multiplies two `char` values.
    @INTRINSIC_ATTRIBUTE("arithmetic.mul") *(a: char, b: char) -> char pure
    /// Divides `a` by `b`.
    @INTRINSIC_ATTRIBUTE("arithmetic.div") /(a: char, b: char) -> char pure
    /// The remainder of dividing `a` by `b`.
    @INTRINSIC_ATTRIBUTE("arithmetic.rem") %(a: char, b: char) -> char pure
    /// Orders `a` against `b`: negative, zero or positive as `a` is less than, equal to or greater than `b`.
    @INTRINSIC_ATTRIBUTE("compare.order") <>(a: char, b: char) -> int pure

    /// Bitwise complement.
    @INTRINSIC_ATTRIBUTE("arithmetic.not") \(a: byte) -> byte pure
    /// Negates `a`.
    @INTRINSIC_ATTRIBUTE("arithmetic.neg") -(a: byte) -> byte pure
    /// Adds two `byte` values.
    @INTRINSIC_ATTRIBUTE("arithmetic.add") +(a: byte, b: byte) -> byte pure
    /// Subtracts `b` from `a`.
    @INTRINSIC_ATTRIBUTE("arithmetic.sub") -(a: byte, b: byte) -> byte pure
    /// Multiplies two `byte` values.
    @INTRINSIC_ATTRIBUTE("arithmetic.mul") *(a: byte, b: byte) -> byte pure
    /// Divides `a` by `b`.
    @INTRINSIC_ATTRIBUTE("arithmetic.div") /(a: byte, b: byte) -> byte pure
    /// The remainder of dividing `a` by `b`.
    @INTRINSIC_ATTRIBUTE("arithmetic.rem") %(a: byte, b: byte) -> byte pure
    /// Orders `a` against `b`: negative, zero or positive as `a` is less than, equal to or greater than `b`.
    @INTRINSIC_ATTRIBUTE("compare.order") <>(a: byte, b: byte) -> int pure
    /// Shifts `a` left by `b` bits.
    @INTRINSIC_ATTRIBUTE("arithmetic.shl") <<(a: byte, b: int) -> byte pure
    /// Shifts `a` right by `b` bits, keeping its sign.
    @INTRINSIC_ATTRIBUTE("arithmetic.shr") >>(a: byte, b: int) -> byte pure
    /// Shifts `a` right by `b` bits, filling with zero.
    @INTRINSIC_ATTRIBUTE("arithmetic.ushr") >>>(a: byte, b: int) -> byte pure
    /// Bitwise and.
    @INTRINSIC_ATTRIBUTE("arithmetic.and") &(a: byte, b: byte) -> byte pure
    /// Bitwise or.
    @INTRINSIC_ATTRIBUTE("arithmetic.or") |(a: byte, b: byte) -> byte pure
    /// Bitwise xor.
    @INTRINSIC_ATTRIBUTE("arithmetic.xor") ^(a: byte, b: byte) -> byte pure

