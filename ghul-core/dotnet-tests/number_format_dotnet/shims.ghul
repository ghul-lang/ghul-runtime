// Stands in for the core library's string and bit intrinsics on .NET, so the
// numeric formatter can be checked against .NET's own text.
namespace Ghul is
    _string_concat(left: string?, right: string?) -> string => "{left}{right}"
    _string_from_char(unit: char) -> string => "{unit}"
    _double_bits(value: double) -> ulong => cast ulong(System.BitConverter.double_to_int64_bits(value))
    _single_bits(value: single) -> uint => cast uint(System.BitConverter.single_to_int32_bits(value))
    _string_length(text: string) -> int => text.length
    _array_new[E](count: int) -> ARRAY[E] => cast ARRAY[E](System.Array.create_instance(typeof E, count))
    _array_set[E](array: ARRAY[E], index: int, value: E) => cast System.Array(array).set_value(value, index)
    _string_from_chars(chars: ARRAY[char], start: int, count: int) -> string => string(chars, start, count)

    _string_copy_to(text: string, start: int, chars: ARRAY[char], at: int, count: int) is
        for i in 0..count do
            _array_set(chars, at + i, text[start + i])
        od
    si
si
