// Writes src/text_element_tables.ghul: the grapheme cluster break class of
// every code point, as .NET's text element segmentation sees it. Each class
// is found by asking System.Globalization.StringInfo where a short probe
// string breaks, so the tables follow the Unicode version of the .NET that
// runs this, rules and all.
//
//     dotnet run --project tools/text-element-tables > src/text_element_tables.ghul
//
// The class numbers are the constants in src/text_elements.ghul.
namespace Generate is
    use IO.Std.write_line
    use System.Globalization.StringInfo

    // Whether .NET reads all of `text` as one text element.
    one(text: string) -> bool => StringInfo.get_next_text_element_length(text, 0) == text.length

    class_of(code: int) -> int is
        if code == 0x0D then return 1 fi
        if code == 0x0A then return 2 fi
        if code == 0x200D then return 5 fi

        let c = char.convert_from_utf32(code)

        // Nothing joins a control to what follows it, not even a combining mark.
        if !one("{c}\u0301") then return 3 fi

        // Extend and SpacingMark both join to what precedes them; only Extend
        // may stand between a pictograph and a zero-width joiner.
        if one("a{c}") then
            return if one("\uD83D\uDE00{c}\u200D\uD83D\uDE00") then 4 else 8 fi
        fi

        if one("{c}a") then return 7 fi

        if one("{c}\u200D\uD83D\uDE00") then return 14 fi

        // A regional indicator pairs with the next one.
        if one("\uD83C\uDDEC{c}") then return 6 fi

        // The Hangul classes, told apart by their neighbours: L, V, LV and LVT
        // all follow a leading jamo; of those only L precedes another L, only
        // V follows an LV syllable, and of the two syllables only LV precedes
        // a vowel. T follows an LVT syllable.
        if one("\u1100{c}") then
            return
                if one("{c}\u1100") then 9
                elif one("\uAC00{c}") then 10
                elif one("{c}\u1161") then 12
                else 13
                fi
        fi

        if one("\uAC01{c}") then return 11 fi

        return 0
    si

    entry() is
        let ranges = Collections.LIST[(first: int, last: int, kind: int)]()
        let start mut = 0
        let current mut = class_of(0)
        let code mut = 1

        while code <= 0x10FFFF do
            let kind =
                if code >= 0xD800 /\ code <= 0xDFFF then 0
                else class_of(code)
                fi

            if kind != current then
                if current != 0 then
                    ranges.add((first = start, last = code - 1, kind = current))
                fi

                start = code
                current = kind
            fi

            code = code + 1
        od

        if current != 0 then
            ranges.add((first = start, last = 0x10FFFF, kind = current))
        fi

        write_line("// Generated by tools/text-element-tables from .NET {System.Environment.version.major}.{System.Environment.version.minor}'s text element")
        write_line("// segmentation. Do not edit: run the generator again instead.")
        write_line("namespace Ghul is")
        write_line("    // The code point ranges whose grapheme cluster break class is not Other, in")
        write_line("    // order, each written FIRST-LAST:C, where FIRST and LAST are the range's")
        write_line("    // first and last code point in six hexadecimal digits and C is its class.")
        write_line("    _text_element_ranges() -> string =>")

        let line = Text.STRING_BUILDER()
        let i mut = 0

        while i < ranges.count do
            let r = ranges[i]

            line.append("{r.first:X6}-{r.last:X6}:{r.kind:X1} ")

            if i % 4 == 3 \/ i == ranges.count - 1 then
                write_line("        \"{line.to_string()}\"")
                line.clear()
            fi

            i = i + 1
        od

        write_line("si")
    si
si
