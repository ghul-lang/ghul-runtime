// Writes ghul-core/src/ryu_tables.ghul: the powers of five that Ryū's
// shortest double and single formatting multiplies by, each computed exactly
// from 5^i. Regenerate with:
//
//     ghul run ghul-core/tools/ryu-tables.ghul > ghul-core/src/ryu_tables.ghul
//
// For entry i, with b the bit length of 5^i:
//   - an inverse entry is floor(2^(b - 1 + B) / 5^i) + 1, for the inverse
//     bit count B;
//   - a power entry is 5^i scaled to exactly B bits, for the power bit
//     count B.
// A double's entries take 125 bits, held as a low and a high ulong; a
// single's inverse entries take 59 bits and its power entries 61.
use default

pow5_bits(e: int) -> int => ((e * 1217359) >>> 19) + 1

inverse(i: int, bit_count: int) -> bigint =>
    (1n << (pow5_bits(i) - 1 + bit_count)) / bigint.pow(5n, i) + 1n

power(i: int, bit_count: int) -> bigint is
    let value = bigint.pow(5n, i)
    let shift = pow5_bits(i) - bit_count

    return if shift >= 0 then value >> shift else value << -shift fi
si

let mask = (1n << 64) - 1n

write_table(name: string, count: int, entry: int -> bigint, halves: bool) is
    write_line("            {name} = [")

    for i in 0..count do
        let value = entry(i)
        let separator = if i < count - 1 then "," else "" fi

        if halves then
            write_line("                {cast ulong(value & mask)}ul, {cast ulong(value >> 64)}ul{separator}")
        else
            write_line("                {cast ulong(value)}ul{separator}")
        fi
    od

    write_line("            ]")
si

write_line("namespace Ghul is")
write_line("    // Generated by ghul-core/tools/ryu-tables.ghul, which says how to")
write_line("    // regenerate it: the powers of five Ryū multiplies by. Don't edit.")
write_line("    class RYU_TABLES is")
write_line("        // Entry i is at 2i (low half) and 2i + 1 (high half).")
write_line("        DOUBLE_POW5_INV_SPLIT: ARRAY[ulong] static")
write_line("        // Entry i is at 2i (low half) and 2i + 1 (high half).")
write_line("        DOUBLE_POW5_SPLIT: ARRAY[ulong] static")
write_line("        FLOAT_POW5_INV_SPLIT: ARRAY[ulong] static")
write_line("        FLOAT_POW5_SPLIT: ARRAY[ulong] static")
write_line("")
write_line("        init() static is")
write_table("DOUBLE_POW5_INV_SPLIT", 292, inverse(*, 125), true)
write_line("")
write_table("DOUBLE_POW5_SPLIT", 326, power(*, 125), true)
write_line("")
write_table("FLOAT_POW5_INV_SPLIT", 31, inverse(*, 59), false)
write_line("")
write_table("FLOAT_POW5_SPLIT", 48, power(*, 61), false)
write_line("        si")
write_line("    si")
write_line("si")
