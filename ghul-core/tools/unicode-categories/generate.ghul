// Writes src/unicode_category_tables.ghul: the Unicode general category of
// every UTF-16 code unit, as .NET's char.GetUnicodeCategory reports it, so
// the tables follow the Unicode version of the .NET that runs this.
//
//     dotnet run --project tools/unicode-categories > src/unicode_category_tables.ghul
//
// The category numbers are .NET's UnicodeCategory values, which
// src/unicode_category.ghul declares as Text.UnicodeCategory.
namespace Generate is
    use IO.Std.write_line

    category_of(code: int) -> int => cast int(char.get_unicode_category(cast char(code)))

    entry() is
        let ranges = Collections.LIST[(first: int, last: int, category: int)]()
        let start mut = 0
        let current mut = category_of(0)
        let code mut = 1

        while code <= 0xFFFF do
            let category = category_of(code)

            if category != current then
                ranges.add((first = start, last = code - 1, category = current))
                start = code
                current = category
            fi

            code = code + 1
        od

        ranges.add((first = start, last = 0xFFFF, category = current))

        write_line("// Generated by tools/unicode-categories from .NET {System.Environment.version.major}.{System.Environment.version.minor}'s general")
        write_line("// categories. Do not edit: run the generator again instead.")
        write_line("namespace Ghul is")
        write_line("    // Every UTF-16 code unit's general category, as ranges in order, each")
        write_line("    // written FIRST-LAST:CC, where FIRST and LAST are the range's first and")
        write_line("    // last code unit in four hexadecimal digits and CC is the category's")
        write_line("    // UnicodeCategory value in two.")
        write_line("    _unicode_category_ranges() -> string =>")

        let line = Text.STRING_BUILDER()
        let i mut = 0

        while i < ranges.count do
            let r = ranges[i]

            line.append("{r.first:X4}-{r.last:X4}:{r.category:X2} ")

            if i % 6 == 5 \/ i == ranges.count - 1 then
                write_line("        \"{line.to_string()}\"")
                line.clear()
            fi

            i = i + 1
        od

        write_line("si")
    si
si
