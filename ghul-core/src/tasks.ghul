namespace Tasks is
    use Collections.LIST
    use Collections.QUEUE

    use System.Runtime.CompilerServices.AsyncMethodBuilder
    use System.Runtime.CompilerServices.IAsyncStateMachine
    use System.Runtime.CompilerServices.INotifyCompletion
    use System.Runtime.CompilerServices.ICriticalNotifyCompletion

    // Tasks run by the thread that started them. Nothing runs
    // concurrently on one thread: a continuation is queued when what it
    // waits for completes, and the queue is run by whatever waits for a
    // task's result, until that task completes. Work another thread owes
    // this one, such as a thread's completion it awaits, arrives in its
    // inbox and runs on this thread. A wait that can never be satisfied,
    // because nothing is queued, no delay is pending and no other thread
    // owes it anything, throws rather than hangs.

    /// An operation that completes later, with no result.
    @AsyncMethodBuilder(typeof(TASK_BUILDER))
    class Future is
        _state: TASK_STATE

        /// A task that has not completed.
        init() is
            _state = TASK_STATE()
        si

        /// Whether the task has completed, successfully or not.
        is_completed: bool => _state.is_completed

        /// Whether the task completed by throwing.
        is_faulted: bool => _state.is_faulted

        /// Whether the task completed without throwing.
        is_completed_successfully: bool => _state.is_completed /\ !_state.is_faulted

        /// What the task threw, or null where it has not thrown.
        exception: Ghul.Exception? => _state.exception

        /// The awaiter `await` reads the task through.
        get_awaiter() -> TASK_AWAITER => TASK_AWAITER(self)

        /// The task itself: there is no context to return to.
        ///
        /// - continue_on_captured_context: ignored
        configure_await(continue_on_captured_context: bool) -> Future => self

        /// Runs queued work until the task completes. A task that threw
        /// throws an `AggregateException` holding what it threw.
        wait() is
            // Registering marks the thread as owed the completion, which
            // another thread may deliver.
            if !_state.is_completed then
                _state.watch()
            fi

            SCHEDULER.run_until(_state)
            _state.throw_aggregate()
        si

        /// A task that runs `action` with this one once it completes.
        ///
        /// - action: what to run
        continue_with(action: Future -> void) -> Future is
            let result = Future()

            _state.on_completed(() is
                try
                    action(self)
                    result.state.complete()
                catch e: Ghul.Exception
                    result.state.fail(e)
                yrt
            si)

            return result
        si

        /// A task whose result is what `function` answers for this one once
        /// it completes.
        ///
        /// - function: what to run
        continue_with[U](function: Future -> U) -> Future[U] is
            let result = Future[U]()

            _state.on_completed(() is
                try
                    result.set_result(function(self))
                catch e: Ghul.Exception
                    result.state.fail(e)
                yrt
            si)

            return result
        si

        /// What completes the task, for the library's own use.
        state: TASK_STATE => _state

        /// A task that has already completed.
        completed_task: Future static is
            let task = Future()

            task.state.complete()

            return task
        si

        /// A task that has already completed with `result`.
        ///
        /// - result: the task's result
        from_result[T](result: T) -> Future[T] static is
            let task = Future[T]()

            task.set_result(result)

            return task
        si

        /// A task that has already thrown `exception`.
        ///
        /// - exception: what the task threw
        from_exception(exception: Ghul.Exception) -> Future static is
            let task = Future()

            task.state.fail(exception)

            return task
        si

        /// A task with a result of type `T` that has already thrown
        /// `exception`.
        ///
        /// - exception: what the task threw
        from_exception[T](exception: Ghul.Exception) -> Future[T] static is
            let task = Future[T]()

            task.state.fail(exception)

            return task
        si

        /// A task that completes once `milliseconds` have passed, measured
        /// on the host's monotonic clock while something waits.
        ///
        /// - milliseconds: how long to wait
        delay(milliseconds: int) -> Future static is
            let task = Future()

            SCHEDULER.after(milliseconds, task.state)

            return task
        si

        /// What an `await` reads to let queued work run before carrying on.
        `yield() -> YIELD_AWAITABLE static => YIELD_AWAITABLE()

        /// A task that runs `action` when queued work next runs.
        ///
        /// - action: what to run
        run(action: () -> void) -> Future static is
            let task = Future()

            SCHEDULER.post(() is
                try
                    action()
                    task.state.complete()
                catch e: Ghul.Exception
                    task.state.fail(e)
                yrt
            si)

            return task
        si

        /// A task whose result is what `function` answers when queued work
        /// next runs.
        ///
        /// - function: what to run
        run[T](function: () -> T) -> Future[T] static is
            let task = Future[T]()

            SCHEDULER.post(() is
                try
                    task.set_result(function())
                catch e: Ghul.Exception
                    task.state.fail(e)
                yrt
            si)

            return task
        si

        /// A task whose result is the results of `tasks`, in order, once all
        /// of them complete. It throws what the first of them that threw
        /// threw.
        ///
        /// - tasks: the tasks to wait for
        when_all[T](tasks: Collections.Iterable[Future[T]]) -> Future[ARRAY[T]] static is
            let all = LIST[Future[T]](tasks)
            let result = Future[ARRAY[T]]()
            let remaining mut = all.count

            let finish = () is
                let results = LIST[T]()

                for task in all do
                    if task.is_faulted then
                        result.state.fail(task.exception!)
                        return
                    fi

                    results.add(task.state_result)
                od

                result.set_result(results.to_array())
            si

            if remaining == 0 then
                finish()
            fi

            for task in all do
                task.state.on_completed(() is
                    remaining = remaining - 1

                    if remaining == 0 then
                        finish()
                    fi
                si)
            od

            return result
        si
    si

    /// An operation that completes later, with a result.
    @AsyncMethodBuilder(typeof(TASK_BUILDER[_]))
    class Future[T]: Future is
        _result: T

        /// A task that has not completed.
        init() is
            super.init()
        si

        /// The task's result, running queued work until it completes. A task
        /// that threw throws an `AggregateException` holding what it threw.
        result: T is
            wait()

            return _result
        si

        /// The result as it stands, for the library's own use: only read
        /// once the task has completed successfully.
        state_result: T => _result

        /// The awaiter `await` reads the task through, which answers the
        /// result. Awaiting the task as a `Future` reaches the base's instead,
        /// which drops it.
        @suppress("hides-inherited")
        get_awaiter() -> TASK_AWAITER[T] => TASK_AWAITER[T](self)

        /// The task itself: there is no context to return to.
        ///
        /// - continue_on_captured_context: ignored
        configure_await(continue_on_captured_context: bool) -> Future[T] => self

        /// A task that runs `action` with this one once it completes.
        ///
        /// - action: what to run
        continue_with(action: Future[T] -> void) -> Future is
            let result = Future()

            state.on_completed(() is
                try
                    action(self)
                    result.state.complete()
                catch e: Ghul.Exception
                    result.state.fail(e)
                yrt
            si)

            return result
        si

        /// A task whose result is what `function` answers for this one once
        /// it completes.
        ///
        /// - function: what to run
        continue_with[U](function: Future[T] -> U) -> Future[U] is
            let result = Future[U]()

            state.on_completed(() is
                try
                    result.set_result(function(self))
                catch e: Ghul.Exception
                    result.state.fail(e)
                yrt
            si)

            return result
        si

        /// Completes the task with `result`, for the library's own use.
        ///
        /// - result: the task's result
        set_result(result: T) is
            if !try_set_result(result) then
                state.complete()
            fi
        si

        /// Completes the task with `result` unless it has already
        /// completed, answering whether this completed it.
        ///
        /// - result: the task's result
        try_set_result(result: T) -> bool => state.try_complete_after(() is _result = result si)
    si

    /// The side of a `Future` that completes it: whoever holds the
    /// completer decides when, and with what, its future completes, from
    /// any thread.
    class Completer is
        _task: Future

        /// A completer whose future has not completed.
        init() is
            _task = Future()
        si

        /// The future this completes.
        task: Future => _task

        /// Completes the future successfully.
        set_result() is
            _task.state.complete()
        si

        /// Completes the future successfully unless it has already
        /// completed, answering whether this completed it.
        try_set_result() -> bool => _task.state.try_complete()

        /// Completes the future with `exception`.
        ///
        /// - exception: what the future throws
        set_exception(exception: Ghul.Exception) is
            _task.state.fail(exception)
        si

        /// Completes the future with `exception` unless it has already
        /// completed, answering whether this completed it.
        ///
        /// - exception: what the future throws
        try_set_exception(exception: Ghul.Exception) -> bool => _task.state.try_fail(exception)
    si

    /// The side of a `Future[T]` that completes it with a result: whoever
    /// holds the completer decides when, and with what, its future
    /// completes, from any thread.
    class Completer[T] is
        _task: Future[T]

        /// A completer whose future has not completed.
        init() is
            _task = Future[T]()
        si

        /// The future this completes.
        task: Future[T] => _task

        /// Completes the future with `result`.
        ///
        /// - result: the future's result
        set_result(result: T) is
            if !try_set_result(result) then
                throw Ghul.InvalidOperationException("An attempt was made to transition a task to a final state when it had already completed.")
            fi
        si

        /// Completes the future with `result` unless it has already
        /// completed, answering whether this completed it.
        ///
        /// - result: the future's result
        try_set_result(result: T) -> bool => _task.try_set_result(result)

        /// Completes the future with `exception`.
        ///
        /// - exception: what the future throws
        set_exception(exception: Ghul.Exception) is
            _task.state.fail(exception)
        si

        /// Completes the future with `exception` unless it has already
        /// completed, answering whether this completed it.
        ///
        /// - exception: what the future throws
        try_set_exception(exception: Ghul.Exception) -> bool => _task.state.try_fail(exception)
    si

    /// Helpers over tasks of tasks.
    class TaskExtensions is
        /// A task that completes as the task `task` answers does.
        ///
        /// - task: a task whose result is a task
        unwrap[T](task: Future[Future[T]]) -> Future[T] static is
            let result = Future[T]()

            task.state.on_completed(() is
                if task.is_faulted then
                    result.state.fail(task.exception!)
                    return
                fi

                let inner = task.state_result

                inner.state.on_completed(() is
                    if inner.is_faulted then
                        result.state.fail(inner.exception!)
                    else
                        result.set_result(inner.state_result)
                    fi
                si)
            si)

            return result
        si

        /// A task that completes as the task `task` answers does.
        ///
        /// - task: a task whose result is a task
        unwrap(task: Future[Future]) -> Future static is
            let result = Future()

            task.state.on_completed(() is
                if task.is_faulted then
                    result.state.fail(task.exception!)
                    return
                fi

                let inner = task.state_result

                inner.state.on_completed(() is
                    if inner.is_faulted then
                        result.state.fail(inner.exception!)
                    else
                        result.state.complete()
                    fi
                si)
            si)

            return result
        si
    si

    /// How a task stands, and what runs once it completes. Any thread may
    /// complete it, and any thread may wait for it: what a thread queues to
    /// run once it completes runs on that thread.
    class TASK_STATE is
        _is_completed: bool
        _exception: Ghul.Exception?
        _continuations: LIST[() -> void]
        _guard: Ghul.Internal.LOCK

        /// A task that has not completed.
        init() is
            _continuations = LIST[() -> void]()
            _guard = Ghul.Internal.LOCK()
        si

        /// Whether the task has completed, successfully or not.
        is_completed: bool is
            _guard.enter()
            let completed = _is_completed
            _guard.exit()

            return completed
        si

        /// Whether the task completed by throwing.
        is_faulted: bool => is_completed /\ _exception?

        /// What the task threw, or null where it has not thrown.
        exception: Ghul.Exception? => if is_completed then _exception else null fi

        /// Completes the task successfully, queueing what waits for it.
        complete() is
            if !try_complete() then
                _already_completed()
            fi
        si

        /// Completes the task with `exception`, queueing what waits for it.
        ///
        /// - exception: what the task threw
        fail(exception: Ghul.Exception) is
            if !try_fail(exception) then
                _already_completed()
            fi
        si

        /// Completes the task successfully unless it has already completed,
        /// answering whether this completed it.
        try_complete() -> bool => _finish(null, null)

        /// Completes the task successfully unless it has already completed,
        /// first running `store` - which records the result - while no
        /// other thread can complete it. Answers whether this completed it.
        ///
        /// - store: what records the task's result
        try_complete_after(store: () -> void) -> bool => _finish(null, store)

        /// Completes the task with `exception` unless it has already
        /// completed, answering whether this completed it.
        ///
        /// - exception: what the task threw
        try_fail(exception: Ghul.Exception) -> bool => _finish(exception, null)

        /// Queues `continuation` to run on the calling thread once the task
        /// completes, at once where it already has.
        ///
        /// - continuation: what to run
        on_completed(continuation: () -> void) is
            _guard.enter()

            if _is_completed then
                _guard.exit()
                SCHEDULER.post(continuation)
                return
            fi

            _continuations.add(SCHEDULER.route_here(continuation))
            _guard.exit()
        si

        /// Marks the calling thread as waiting for the task, so it waits for
        /// another thread to complete it rather than finding nothing left
        /// that could.
        watch() is
            on_completed(() is _woken() si)
        si

        _woken() is si

        /// Throws an `AggregateException` holding what the task threw, where
        /// it threw.
        throw_aggregate() is
            if let e = exception then
                throw Ghul.AggregateException(e)
            fi
        si

        _finish(exception: Ghul.Exception?, store: (() -> void)?) -> bool is
            _guard.enter()

            if _is_completed then
                _guard.exit()
                return false
            fi

            if let s = store then
                s()
            fi

            _exception = exception
            _is_completed = true

            let waiting = _continuations
            _continuations = LIST[() -> void]()
            _guard.exit()

            for continuation in waiting do
                continuation()
            od

            return true
        si

        _already_completed() is
            throw Ghul.InvalidOperationException("An attempt was made to transition a task to a final state when it had already completed.")
        si
    si

    /// What `await` reads a `Future` through.
    class TASK_AWAITER: ICriticalNotifyCompletion is
        _task: Future

        /// - task: the task awaited
        init(task: Future) is
            _task = task
        si

        /// Whether the task has completed.
        is_completed: bool => _task.is_completed

        /// Throws what the task threw, where it threw.
        get_result() is
            if let e = _task.exception then
                throw e
            fi
        si

        /// Queues `continuation` once the task completes.
        ///
        /// - continuation: what to run
        on_completed(continuation: () -> void) is
            _task.state.on_completed(continuation)
        si

        /// Queues `continuation` once the task completes.
        ///
        /// - continuation: what to run
        unsafe_on_completed(continuation: () -> void) is
            _task.state.on_completed(continuation)
        si
    si

    /// What `await` reads a `Future[T]` through.
    class TASK_AWAITER[T]: ICriticalNotifyCompletion is
        _task: Future[T]

        /// - task: the task awaited
        init(task: Future[T]) is
            _task = task
        si

        /// Whether the task has completed.
        is_completed: bool => _task.is_completed

        /// The task's result, or what it threw thrown again.
        get_result() -> T is
            if let e = _task.exception then
                throw e
            fi

            return _task.state_result
        si

        /// Queues `continuation` once the task completes.
        ///
        /// - continuation: what to run
        on_completed(continuation: () -> void) is
            _task.state.on_completed(continuation)
        si

        /// Queues `continuation` once the task completes.
        ///
        /// - continuation: what to run
        unsafe_on_completed(continuation: () -> void) is
            _task.state.on_completed(continuation)
        si
    si

    /// What `await Future.yield()` reads: it never completes at once, so the
    /// awaiting function carries on only once queued work ahead of it has
    /// run.
    class YIELD_AWAITABLE: ICriticalNotifyCompletion is
        init() is si

        /// The awaitable itself.
        get_awaiter() -> YIELD_AWAITABLE => self

        /// Always false.
        is_completed: bool => false

        /// Nothing to answer.
        get_result() is si

        /// Queues `continuation`.
        ///
        /// - continuation: what to run
        on_completed(continuation: () -> void) is
            SCHEDULER.post(continuation)
        si

        /// Queues `continuation`.
        ///
        /// - continuation: what to run
        unsafe_on_completed(continuation: () -> void) is
            SCHEDULER.post(continuation)
        si
    si

    /// The builder an asynchronous function returning `Future` is driven by.
    class TASK_BUILDER is
        _task: Future

        init() is
            _task = Future()
        si

        /// A builder for a new task.
        create() -> TASK_BUILDER static => TASK_BUILDER()

        /// Runs the function until it first suspends.
        ///
        /// - state_machine: the function's state machine
        start[S: IAsyncStateMachine](state_machine: S ref) is
            state_machine!.move_next()
        si

        /// The task the function answers.
        task: Future => _task

        /// Completes the task.
        set_result() is
            _task.state.complete()
        si

        /// Completes the task with what the function threw.
        ///
        /// - exception: what the function threw
        set_exception(exception: Ghul.Exception) is
            _task.state.fail(exception)
        si

        /// Has nothing to keep: the state machine is an object already.
        ///
        /// - state_machine: ignored
        set_state_machine(state_machine: IAsyncStateMachine) is si

        /// Resumes the function once `awaiter` completes.
        ///
        /// - awaiter: what the function waits for
        /// - state_machine: the function's state machine
        await_on_completed[A: INotifyCompletion, S: IAsyncStateMachine](awaiter: A ref, state_machine: S ref) is
            let machine = state_machine!

            awaiter!.on_completed(() is machine.move_next() si)
        si

        /// Resumes the function once `awaiter` completes.
        ///
        /// - awaiter: what the function waits for
        /// - state_machine: the function's state machine
        await_unsafe_on_completed[A: ICriticalNotifyCompletion, S: IAsyncStateMachine](awaiter: A ref, state_machine: S ref) is
            let machine = state_machine!

            awaiter!.unsafe_on_completed(() is machine.move_next() si)
        si
    si

    /// The builder an asynchronous function returning `Future[T]` is driven by.
    class TASK_BUILDER[T] is
        _task: Future[T]

        init() is
            _task = Future[T]()
        si

        /// A builder for a new task.
        create() -> TASK_BUILDER[T] static => TASK_BUILDER[T]()

        /// Runs the function until it first suspends.
        ///
        /// - state_machine: the function's state machine
        start[S: IAsyncStateMachine](state_machine: S ref) is
            state_machine!.move_next()
        si

        /// The task the function answers.
        task: Future[T] => _task

        /// Completes the task with `result`.
        ///
        /// - result: what the function answered
        set_result(result: T) is
            _task.set_result(result)
        si

        /// Completes the task with what the function threw.
        ///
        /// - exception: what the function threw
        set_exception(exception: Ghul.Exception) is
            _task.state.fail(exception)
        si

        /// Has nothing to keep: the state machine is an object already.
        ///
        /// - state_machine: ignored
        set_state_machine(state_machine: IAsyncStateMachine) is si

        /// Resumes the function once `awaiter` completes.
        ///
        /// - awaiter: what the function waits for
        /// - state_machine: the function's state machine
        await_on_completed[A: INotifyCompletion, S: IAsyncStateMachine](awaiter: A ref, state_machine: S ref) is
            let machine = state_machine!

            awaiter!.on_completed(() is machine.move_next() si)
        si

        /// Resumes the function once `awaiter` completes.
        ///
        /// - awaiter: what the function waits for
        /// - state_machine: the function's state machine
        await_unsafe_on_completed[A: ICriticalNotifyCompletion, S: IAsyncStateMachine](awaiter: A ref, state_machine: S ref) is
            let machine = state_machine!

            awaiter!.unsafe_on_completed(() is machine.move_next() si)
        si
    si

    // A thread's queue of work, and the delays waiting on the clock: each
    // thread runs its own tasks. On llvm, work another thread hands this
    // one arrives in its inbox, which it has once it first waits on
    // another thread.
    class SCHEDULER is
        LIVE_CHECK_MILLISECONDS: long static => 50L

        _ready: QUEUE[() -> void]
        _timers: LIST[(due: long, state: TASK_STATE)]

        @IF.llvm()
        _inbox: Ghul.Internal.INBOX?

        init() is
            _ready = QUEUE[() -> void]()
            _timers = LIST[(due: long, state: TASK_STATE)]()
        si

        // The calling thread's scheduler, made the first time it asks.
        _here: SCHEDULER static is
            let locals = Ghul.Internal.THREAD_LOCALS.current

            if let found = locals.scheduler then
                return found
            fi

            let made = SCHEDULER()

            locals.scheduler = made

            return made
        si

        /// Queues `work` to run when queued work next runs.
        ///
        /// - work: what to run
        post(work: () -> void) static is
            _here._ready.enqueue(work)
        si

        /// Completes `state` once `milliseconds` have passed.
        ///
        /// - milliseconds: how long to wait
        /// - state: what completes
        after(milliseconds: int, state: TASK_STATE) static is
            _here._timers.add((System.Environment.tick_count64 + cast long(milliseconds), state))
        si

        /// The calling thread's inbox, made the first time, counting one
        /// more piece of work another thread will hand it through
        /// `deliver`.
        @IF.llvm()
        expect_from_another_thread() -> Ghul.Internal.INBOX static is
            let here = _here

            if !here._inbox? then
                here._inbox = Ghul.Internal.INBOX()
            fi

            let inbox = here._inbox!

            inbox.expect()

            return inbox
        si

        /// Wraps `work` so that whichever thread calls the wrapper hands
        /// `work` back to the calling thread, to run when its queued work
        /// next runs. The calling thread then waits for it rather than
        /// finding nothing left to wait for.
        ///
        /// - work: what to run on the calling thread
        @IF.llvm()
        route_here(work: () -> void) -> () -> void static is
            let inbox = expect_from_another_thread()

            return () is inbox.deliver(work) si
        si

        /// Wraps `work` so that calling the wrapper queues it.
        ///
        /// - work: what to queue
        @IF.wasm()
        route_here(work: () -> void) -> () -> void static => () is post(work) si

        /// Runs the work queued on the calling thread, and takes what other
        /// threads have handed it; where there is none, waits up to
        /// `milliseconds` for some, or for a delay to fall due. A negative
        /// `milliseconds` waits as long as another thread still owes the
        /// thread work.
        ///
        /// - milliseconds: how long to wait where nothing is ready
        @IF.llvm()
        run_ready(milliseconds: long) static is
            _here._run_ready(milliseconds)
        si

        @IF.llvm()
        _run_ready(milliseconds: long) is
            _take_from_inbox()

            if _ready.count == 0 /\ _inbox? then
                if _timers.count > 0 then
                    let earliest = _earliest_timer()
                    let remaining = _timers[earliest].due - System.Environment.tick_count64
                    let wait = if milliseconds >= 0L /\ milliseconds < remaining then milliseconds else remaining fi

                    if wait > 0L then
                        _inbox!.wait(wait)
                    fi

                    if System.Environment.tick_count64 >= _timers[earliest].due then
                        let (_, state) = _timers[earliest]

                        _timers.remove_at(earliest)
                        state.complete()
                    fi
                else
                    _inbox!.wait(milliseconds)
                fi

                _take_from_inbox()
            fi

            let turns mut = _ready.count

            while turns > 0 do
                _ready.dequeue()()
                turns = turns - 1
            od
        si

        /// Runs queued work, and completes delays as they fall due, until
        /// `state` completes. While another thread still owes this one
        /// work, waits for it rather than throwing. Throws where nothing
        /// could ever complete `state`.
        ///
        /// - state: what to wait for
        run_until(state: TASK_STATE) static is
            _here._run_until(state)
        si

        _run_until(state: TASK_STATE) is
            while !state.is_completed do
                if _ready.count > 0 then
                    let work = _ready.dequeue()

                    work()
                elif _take_from_inbox() then
                elif _waits_on_another_thread() then
                    _wait_for_another_thread()
                elif _timers.count > 0 then
                    _complete_earliest_timer()
                else
                    throw Ghul.InvalidOperationException("a task was waited for that nothing can complete")
                fi
            od
        si

        @IF.llvm()
        _take_from_inbox() -> bool => _inbox?.take(_ready) ?? false

        // Whether another thread owes this one work and could still hand
        // it over. A started thread always has the program's main thread
        // beside it; the main thread waits only while a started thread is
        // still running.
        @IF.llvm()
        _waits_on_another_thread() -> bool =>
            (_inbox?.is_waiting ?? false) /\
            (Ghul.Internal.THREAD_LOCALS.current.is_started_thread \/ Ghul.Internal.LIVE_THREADS.count > 0)

        // Waits for another thread to hand over work, or for the earliest
        // delay to fall due, completing it if it has.
        @IF.llvm()
        _wait_for_another_thread() is
            // A bounded wait, so a thread that ends owing this one nothing
            // more is noticed.
            if _timers.count == 0 then
                _inbox!.wait(LIVE_CHECK_MILLISECONDS)
                return
            fi

            let earliest = _earliest_timer()
            let remaining = _timers[earliest].due - System.Environment.tick_count64

            if remaining > 0L then
                _inbox!.wait(if remaining < LIVE_CHECK_MILLISECONDS then remaining else LIVE_CHECK_MILLISECONDS fi)
            fi

            if System.Environment.tick_count64 >= _timers[earliest].due then
                let (_, state) = _timers[earliest]

                _timers.remove_at(earliest)
                state.complete()
            fi
        si

        @IF.wasm()
        _take_from_inbox() -> bool => false

        @IF.wasm()
        _waits_on_another_thread() -> bool => false

        @IF.wasm()
        _wait_for_another_thread() is si

        _earliest_timer() -> int is
            let earliest mut = 0

            for i in 1.._timers.count do
                if _timers[i].due < _timers[earliest].due then
                    earliest = i
                fi
            od

            return earliest
        si

        _complete_earliest_timer() is
            let earliest = _earliest_timer()

            let (due, state) = _timers[earliest]

            _timers.remove_at(earliest)

            while System.Environment.tick_count64 < due do
            od

            state.complete()
        si
    si
si
