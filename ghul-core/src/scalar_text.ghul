namespace Ghul is
    partial char is
        /// The string holding just this UTF-16 code unit.
        to_string() -> string pure => _string_from_char(self)
    si

    partial int is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial bool is
        /// `True` or `False`, as .NET writes a bool.
        to_string() -> string pure => if self then "True" else "False" fi
    si

    partial byte is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial short is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial word is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial ubyte is
        /// The value in decimal.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial ushort is
        /// The value in decimal.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial uint is
        /// The value in decimal.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial uword is
        /// The value in decimal.
        to_string() -> string pure is
            let wide: ulong = cast ulong(self)

            return wide.to_string()
        si
    si

    partial ulong is
        /// The value in decimal.
        to_string() -> string pure is
            let length = _decimal_length(self)
            let digits = Ghul._array_new[char](length)

            _write_decimal(digits, 0, length, self)

            return _string_from_chars(digits, 0, length)
        si
    si

    partial long is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let length = _decimal_length(self)
            let digits = Ghul._array_new[char](length)

            _write_decimal(digits, 0, length, self)

            return _string_from_chars(digits, 0, length)
        si
    si

    partial double is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string pure => _format_double(self)
    si

    partial single is
        /// The shortest text that reads back as the same value, as .NET
        /// writes it in the invariant culture.
        to_string() -> string pure => _format_single(self)
    si

    // The text of each numeric type under a .NET numeric format string, as
    // .NET writes it in the invariant culture: the standard formats `D`,
    // `E`, `F`, `G`, `N`, `R` and `X` with an optional precision, and custom
    // patterns of `0`, `#`, `.` and `,`.

    partial byte is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(cast long(self), format, 8)
    si

    partial short is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(cast long(self), format, 16)
    si

    partial int is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(cast long(self), format, 32)
    si

    partial long is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(self, format, 64)
    si

    partial word is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_signed_as(cast long(self), format, 64)
    si

    partial ubyte is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_unsigned_as(cast ulong(self), format)
    si

    partial ushort is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_unsigned_as(cast ulong(self), format)
    si

    partial uint is
        /// The value written under the numeric format string `format`.
        ///
