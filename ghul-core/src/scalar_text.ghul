        to_string(format: string) -> string pure => _format_unsigned_as(cast ulong(self), format)
    si

    partial ulong is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_unsigned_as(self, format)
    si

    partial uword is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_unsigned_as(cast ulong(self), format)
    si

    partial double is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_double_as(self, format)
    si

    partial single is
        /// The value written under the numeric format string `format`.
        ///
        /// - format: a standard or custom numeric format string
        to_string(format: string) -> string pure => _format_single_as(self, format)
    si

    // The IEEE 754 bits of `value`.
    @intrinsic("double.bits")
    _double_bits(value: double) -> ulong pure

    // The IEEE 754 bits of `value`.
    @intrinsic("single.bits")
    _single_bits(value: single) -> uint pure
si
