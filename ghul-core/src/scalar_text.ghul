namespace Ghul is
    partial char is
        /// The string holding just this UTF-16 code unit.
        to_string() -> string pure => _string_from_char(self)
    si

    partial int is
        /// The value in decimal, with a leading `-` when it is negative.
        to_string() -> string pure is
            let wide: long = cast long(self)

            return wide.to_string()
        si
    si

    partial bool is
        /// `True` or `False`, as .NET writes a bool.
        to_string() -> string pure => if self then "True" else "False" fi
    si

