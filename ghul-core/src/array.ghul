namespace Ghul is
    // The compiler constructs the array family itself, as a class; the
    // library supplies its members. A member marked `@intrinsic` lowers to
    // the operation it names wherever the receiver is known to be an
    // array, its own body included, so each body below is that operation.
    // The body is what a call reaching the member through a trait runs.
    partial ARRAY is
        /// The number of elements.
        @intrinsic("array.count")
        count: int => count;

        /// The element at `index`, counting from zero.
        @intrinsic("array.get")
        [index: int]: E => self[index];

        /// An iterator over the elements, in order.
        iterator: Collections.Iterator[E] => ARRAY_ITERATOR[E](self);
    si

    /// Iterates the elements of an array in order.
    class ARRAY_ITERATOR[E]: Collections.Iterator[E] is
        _array: ARRAY[E];
        _index: int;

        /// An iterator positioned before the first element of `array`.
        ///
        /// - array: the array to iterate
        init(array: ARRAY[E]) is
            _array = array;
            _index = -1;
        si

        /// Moves to the next element, answering whether there is one.
        move_next() -> bool is
            _index = _index + 1;

            return _index < _array.count;
        si

        /// The element the iterator is positioned at.
        current: E => _array[_index];

        /// Releases nothing: an array holds no resource.
        dispose() is si
    si

    // Allocates an array of `count` elements, each the default of `E`.
    @intrinsic("array.new")
    _array_new[E](count: int) -> ARRAY[E] pure

    // Stores `value` at `index` in `array`.
    @intrinsic("array.set")
    _array_set[E](array: ARRAY[E], index: int, value: E)

    // The number of elements to grow a backing array to, when it holds
    // `current` and must hold at least `needed`: about double. Past a small
    // size it is one of 2^k - 32, whatever an element's size, so that an
    // array with its header fits a power-of-two block of the collector with
    // the byte the collector adds to every allocation to spare. A request of
    // exactly a power of two would take a block twice its size.
    _grown_capacity(current: int, needed: int) -> int pure is
        let doubled = if current < 4 then 4 else current * 2 fi
        let target = if doubled < needed then needed else doubled fi

        if target < 128 then
            return target
        fi

        let power mut = 256

        while power - 32 < target do
            power = power * 2
        od

        return power - 32
    si
si
