namespace Ghul.Reflection is
    use Ghul.Type

    /// Which members `Type.get_fields` and `Type.get_properties` report.
    @Ghul.Flags()
    enum BindingFlags is
        DEFAULT = 0,
        DECLARED_ONLY = 2,
        INSTANCE = 4,
        STATIC = 8,
        PUBLIC = 16,
        NON_PUBLIC = 32
    si

    /// The compiled program, as far as reflection reaches it: the types
    /// that hold its tests.
    @suppress("non-upper-snake-case-name")
    class Assembly is
        _entry: Assembly? static

        init() is si

        /// The program being run.
        get_entry_assembly() -> Assembly static is
            if let entry = _entry then
                return entry
            fi

            let entry = Assembly()

            _entry = entry

            return entry
        si

        /// The types reflection lists for the program: each class of its
        /// own that declares a method marked `@test()`, and a `$globals`
        /// type for each namespace whose global functions include one,
        /// holding those as static methods. Throws `NotSupportedException`
        /// where the program was built without descriptions of its types.
        get_types() -> ARRAY[Type] => Ghul.Internal.TYPE_DESCRIPTIONS.roots()
    si

    /// A field a type declares.
    @suppress("non-upper-snake-case-name")
    class FieldInfo is
        _get: (object) -> object?
        _set: (object, object?) -> void

        /// The field's name, as the type declares it.
        name: string

        /// The type the field holds.
        field_type: Type

        /// The type that declares the field.
        declaring_type: Type

        /// Whether the field is public.
        is_public: bool

        /// Whether the field belongs to the type rather than to an instance.
        is_static: bool

        /// Whether the field can be written only by a constructor; never, as
        /// ghūl declares no such fields.
        is_init_only: bool => false

        /// - name: the field's name
        /// - field_type: the type it holds
        /// - declaring_type: the type that declares it
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - get: reads it from an instance
        /// - set: writes it in an instance
        init(name: string, field_type: Type, declaring_type: Type, is_public: bool, is_static: bool, get: (object) -> object?, set: (object, object?) -> void) is
            self.name = name
            self.field_type = field_type
            self.declaring_type = declaring_type
            self.is_public = is_public
            self.is_static = is_static

            _get = get
            _set = set
        si

        /// The field's value in `instance`, whatever its access.
        ///
        /// - instance: the object to read
        get_value(instance: object?) -> object? => _get(instance!)

        /// Writes `value` into the field in `instance`, whatever its access.
        ///
        /// - instance: the object to write
        /// - value: the value to store, of the field's type
        set_value(instance: object?, value: object?) => _set(instance!, value)
    si

    /// Thrown where a lookup by name finds more than one member, such as
    /// `Type.get_method` on a name the type overloads.
    @suppress("non-upper-snake-case-name")
    class AmbiguousMatchException: Ghul.Exception is
        /// - message: what was looked for
        init(message: string) is
            super.init(message)
        si
    si

    /// A parameter of a constructor or a method.
    @suppress("non-upper-snake-case-name")
    class ParameterInfo is
        /// The parameter's name, which .NET allows to be absent.
        name: string?

        /// The type the parameter takes.
        parameter_type: Type

        /// The parameter's position, counting from zero.
        position: int

        /// - name: the parameter's name
        /// - parameter_type: the type it takes
        /// - position: its position, counting from zero
        init(name: string, parameter_type: Type, position: int) is
            self.name = name
            self.parameter_type = parameter_type
            self.position = position
        si
    si

    /// A constructor a type declares.
    @suppress("non-upper-snake-case-name")
    class ConstructorInfo is
        _parameters: ARRAY[ParameterInfo]
        _invoke: (ARRAY[object?]) -> object

        /// The type the constructor makes.
        declaring_type: Type

        /// Whether the constructor is public.
        is_public: bool

        /// - declaring_type: the type it makes
        /// - is_public: whether it is public
        /// - parameters: its parameters, in order
        /// - invoke: makes an instance from arguments, in order
        init(declaring_type: Type, is_public: bool, parameters: ARRAY[ParameterInfo], invoke: (ARRAY[object?]) -> object) is
            self.declaring_type = declaring_type
            self.is_public = is_public

            _parameters = parameters
            _invoke = invoke
        si

        /// The constructor's name, as .NET names every constructor.
        name: string => ".ctor"

        /// The constructor's parameters, in order.
        get_parameters() -> ARRAY[ParameterInfo] => _parameters

        /// A new instance, made by the constructor from `arguments`.
        ///
        /// - arguments: one argument for each parameter, in order
        invoke(arguments: ARRAY[object?]) -> object => _invoke(arguments)
    si

    /// A method, as far as reflection reaches one: a property's accessor,
    /// a method or global function marked `@test()`, or a method a type
    /// declares that has no type parameters of its own.
    @suppress("non-upper-snake-case-name")
    class MethodInfo is
        _invoke: (object?, ARRAY[object?]) -> object?
        _attributes: ARRAY[object]
        _parameters: ARRAY[ParameterInfo]

        /// The type that declares the method, or null where none is
        /// recorded.
        declaring_type: Type?

        /// The method's name.
        name: string

        /// The type the method returns, `void` included.
        return_type: Type

        /// Whether the method is public.
        is_public: bool

        /// Whether the method belongs to the type rather than to an instance.
        is_static: bool

        /// - name: the method's name
        /// - return_type: the type it returns
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - invoke: calls it on an instance with arguments
        init(name: string, return_type: Type, is_public: bool, is_static: bool, invoke: (object, ARRAY[object?]) -> object?) is
            self.name = name
            self.return_type = return_type
            self.is_public = is_public
            self.is_static = is_static

            _invoke = (receiver: object?, given: ARRAY[object?]) -> object? => invoke(receiver!, given)
            _attributes = []
            _parameters = []
        si

        /// A method `declaring_type` declares.
        ///
        /// - name: the method's name
        /// - return_type: the type it returns, `void` included
        /// - declaring_type: the type that declares it
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - parameters: its parameters, in order
        /// - invoke: calls it on an instance, or with null where it is
        ///   static, with arguments, and returns what it returns, or null
        init(name: string, return_type: Type, declaring_type: Type?, is_public: bool, is_static: bool, parameters: ARRAY[ParameterInfo], invoke: (object?, ARRAY[object?]) -> object?) is
            self.init(name, return_type, declaring_type, is_public, is_static, parameters, [], invoke)
        si

        /// A method `declaring_type` declares, carrying `attributes`.
        ///
        /// - name: the method's name
        /// - return_type: the type it returns, `void` included
        /// - declaring_type: the type that declares it, or null where none
        ///   is recorded
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - parameters: its parameters, in order
        /// - attributes: the attributes it carries
        /// - invoke: calls it on an instance, or with null where it is
        ///   static, with arguments, and returns what it returns, or null
        init(name: string, return_type: Type, declaring_type: Type?, is_public: bool, is_static: bool, parameters: ARRAY[ParameterInfo], attributes: ARRAY[object], invoke: (object?, ARRAY[object?]) -> object?) is
            self.name = name
            self.return_type = return_type
            self.declaring_type = declaring_type
            self.is_public = is_public
            self.is_static = is_static

            _invoke = invoke
            _attributes = attributes
            _parameters = parameters
        si

        /// A method that takes no arguments and returns nothing.
        ///
        /// - name: the method's name
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - attributes: the attributes it carries
        /// - call: calls it on an instance, or with null where it is static
        init(name: string, is_public: bool, is_static: bool, attributes: ARRAY[object], call: (object?) -> void) is
            self.name = name
            self.return_type = Type("System.Void")
            self.is_public = is_public
            self.is_static = is_static

            _invoke = (receiver: object?, given: ARRAY[object?]) -> object? is
                call(receiver)
                return null
            si

            _attributes = attributes
            _parameters = []
        si

        /// The method's parameters, in order.
        get_parameters() -> ARRAY[ParameterInfo] => _parameters

        /// Calls the method on `instance` with `arguments`, and returns
        /// what it returns, or null for a method that returns nothing.
        ///
        /// - instance: the receiver, or null for a static method
        /// - arguments: the arguments, in order
        invoke(instance: object?, arguments: ARRAY[object?]) -> object? => _invoke(instance, arguments)

        /// The attributes of `attribute_type` the method carries.
        ///
        /// - attribute_type: the attribute type to look for
        /// - inherit: whether to look on the methods it overrides too; a
        ///   described method carries its own attributes only
        get_custom_attributes(attribute_type: Type, inherit: bool) -> ARRAY[object] is
            let result = Collections.LIST[object]()

            for attribute in _attributes do
                if attribute.get_type() == attribute_type then
                    result.add(attribute)
                fi
            od

            return result.to_array()
        si

        /// Every attribute the method carries.
        ///
        /// - inherit: whether to look on the methods it overrides too
        get_custom_attributes(inherit: bool) -> ARRAY[object] => _attributes

        /// Whether the method carries an attribute of `attribute_type`.
        ///
        /// - attribute_type: the attribute type to look for
        /// - inherit: whether to look on the methods it overrides too
        is_defined(attribute_type: Type, inherit: bool) -> bool =>
            get_custom_attributes(attribute_type, inherit).count > 0
    si

    /// A property a type declares.
    @suppress("non-upper-snake-case-name")
    class PropertyInfo is
        _getter: MethodInfo?
        _setter: MethodInfo?

        /// The property's name, as the type declares it.
        name: string

        /// The type the property holds.
        property_type: Type

        /// The type that declares the property.
        declaring_type: Type

        /// Whether the property is public.
        is_public: bool

        /// Whether the property belongs to the type rather than to an
        /// instance.
        is_static: bool

        /// - name: the property's name
        /// - property_type: the type it holds
        /// - declaring_type: the type that declares it
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - getter: its read accessor, or null where it has none
        /// - setter: its assign accessor, or null where it has none
        init(name: string, property_type: Type, declaring_type: Type, is_public: bool, is_static: bool, getter: MethodInfo?, setter: MethodInfo?) is
            self.name = name
            self.property_type = property_type
            self.declaring_type = declaring_type
            self.is_public = is_public
            self.is_static = is_static

            _getter = getter
            _setter = setter
        si

        /// The parameters of an indexer; none, as reflection does not
        /// describe indexers.
        get_index_parameters() -> ARRAY[ParameterInfo] => []

        /// Whether the property has a read accessor.
        can_read: bool => _getter?

        /// Whether the property has an assign accessor.
        can_write: bool => _setter?

        /// The read accessor, or null where it has none or it is not public
        /// and `non_public` is false.
        ///
        /// - non_public: whether to return a non-public accessor
        get_get_method(non_public: bool) -> MethodInfo? =>
            if let getter = _getter /\ (non_public \/ getter.is_public) then getter else null fi

        /// The public read accessor, or null where it has none.
        get_get_method() -> MethodInfo? => get_get_method(false)

        /// The assign accessor, or null where it has none or it is not
        /// public and `non_public` is false.
        ///
        /// - non_public: whether to return a non-public accessor
        get_set_method(non_public: bool) -> MethodInfo? =>
            if let setter = _setter /\ (non_public \/ setter.is_public) then setter else null fi

        /// The public assign accessor, or null where it has none.
        get_set_method() -> MethodInfo? => get_set_method(false)

        /// The property's value in `instance`, read through its accessor.
        ///
        /// - instance: the object to read
        get_value(instance: object?) -> object? =>
            if let getter = _getter then
                getter.invoke(instance, [])
            else
                throw Ghul.ArgumentException("property {name} has no read accessor")
            fi

        /// Assigns `value` to the property in `instance` through its
        /// accessor.
        ///
        /// - instance: the object to write
        /// - value: the value to assign, of the property's type
        set_value(instance: object?, value: object?) is
            if let setter = _setter then
                setter.invoke(instance, [value])
            else
                throw Ghul.ArgumentException("property {name} has no assign accessor")
            fi
        si
    si
si

namespace Ghul.Reflection is
    use Ghul.Type
    use Ghul.Internal.TYPE_DESCRIPTIONS

    /// Makes objects of a type known only at run time.
    class Activator is
        /// A new instance of `type`, made by its parameterless constructor.
        ///
        /// - type: the type to make
        create_instance(type: Type) -> object? static => create_instance(type, [])

        /// A new instance of `type`, made by its constructor that takes as
        /// many arguments as `arguments` holds.
        ///
        /// - type: the type to make
        /// - arguments: the constructor's arguments, in order
        create_instance(type: Type, arguments: ARRAY[object?]) -> object? static is
            for constructor in TYPE_DESCRIPTIONS.of(type).constructors do
                if constructor.get_parameters().count == arguments.count then
                    return constructor.invoke(arguments)
                fi
            od

            throw Ghul.InvalidOperationException("{type.full_name} has no constructor taking {arguments.count} arguments")
        si
    si
si

namespace System is
    use Ghul.Type
    use Ghul.Internal.TYPE_DESCRIPTIONS

    /// The base of the classes a declaration carries as attributes.
    class Attribute abstract open is
        init() is si
    si

    /// Reflection over enums.
    class Enum is
        /// The value of the enum `T` that `value` names: a member's name,
        /// several names separated by commas, whose values are combined, or
        /// a number. Throws where it names none. The compiler supplies `T`'s
        /// members where it knows `T` at the call; called where `T` is a
        /// type parameter, it throws.
        ///
        /// - value: the text to read
        parse[T: struct](value: string) -> T static => throw _not_lowered()

        /// The value of the enum `T` that `value` names, matching names
        /// whatever their case where `ignore_case` is true.
        ///
        /// - value: the text to read
        /// - ignore_case: whether a name matches whatever its case
        parse[T: struct](value: string, ignore_case: bool) -> T static => throw _not_lowered()

        /// Whether `value` names a value of the enum `T`, writing it to
        /// `result` where it does and zero where it does not.
        ///
        /// - value: the text to read, or null
        /// - result: where the value is written
        try_parse[T: struct](value: string?, result: T ref) -> bool static => throw _not_lowered()

        /// Whether `value` names a value of the enum `T`, matching names
        /// whatever their case where `ignore_case` is true.
        ///
        /// - value: the text to read, or null
        /// - ignore_case: whether a name matches whatever its case
        /// - result: where the value is written
        try_parse[T: struct](value: string?, ignore_case: bool, result: T ref) -> bool static => throw _not_lowered()

        _not_lowered() -> Ghul.NotSupportedException static =>
            Ghul.NotSupportedException("Enum.parse and Enum.try_parse need the enum to be known where they are called")

        /// The names of `enum_type`'s members, in ascending order of value.
        ///
        /// - enum_type: the enum
        get_names(enum_type: Type) -> ARRAY[string] static => TYPE_DESCRIPTIONS.of(enum_type).enum_names.to_array()

        /// `enum_type`'s members, each as a value of the enum, in ascending
        /// order.
        ///
        /// - enum_type: the enum
        get_values(enum_type: Type) -> ARRAY[object] static => TYPE_DESCRIPTIONS.of(enum_type).enum_values.to_array()

        /// The name of the member of `enum_type` that `value` is, or null
        /// where it is none of them.
        ///
        /// - enum_type: the enum
        /// - value: a value of the enum
        get_name(enum_type: Type, value: object) -> string? static is
            let text = value.to_string()

            for name in TYPE_DESCRIPTIONS.of(enum_type).enum_names do
                if name =~ text then
                    return name
                fi
            od

            return null
        si

        /// The member of `enum_type` whose underlying value is `value`.
        ///
        /// - enum_type: the enum
        /// - value: the underlying value
        to_object(enum_type: Type, value: long) -> object static is
            let description = TYPE_DESCRIPTIONS.of(enum_type)

            for i in 0..description.enum_numbers.count do
                if description.enum_numbers[i] == value then
                    return description.enum_values[i]
                fi
            od

            throw Ghul.ArgumentException("{value} is not a member of {enum_type.full_name}")
        si

        /// The member of `enum_type` named `name`.
        ///
        /// - enum_type: the enum
        /// - value: the member's name
        parse(enum_type: Type, value: string) -> object static is
            let description = TYPE_DESCRIPTIONS.of(enum_type)

            for i in 0..description.enum_names.count do
                if description.enum_names[i] =~ value then
                    return description.enum_values[i]
                fi
            od

            throw Ghul.ArgumentException("{value} is not a member of {enum_type.full_name}")
        si
    si

    /// Reflection over `Nullable[T]`, the optional of a value type.
    class Nullable is
        /// `T` where `type` is the optional of the value type `T`, and null
        /// for any other type.
        ///
        /// - type: the type to look at
        get_underlying_type(type: Type) -> Type? static => TYPE_DESCRIPTIONS.of(type).nullable_underlying
    si
si

namespace Ghul.Internal is
    use Collections.LIST
    use Collections.MAP

    use Ghul.Type

    use Ghul.Reflection.FieldInfo
    use Ghul.Reflection.MethodInfo
    use Ghul.Reflection.ConstructorInfo
    use Ghul.Reflection.ParameterInfo
    use Ghul.Reflection.PropertyInfo

    /// The description of each type the program reflects on, kept apart from
    /// the type object so that nothing public reaches it.
    class TYPE_DESCRIPTIONS is
        _describers: MAP[Type, (TYPE_DESCRIPTION) -> void] static
        _descriptions: MAP[Type, TYPE_DESCRIPTION] static

        init() static is
            _describers = MAP[Type, (TYPE_DESCRIPTION) -> void]()
            _descriptions = MAP[Type, TYPE_DESCRIPTION]()
        si

        /// Records how to describe `type`, done the first time it is asked
        /// for.
        ///
        /// - type: the type object
        /// - describe: fills in its description
        register(type: Type, describe: (TYPE_DESCRIPTION) -> void) static is
            _describers[type] = describe
        si

        /// The type registered under the full name `name`, or null.
        ///
        /// - name: the type's full name
        registered(name: string) -> Type? static is
            for type in _describers.keys do
                if type.full_name =~ name then
                    return type
                fi
            od

            return null
        si

        /// What reflection knows about `type`. Throws `NotSupportedException`
        /// where the program was built without descriptions of its types.
        ///
        /// - type: the type object
        of(type: Type) -> TYPE_DESCRIPTION static is
            let found: TYPE_DESCRIPTION mut

            if _descriptions.try_get_value(type, found ref) then
                return found
            fi

            let describe: (TYPE_DESCRIPTION) -> void mut

            if let held = type.describer then
                describe = held
            elif !_describers.try_get_value(type, describe ref) then
                throw Ghul.NotSupportedException("reflection over {type.full_name} needs the program built with --rtti, or built with --rtti-roots and {type.name} marked @reflected()")
            fi

            let description = TYPE_DESCRIPTION(type)

            _descriptions[type] = description

            describe(description)

            return description
        si

        _roots: ARRAY[Type]? static

        /// The types `Assembly.get_types` lists: each class of the program's
        /// own that declares a method marked `@test()`, and a type for each
        /// namespace whose global functions include one or are described,
        /// named as .NET names that namespace's `$globals` class. A source library's tests are
        /// not the program's, so none of its types is listed. Throws
        /// `NotSupportedException` where the program was built without
        /// descriptions of its types.
        roots() -> ARRAY[Type] static is
            if let found = _roots then
                return found
            fi

            let roots = ROOT_TYPES()

            _add_roots(roots)

            let result = roots.types()

            _roots = result

            return result
        si

        // The compiler gives this its body where the program describes its
        // types: a call on `roots` for each class and global function that
        // the listing takes in.
        _add_roots(roots: ROOT_TYPES) static is
            throw Ghul.NotSupportedException("listing the program's types needs the program built with --rtti or --rtti-roots")
        si
    si

    /// Collects the types `TYPE_DESCRIPTIONS.roots` lists, from the calls
    /// the compiler makes on it.
    class ROOT_TYPES is
        _types: LIST[Type]
        _namespaces: LIST[string]
        _globals: MAP[string, LIST[(TYPE_DESCRIPTION) -> void]]
        _parameters: LIST[ParameterInfo]

        init() is
            _types = LIST[Type]()
            _namespaces = LIST[string]()
            _globals = MAP[string, LIST[(TYPE_DESCRIPTION) -> void]]()
            _parameters = LIST[ParameterInfo]()
        si

        _type(type: Type) is
            _types.add(type)
        si

        _global_test(`namespace: string, name: string, is_public: bool, call: () -> void) is
            _add_global(`namespace, (description: TYPE_DESCRIPTION) -> void =>
                description.add_test_method(name, is_public, true, (instance: object?) -> void => call()))
        si

        _parameter[T](name: string) is
            _parameters.add(ParameterInfo(name, typeof T, _parameters.count))
        si

        // A global function of `namespace`, after a `_parameter` call for
        // each of its parameters: `_global_function_N` for one taking N
        // arguments that returns `R`, `_global_action_N` for one that
        // returns nothing.
        _global_function_0[R](`namespace: string, name: string, is_public: bool, call: () -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 0 else "{name} takes 0 arguments, not {given.count}" in
                cast object(call()))
        si

        _global_action_0(`namespace: string, name: string, is_public: bool, call: () -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 0 else "{name} takes 0 arguments, not {given.count}"
                call()
                return null
            si)
        si

        _global_function_1[A0, R](`namespace: string, name: string, is_public: bool, call: (A0) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 1 else "{name} takes 1 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]))))
        si

        _global_action_1[A0](`namespace: string, name: string, is_public: bool, call: (A0) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 1 else "{name} takes 1 arguments, not {given.count}"
                call(cast A0(given[0]))
                return null
            si)
        si

        _global_function_2[A0, A1, R](`namespace: string, name: string, is_public: bool, call: (A0, A1) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 2 else "{name} takes 2 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]), cast A1(given[1]))))
        si

        _global_action_2[A0, A1](`namespace: string, name: string, is_public: bool, call: (A0, A1) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 2 else "{name} takes 2 arguments, not {given.count}"
                call(cast A0(given[0]), cast A1(given[1]))
                return null
            si)
        si

        _global_function_3[A0, A1, A2, R](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 3 else "{name} takes 3 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]))))
        si

        _global_action_3[A0, A1, A2](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 3 else "{name} takes 3 arguments, not {given.count}"
                call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]))
                return null
            si)
        si

        _global_function_4[A0, A1, A2, A3, R](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 4 else "{name} takes 4 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]))))
        si

        _global_action_4[A0, A1, A2, A3](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 4 else "{name} takes 4 arguments, not {given.count}"
                call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]))
                return null
            si)
        si

        _global_function_5[A0, A1, A2, A3, A4, R](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3, A4) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 5 else "{name} takes 5 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]))))
        si

        _global_action_5[A0, A1, A2, A3, A4](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3, A4) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 5 else "{name} takes 5 arguments, not {given.count}"
                call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]))
                return null
            si)
        si

        _global_function_6[A0, A1, A2, A3, A4, A5, R](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3, A4, A5) -> R) is
            _add_global_method(`namespace, name, typeof R, is_public, (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 6 else "{name} takes 6 arguments, not {given.count}" in
                cast object(call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]), cast A5(given[5]))))
        si

        _global_action_6[A0, A1, A2, A3, A4, A5](`namespace: string, name: string, is_public: bool, call: (A0, A1, A2, A3, A4, A5) -> void) is
            _add_global_method(`namespace, name, TYPE_DESCRIPTION.void_type, is_public, (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 6 else "{name} takes 6 arguments, not {given.count}"
                call(cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]), cast A5(given[5]))
                return null
            si)
        si

        _add_global_method(`namespace: string, name: string, return_type: Type, is_public: bool, invoke: (object?, ARRAY[object?]) -> object?) is
            let parameters = _parameters.to_array()

            _parameters.clear()

            _add_global(`namespace, (description: TYPE_DESCRIPTION) -> void =>
                description.add_method(name, return_type, is_public, true, parameters, invoke))
        si

        _add_global(`namespace: string, add: (TYPE_DESCRIPTION) -> void) is
            let adds: LIST[(TYPE_DESCRIPTION) -> void] mut

            if !_globals.try_get_value(`namespace, adds ref) then
                adds = LIST[(TYPE_DESCRIPTION) -> void]()
                _globals[`namespace] = adds
                _namespaces.add(`namespace)
            fi

            adds.add(add)
        si

        /// The types collected, followed by one for each namespace whose
        /// global functions are described, in the order they were first
        /// given.
        types() -> ARRAY[Type] is
            let result = LIST[Type](_types)

            for `namespace in _namespaces do
                let adds = _globals[`namespace]
                let full_name = if `namespace.length > 0 then "{`namespace}.$globals" else "$globals" fi

                result.add(Type(full_name, (description: TYPE_DESCRIPTION) is
                    description.set_kind(TYPE_KIND.CLASS)

                    for add in adds do
                        add(description)
                    od
                si))
            od

            return result.to_array()
        si
    si

    /// What reflection knows about one type, filled in by the description
    /// the compiler generates for it.
    class TYPE_DESCRIPTION is
        _type: Type?

        // What a method that returns nothing returns.
        _VOID: Type static => Type("System.Void")

        /// The type a method that returns nothing reports it returns.
        void_type: Type static => _VOID

        /// The class the type derives from.
        base_type: Type?

        /// The type's kind, as `TYPE_KIND` flags.
        kind: int

        /// The type arguments of a generic type's instantiation.
        arguments: LIST[Type]

        /// The element type of an array type.
        element_type: Type?

        /// The traits the type implements.
        interfaces: LIST[Type]

        /// The fields the type itself declares.
        fields: LIST[FieldInfo]

        /// The properties the type itself declares.
        properties: LIST[PropertyInfo]

        /// The attributes the type carries.
        attributes: LIST[object]

        /// The constructors the type declares.
        constructors: LIST[ConstructorInfo]

        /// The methods the type declares: those marked `@test()`, and, where
        /// the compiler describes them, the others that have no type
        /// parameters of their own.
        methods: LIST[MethodInfo]

        _parameters: LIST[ParameterInfo]
        _attribute_types: LIST[Type]

        /// An enum's member names, in ascending order of value.
        enum_names: LIST[string]

        /// An enum's members, each as a value of the enum, in the same order.
        enum_values: LIST[object]

        /// An enum's members' underlying values, in the same order.
        enum_numbers: LIST[long]

        /// `T` where the type is `Nullable[T]`.
        nullable_underlying: Type?

        /// `T` where the type is `MAYBE[T]`.
        maybe_underlying: Type?

        /// An empty description of `type`.
        ///
        /// - type: the type described
        init(type: Type) is
            _type = type
            arguments = LIST[Type]()
            interfaces = LIST[Type]()
            fields = LIST[FieldInfo]()
            properties = LIST[PropertyInfo]()
            attributes = LIST[object]()
            constructors = LIST[ConstructorInfo]()
            methods = LIST[MethodInfo]()
            enum_names = LIST[string]()
            enum_values = LIST[object]()
            enum_numbers = LIST[long]()
            _parameters = LIST[ParameterInfo]()
            _attribute_types = LIST[Type]()
        si

        is_class: bool => kind & TYPE_KIND.CLASS != 0
        is_value_type: bool => kind & TYPE_KIND.VALUE_TYPE != 0
        is_enum: bool => kind & TYPE_KIND.ENUM != 0
        is_interface: bool => kind & TYPE_KIND.INTERFACE != 0
        is_array: bool => kind & TYPE_KIND.ARRAY != 0

        _kind(kind: int) is
            self.kind = kind
        si

        _base[T]() is
            base_type = typeof T
        si

        _argument[T]() is
            arguments.add(typeof T)
        si

        _element[T]() is
            element_type = typeof T
        si

        _interface[T]() is
            interfaces.add(typeof T)
        si

        _nullable_of[T]() is
            nullable_underlying = typeof T
        si

        _maybe_of[T]() is
            maybe_underlying = typeof T
        si

        _attribute_type[T]() is
            _attribute_types.add(typeof T)
        si

        _attribute(make: (ARRAY[object?]) -> object) is
            let arguments: ARRAY[object?] =
                if _attribute_types.count == 0 then [] else [cast object(_attribute_types.to_array())] fi

            attributes.add(make(arguments))
            _attribute_types.clear()
        si

        _enum_member[T](name: string, value: T, number: long) is
            enum_names.add(name)
            enum_values.add(cast object(value))
            enum_numbers.add(number)
        si

        _parameter[T](name: string) is
            _parameters.add(ParameterInfo(name, typeof T, _parameters.count))
        si

        _test_method(name: string, is_public: bool, is_static: bool, invoke: (object?) -> void) is
            add_test_method(name, is_public, is_static, invoke)
        si

        /// Records the kind of a type described by the library rather than
        /// the compiler.
        ///
        /// - kind: the kind, as `TYPE_KIND` flags
        set_kind(kind: int) is
            self.kind = kind
        si

        /// Records a method marked `@test()`, taking no arguments and
        /// returning nothing.
        ///
        /// - name: the method's name
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - invoke: calls it on an instance, or with null where it is static
        add_test_method(name: string, is_public: bool, is_static: bool, invoke: (object?) -> void) is
            let call = (receiver: object?, given: ARRAY[object?]) -> object? is
                invoke(receiver)
                return null
            si

            methods.add(MethodInfo(name, _VOID, _type, is_public, is_static, [], [cast object(Ghul.TEST_ATTRIBUTE())], call))
        si

        // A method the type declares, after a `_parameter` call for each of
        // its parameters: `_method_N` for one taking N arguments that
        // returns `R`, `_action_N` for one that returns nothing. `call`
        // takes the receiver, or null where the method is static, then the
        // arguments.
        _method_0[R](name: string, is_public: bool, is_static: bool, call: (object?) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 0 else "{name} takes 0 arguments, not {given.count}" in
                cast object(call(receiver)))
        si

        _action_0(name: string, is_public: bool, is_static: bool, call: (object?) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 0 else "{name} takes 0 arguments, not {given.count}"
                call(receiver)
                return null
            si)
        si

        _method_1[A0, R](name: string, is_public: bool, is_static: bool, call: (object?, A0) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 1 else "{name} takes 1 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]))))
        si

        _action_1[A0](name: string, is_public: bool, is_static: bool, call: (object?, A0) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 1 else "{name} takes 1 arguments, not {given.count}"
                call(receiver, cast A0(given[0]))
                return null
            si)
        si

        _method_2[A0, A1, R](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 2 else "{name} takes 2 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]), cast A1(given[1]))))
        si

        _action_2[A0, A1](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 2 else "{name} takes 2 arguments, not {given.count}"
                call(receiver, cast A0(given[0]), cast A1(given[1]))
                return null
            si)
        si

        _method_3[A0, A1, A2, R](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 3 else "{name} takes 3 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]))))
        si

        _action_3[A0, A1, A2](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 3 else "{name} takes 3 arguments, not {given.count}"
                call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]))
                return null
            si)
        si

        _method_4[A0, A1, A2, A3, R](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 4 else "{name} takes 4 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]))))
        si

        _action_4[A0, A1, A2, A3](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 4 else "{name} takes 4 arguments, not {given.count}"
                call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]))
                return null
            si)
        si

        _method_5[A0, A1, A2, A3, A4, R](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3, A4) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 5 else "{name} takes 5 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]))))
        si

        _action_5[A0, A1, A2, A3, A4](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3, A4) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 5 else "{name} takes 5 arguments, not {given.count}"
                call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]))
                return null
            si)
        si

        _method_6[A0, A1, A2, A3, A4, A5, R](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3, A4, A5) -> R) is
            add_method(name, typeof R, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? =>
                assert given.count == 6 else "{name} takes 6 arguments, not {given.count}" in
                cast object(call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]), cast A5(given[5]))))
        si

        _action_6[A0, A1, A2, A3, A4, A5](name: string, is_public: bool, is_static: bool, call: (object?, A0, A1, A2, A3, A4, A5) -> void) is
            add_method(name, _VOID, is_public, is_static, _take_parameters(), (receiver: object?, given: ARRAY[object?]) -> object? is
                assert given.count == 6 else "{name} takes 6 arguments, not {given.count}"
                call(receiver, cast A0(given[0]), cast A1(given[1]), cast A2(given[2]), cast A3(given[3]), cast A4(given[4]), cast A5(given[5]))
                return null
            si)
        si

        // The parameters the `_parameter` calls since the last method
        // recorded.
        _take_parameters() -> ARRAY[ParameterInfo] is
            let result = _parameters.to_array()

            _parameters.clear()

            return result
        si

        /// Records a method the type declares.
        ///
        /// - name: the method's name
        /// - return_type: the type it returns, `void_type` where it returns nothing
        /// - is_public: whether it is public
        /// - is_static: whether it belongs to the type rather than to an instance
        /// - parameters: its parameters, in order
        /// - invoke: calls it on an instance, or with null where it is
        ///   static, with arguments, and returns what it returns, or null
        add_method(name: string, return_type: Type, is_public: bool, is_static: bool, parameters: ARRAY[ParameterInfo], invoke: (object?, ARRAY[object?]) -> object?) is
            methods.add(MethodInfo(name, return_type, _type, is_public, is_static, parameters, invoke))
        si

        _constructor(make: (ARRAY[object?]) -> object, is_public: bool) is
            constructors.add(ConstructorInfo(_type!, is_public, _parameters.to_array(), make))
            _parameters.clear()
        si

        // The compiler describes instance members only, which a function
        // value can read and write given the instance.
        _field[T](name: string, is_public: bool, get: (object) -> T, set: (object, T) -> void) is
            fields.add(
                FieldInfo(
                    name,
                    typeof T,
                    _type!,
                    is_public,
                    false,
                    (instance: object) -> object? => get(instance),
                    (instance: object, value: object?) -> void => set(instance, cast T(value))))
        si

        _property[T](name: string, get: ((object) -> T)?, get_is_public: bool, set: ((object, T) -> void)?, set_is_public: bool) is
            let property_type = typeof T

            let getter: MethodInfo? =
                if let read = get then
                    MethodInfo("get_{name}", property_type, get_is_public, false, (instance: object, arguments: ARRAY[object?]) -> object? => read(instance))
                else
                    null
                fi

            let setter: MethodInfo? =
                if let assign = set then
                    MethodInfo("set_{name}", _VOID, set_is_public, false, (instance: object, arguments: ARRAY[object?]) -> object? is
                        assign(instance, cast T(arguments[0]))
                        return null
                    si)
                else
                    null
                fi

            properties.add(PropertyInfo(name, property_type, _type!, (get? /\ get_is_public) \/ (set? /\ set_is_public), false, getter, setter))
        si
    si

    /// The kinds a `TYPE_DESCRIPTION` records.
    class TYPE_KIND is
        CLASS: int static => 1
        VALUE_TYPE: int static => 2
        ENUM: int static => 4
        INTERFACE: int static => 8
        ARRAY: int static => 16
    si
si

namespace Ghul.Reflection is
    use Ghul.Type

    /// The type named `name`, qualified by its namespace, among the types
    /// reflection describes, or null if there is none. An
    /// assembly-qualified name is accepted: what follows the type's name
    /// is ignored.
    ///
    /// - name: the type's full name
    get_type(name: string) -> Type? => Type.get_type(name)

    /// The global function named `name`, qualified by its namespace as the
    /// source names it, such as `Ghul.Math.sqrt`, or null if reflection
    /// describes none. Throws `AmbiguousMatchException` where the namespace
    /// has more than one function of that name.
    ///
    /// - name: the function's name, qualified by its namespace
    get_function(name: string) -> MethodInfo? =>
        _globals_of(name)?.get_method(_function_name(name))

    /// The global function named `name`, qualified by its namespace as the
    /// source names it, whose parameters are exactly `types`, in order, or
    /// null if reflection describes none.
    ///
    /// - name: the function's name, qualified by its namespace
    /// - types: the type of each parameter, in order
    get_function(name: string, types: ARRAY[Type]) -> MethodInfo? =>
        _globals_of(name)?.get_method(_function_name(name), types)

    _globals_of(name: string) -> Type? is
        let dot = name.last_index_of('.')

        return
            if dot < 0 then
                Type.get_type("$globals")
            else
                Type.get_type("{name.substring(0, dot)}.$globals")
            fi
    si

    _function_name(name: string) -> string => name.substring(name.last_index_of('.') + 1)
si
