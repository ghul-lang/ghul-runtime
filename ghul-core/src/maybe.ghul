namespace Ghul is
    /// Implemented by a type that is optional-shaped: it either holds a `T` or is absent.
    trait Maybe[T] open is
        /// Whether a value is present.
        has_value: bool
        /// The value, when present.
        value: T
    si

    /// The optional representation ghūl uses for `T?` when `T` is an unconstrained type parameter.
    struct MAYBE[T]: Maybe[T] is
        _has_value: bool
        _value: T

        /// Whether a value is present.
        has_value: bool pure => _has_value

        /// The value; throws if none is present.
        value: T pure =>
            if _has_value then
                _value
            else
                throw InvalidOperationException("maybe has no value")
            fi

        /// Two `MAYBE` values are equal when both are absent, or both hold equal values.
        =~(other: MAYBE[T]) -> bool pure is
            if _has_value != other._has_value then
                return false
            fi

            if !_has_value then
                return true
            fi

            _value =~ other._value
        si

        /// Hashes like `Nullable[T]`: zero when absent, otherwise the value's hash.
        get_hash_code() -> int pure =>
            if _has_value then
                _value.get_hash_code()
            else
                0
            fi

        init() pure is
        si

        /// Creates a `MAYBE` holding `value`.
        init(value: T) pure is
            _has_value = true
            _value = value
        si

        /// `T` for a `MAYBE[T]` type, as `System.Nullable.get_underlying_type`
        /// answers for `Nullable[T]`; null for any other type.
        ///
        /// - type: the type to look at
        underlying_type(type: System.Type) -> System.Type? static => Ghul.Internal.TYPE_DESCRIPTIONS.of(type).maybe_underlying

        /// `value`'s own text when present, otherwise `"none"`.
        to_string() -> string =>
            if _has_value then
                _value.to_string()
            else
                "none"
            fi
    si
si
