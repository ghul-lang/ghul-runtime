namespace Ghul is
    // The compiler constructs the tuple families itself, with type
    // parameters T1 to Tn; the library supplies the elements, which are
    // what `.`0`, `.`1` and so on read, a constructor taking every
    // element, and a hash of the elements to go with the element-wise `=~`
    // the compiler gives tuples.

    partial TUPLE_1 is
        /// The first element.
        `0: T1 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        init(e0: T1) is
            `0 = e0
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)

            return hash
        si
    si

    partial TUPLE_2 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        init(e0: T1, e1: T2) is
            `0 = e0
            `1 = e1
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)

            return hash
        si
    si

    partial TUPLE_3 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// The third element.
        `2: T3 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        /// - e2: the third element
        init(e0: T1, e1: T2, e2: T3) is
            `0 = e0
            `1 = e1
            `2 = e2
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)
            hash = hash * 31 + _hash_of(`2)

            return hash
        si
    si

    partial TUPLE_4 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// The third element.
        `2: T3 field

        /// The fourth element.
        `3: T4 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        /// - e2: the third element
        /// - e3: the fourth element
        init(e0: T1, e1: T2, e2: T3, e3: T4) is
            `0 = e0
            `1 = e1
            `2 = e2
            `3 = e3
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)
            hash = hash * 31 + _hash_of(`2)
            hash = hash * 31 + _hash_of(`3)

            return hash
        si
    si

    partial TUPLE_5 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// The third element.
        `2: T3 field

        /// The fourth element.
        `3: T4 field

        /// The fifth element.
        `4: T5 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        /// - e2: the third element
        /// - e3: the fourth element
        /// - e4: the fifth element
        init(e0: T1, e1: T2, e2: T3, e3: T4, e4: T5) is
            `0 = e0
            `1 = e1
            `2 = e2
            `3 = e3
            `4 = e4
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)
            hash = hash * 31 + _hash_of(`2)
            hash = hash * 31 + _hash_of(`3)
            hash = hash * 31 + _hash_of(`4)

            return hash
        si
    si

    partial TUPLE_6 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// The third element.
        `2: T3 field

        /// The fourth element.
        `3: T4 field

        /// The fifth element.
        `4: T5 field

        /// The sixth element.
        `5: T6 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        /// - e2: the third element
        /// - e3: the fourth element
        /// - e4: the fifth element
        /// - e5: the sixth element
        init(e0: T1, e1: T2, e2: T3, e3: T4, e4: T5, e5: T6) is
            `0 = e0
            `1 = e1
            `2 = e2
            `3 = e3
            `4 = e4
            `5 = e5
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)
            hash = hash * 31 + _hash_of(`2)
            hash = hash * 31 + _hash_of(`3)
            hash = hash * 31 + _hash_of(`4)
            hash = hash * 31 + _hash_of(`5)

            return hash
        si
    si

    partial TUPLE_7 is
        /// The first element.
        `0: T1 field

        /// The second element.
        `1: T2 field

        /// The third element.
        `2: T3 field

        /// The fourth element.
        `3: T4 field

        /// The fifth element.
        `4: T5 field

        /// The sixth element.
        `5: T6 field

        /// The seventh element.
        `6: T7 field

        /// A tuple of the given elements.
        ///
        /// - e0: the first element
        /// - e1: the second element
        /// - e2: the third element
        /// - e3: the fourth element
        /// - e4: the fifth element
        /// - e5: the sixth element
        /// - e6: the seventh element
        init(e0: T1, e1: T2, e2: T3, e3: T4, e4: T5, e5: T6, e6: T7) is
            `0 = e0
            `1 = e1
            `2 = e2
            `3 = e3
            `4 = e4
            `5 = e5
            `6 = e6
        si

        /// A hash of the elements, alike for tuples whose elements are equal.
        get_hash_code() -> int is
            let hash mut = 17

            hash = hash * 31 + _hash_of(`0)
            hash = hash * 31 + _hash_of(`1)
            hash = hash * 31 + _hash_of(`2)
            hash = hash * 31 + _hash_of(`3)
            hash = hash * 31 + _hash_of(`4)
            hash = hash * 31 + _hash_of(`5)
            hash = hash * 31 + _hash_of(`6)

            return hash
        si
    si

    // Tuples order element by element, as .NET's value tuples do, so a
    // tuple can be the key of max_by, min_by and sort_by on every target.
    impl Comparable[TUPLE_1[T1]] for TUPLE_1[T1] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_1[T1]) -> int pure is
            return _compare_of(`0, other.`0)
        si
    si

    impl Comparable[TUPLE_2[T1, T2]] for TUPLE_2[T1, T2] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_2[T1, T2]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            return _compare_of(`1, other.`1)
        si
    si

    impl Comparable[TUPLE_3[T1, T2, T3]] for TUPLE_3[T1, T2, T3] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_3[T1, T2, T3]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            let order1 = _compare_of(`1, other.`1)

            if order1 != 0 then
                return order1
            fi

            return _compare_of(`2, other.`2)
        si
    si

    impl Comparable[TUPLE_4[T1, T2, T3, T4]] for TUPLE_4[T1, T2, T3, T4] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_4[T1, T2, T3, T4]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            let order1 = _compare_of(`1, other.`1)

            if order1 != 0 then
                return order1
            fi

            let order2 = _compare_of(`2, other.`2)

            if order2 != 0 then
                return order2
            fi

            return _compare_of(`3, other.`3)
        si
    si

    impl Comparable[TUPLE_5[T1, T2, T3, T4, T5]] for TUPLE_5[T1, T2, T3, T4, T5] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_5[T1, T2, T3, T4, T5]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            let order1 = _compare_of(`1, other.`1)

            if order1 != 0 then
                return order1
            fi

            let order2 = _compare_of(`2, other.`2)

            if order2 != 0 then
                return order2
            fi

            let order3 = _compare_of(`3, other.`3)

            if order3 != 0 then
                return order3
            fi

            return _compare_of(`4, other.`4)
        si
    si

    impl Comparable[TUPLE_6[T1, T2, T3, T4, T5, T6]] for TUPLE_6[T1, T2, T3, T4, T5, T6] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_6[T1, T2, T3, T4, T5, T6]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            let order1 = _compare_of(`1, other.`1)

            if order1 != 0 then
                return order1
            fi

            let order2 = _compare_of(`2, other.`2)

            if order2 != 0 then
                return order2
            fi

            let order3 = _compare_of(`3, other.`3)

            if order3 != 0 then
                return order3
            fi

            let order4 = _compare_of(`4, other.`4)

            if order4 != 0 then
                return order4
            fi

            return _compare_of(`5, other.`5)
        si
    si

    impl Comparable[TUPLE_7[T1, T2, T3, T4, T5, T6, T7]] for TUPLE_7[T1, T2, T3, T4, T5, T6, T7] is
        /// Orders by the first elements, and by each later pair where all
        /// those before it are equal.
        <>(other: TUPLE_7[T1, T2, T3, T4, T5, T6, T7]) -> int pure is
            let order0 = _compare_of(`0, other.`0)

            if order0 != 0 then
                return order0
            fi

            let order1 = _compare_of(`1, other.`1)

            if order1 != 0 then
                return order1
            fi

            let order2 = _compare_of(`2, other.`2)

            if order2 != 0 then
                return order2
            fi

            let order3 = _compare_of(`3, other.`3)

            if order3 != 0 then
                return order3
            fi

            let order4 = _compare_of(`4, other.`4)

            if order4 != 0 then
                return order4
            fi

            let order5 = _compare_of(`5, other.`5)

            if order5 != 0 then
                return order5
            fi

            return _compare_of(`6, other.`6)
        si
    si

    // How `left` orders against `right`, for an element type the tuple
    // does not constrain. An absent value orders before a present one, and
    // one that isn't comparable throws, as .NET's default comparer does.
    _compare_of[T](left: T, right: T) -> int pure is
        let l = cast object?(left)
        let r = cast object?(right)

        if !l? then
            return if r? then -1 else 0 fi
        fi

        if !r? then
            return 1
        fi

        if let comparable: Comparable[T] = l then
            return comparable <> right
        fi

        throw System.InvalidOperationException("a value of {typeof T} can't be ordered")
    si

    // The hash of `value`, which is zero where it is absent.
    _hash_of[T](value: T) -> int =>
        if (cast object?(value))? then value.get_hash_code() else 0 fi
si
