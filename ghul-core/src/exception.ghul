namespace Ghul is
    /// The base of every exception: what `throw` raises and `catch` handles.
    @suppress("non-upper-snake-case-name")
    class Exception open is
        /// What went wrong, for a person to read.
        message: string;

        _inner_exception: Exception?

        /// The exception this one was thrown because of, or null.
        inner_exception: Exception? => _inner_exception

        /// An exception whose message names its type and says only that it
        /// was thrown.
        init() is
            self.message = "Exception of type '{_type_name(self)}' was thrown.";
        si

        /// - message: what went wrong
        init(message: string) is
            self.message = message;
        si

        /// - message: what went wrong
        /// - inner_exception: the exception this one is thrown because of, or null
        init(message: string, inner_exception: Exception?) is
            self.message = message;
            _inner_exception = inner_exception;
        si

        /// The exception at the end of the chain of inner exceptions: the one
        /// that was thrown first. This exception where it has no inner one.
        get_base_exception() -> Exception is
            let result: Exception mut = self

            while let inner = result.inner_exception do
                result = inner
            od

            return result
        si
    si

    /// Thrown by a member that has no body to run: a body-less override.
    class NotImplementedException: Exception open is
        /// An exception saying the operation is not implemented.
        init() is
            super.init("The method or operation is not implemented.");
        si

        /// - member: the member that has no body
        init(member: string) is
            super.init(member);
        si
    si

    /// Thrown by a member this type does not support, such as the `reset`
    /// synthesised for an iterator that cannot start again.
    class NotSupportedException: Exception open is
        init() is
            super.init("the operation is not supported");
        si

        /// - message: what is not supported
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown when an object is not in a state where the requested operation
    /// can run, such as reading the value of an absent `MAYBE`.
    class InvalidOperationException: Exception open is
        /// - message: why the operation cannot run
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by waiting for a task that threw, holding what it threw.
    class AggregateException: Exception open is
        _inner_exception_count: int

        /// An exception that says only that errors occurred.
        init() is
            super.init("One or more errors occurred.")
        si

        /// - message: what went wrong
        init(message: string) is
            super.init(message)
        si

        /// - inner_exception: what the task threw
        init(inner_exception: Exception) is
            super.init("One or more errors occurred. ({inner_exception.message})", inner_exception)
            _inner_exception_count = 1
        si

        /// - inner_exceptions: what was thrown; the first is `inner_exception`
        init(inner_exceptions: Collections.Iterable[Exception]) is
            super.init(_message("One or more errors occurred.", inner_exceptions), _first(inner_exceptions))
            _inner_exception_count = inner_exceptions |> Ghul.Pipes.count()
        si

        /// - message: what went wrong
        /// - inner_exception: what was thrown
        init(message: string, inner_exception: Exception) is
            super.init("{message} ({inner_exception.message})", inner_exception)
            _inner_exception_count = 1
        si

        /// The exception at the end of the chain, going through each
        /// aggregate that holds exactly one exception, as on .NET: an
        /// aggregate of several is its own base.
        get_base_exception() -> Exception is
            let result: Exception mut = self
            let aggregate: AggregateException? mut = self

            while let a = aggregate /\ a._inner_exception_count == 1 do
                result = a.inner_exception!
                aggregate = cast AggregateException?(result)
            od

            return result
        si

        _first(inner_exceptions: Collections.Iterable[Exception]) -> Exception? static is
            for e in inner_exceptions do
                return e
            od

            return null
        si

        _message(message: string, inner_exceptions: Collections.Iterable[Exception]) -> string static is
            let result = Text.StringBuilder()

            result.append(message)

            for e in inner_exceptions do
                result.append(" (")
                result.append(e.message)
                result.append(")")
            od

            return result.to_string()
        si
    si

    /// Thrown when an object that has been closed or disposed is used. As on
    /// .NET, the message names the object where an object name is given.
    class ObjectDisposedException: InvalidOperationException open is
        /// The name of the object that was used, or empty.
        object_name: string

        /// - object_name: the name of the object that was used, or null
        init(object_name: string?) is
            init(object_name, null)
        si

        /// - object_name: the name of the object that was used, or null
        /// - message: what went wrong, or null for the general message
        init(object_name: string?, message: string?) is
            super.init(_message(object_name, message))
            self.object_name = object_name ?? ""
        si

        _message(object_name: string?, message: string?) -> string static is
            let text = message ?? "Cannot access a disposed object."

            if let name = object_name /\ name.length > 0 then
                return "{text}\nObject name: '{name}'."
            fi

            return text
        si
    si

    /// Thrown when the operation is not allowed on what it names, such as
    /// reading a directory as a file.
    class UnauthorizedAccessException: Exception open is
        /// - message: what was refused
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by an `assert` whose condition is false.
    class AssertFailedException: Exception open is
        /// - message: the assert's own message, or where it is and what it
        ///   tests when it gives none
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by a cast that cannot convert its value to the target type.
    class InvalidCastException: Exception open is
        init() is
            super.init("the cast is not valid");
        si

        /// - message: what could not be converted
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown where a member is reached through a null reference.
    class NullReferenceException: Exception open is
        init() is
            super.init("Object reference not set to an instance of an object.");
        si

        /// - message: what was reached through null
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by an index into an array or a string that is outside it.
    class IndexOutOfRangeException: Exception open is
        init() is
            super.init("Index was outside the bounds of the array.");
        si

        /// - message: which index was outside what
        init(message: string) is
            super.init(message);
        si
    si

    /// The base of the exceptions arithmetic raises.
    class ArithmeticException: Exception open is
        init() is
            super.init("the arithmetic operation failed");
        si

        /// - message: what failed
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by arithmetic or a conversion whose result does not fit its
    /// type.
    class OverflowException: ArithmeticException open is
        init() is
            super.init("Arithmetic operation resulted in an overflow.");
        si

        /// - message: what overflowed
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown by an integer division or remainder whose divisor is zero.
    class DivideByZeroException: ArithmeticException open is
        init() is
            super.init("Attempted to divide by zero.");
        si

        /// - message: what was divided
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown when a format string is not one the formatting member
    /// understands, or text is not in the format a parse expects.
    class FormatException: Exception open is
        init() is
            super.init("the input string was not in a correct format");
        si

        /// - message: what was wrong with the format
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown when an argument is not one a member accepts.
    class ArgumentException: Exception open is
        /// - message: which argument was not accepted
        init(message: string) is
            super.init(message);
        si
    si

    /// Thrown when an index or a count is outside the range a member accepts.
    class ArgumentOutOfRangeException: ArgumentException open is
        /// - message: which argument was out of range
        init(message: string) is
            super.init(message);
        si

        /// - parameter: the name of the argument that was out of range
        /// - message: why it was out of range
        init(parameter: string, message: string) is
            super.init(message);
        si
    si

    /// Thrown when `!` unwraps a union value that holds a non-default variant.
    /// The payload is what the value held instead: the complement variant's
    /// field value when that variant declares exactly one field, otherwise the
    /// whole variant value.
    ///
    /// - T: the type of what the value held instead
    class UnwrapFailedException[T]: Exception open is
        /// What the value held instead of the default variant.
        payload: T;

        /// - payload: what the value held instead
        init(payload: T) is
            self.payload = payload;
            super.init("unwrap failed: the value holds a non-default variant");
        si
    si
si
