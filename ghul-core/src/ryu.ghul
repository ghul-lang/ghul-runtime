namespace Ghul is
    // The shortest decimal digits of a double or a single that parse back to
    // the same value, by Ryū: Ulf Adams, "Ryū: fast float-to-string
    // conversion", PLDI 2018. The value's interval of numbers that round to
    // it is scaled by a precomputed power of five, so the digits come from
    // 64- and 128-bit integer arithmetic with no big numbers and no
    // allocation. The powers of five are in ryu_tables.ghul, generated by
    // ghul-core/tools/ryu-tables.ghul.
    //
    // A result is the decimal mantissa and exponent of the value's
    // magnitude: digits times ten to the exponent.
    struct SHORTEST_DECIMAL(digits: ulong public, exponent: int public)

    // The shortest decimal of a finite, non-zero double's magnitude, from its
    // biased exponent and fraction fields.
    _double_shortest(biased: int, fraction: ulong) -> SHORTEST_DECIMAL is
        let e2 = if biased == 0 then 1 - 1023 - 52 - 2 else biased - 1023 - 52 - 2 fi
        let m2 = if biased == 0 then fraction else fraction | (1ul << 52) fi
        let accept_bounds = (m2 & 1ul) == 0ul

        // The interval's bounds are mv - 1 - mm_shift and mv + 2, times a
        // quarter: the gap below is half the gap above at a power of two.
        let mv = 4ul * m2
        let mm_shift = if fraction != 0ul \/ biased <= 1 then 1ul else 0ul fi

        let vr mut = 0ul
        let vp mut = 0ul
        let vm mut = 0ul
        let e10 mut = 0
        let vm_trailing_zeros mut = false
        let vr_trailing_zeros mut = false

        if e2 >= 0 then
            let q = _log10_pow2(e2) - (if e2 > 3 then 1 else 0 fi)
            let k = 125 + _pow5_bits(q) - 1
            let i = -e2 + q + k
            let low = RYU_TABLES.DOUBLE_POW5_INV_SPLIT[2 * q]
            let high = RYU_TABLES.DOUBLE_POW5_INV_SPLIT[2 * q + 1]

            e10 = q
            vr = _mul_shift_64(4ul * m2, low, high, i)
            vp = _mul_shift_64(4ul * m2 + 2ul, low, high, i)
            vm = _mul_shift_64(4ul * m2 - 1ul - mm_shift, low, high, i)

            if q <= 21 then
                // Only one of mp, mv and mm can be a multiple of five, if any.
                if mv % 5ul == 0ul then
                    vr_trailing_zeros = _multiple_of_power_of_5(mv, q)
                elif accept_bounds then
                    vm_trailing_zeros = _multiple_of_power_of_5(mv - 1ul - mm_shift, q)
                elif _multiple_of_power_of_5(mv + 2ul, q) then
                    vp = vp - 1ul
                fi
            fi
        else
            let q = _log10_pow5(-e2) - (if -e2 > 1 then 1 else 0 fi)
            let i = -e2 - q
            let k = _pow5_bits(i) - 125
            let j = q - k
            let low = RYU_TABLES.DOUBLE_POW5_SPLIT[2 * i]
            let high = RYU_TABLES.DOUBLE_POW5_SPLIT[2 * i + 1]

            e10 = q + e2
            vr = _mul_shift_64(4ul * m2, low, high, j)
            vp = _mul_shift_64(4ul * m2 + 2ul, low, high, j)
            vm = _mul_shift_64(4ul * m2 - 1ul - mm_shift, low, high, j)

            if q <= 1 then
                // mv has at least q trailing zero bits, so vr is exact.
                vr_trailing_zeros = true

                if accept_bounds then
                    vm_trailing_zeros = mm_shift == 1ul
                else
                    vp = vp - 1ul
                fi
            elif q < 63 then
                vr_trailing_zeros = _multiple_of_power_of_2(mv, q)
            fi
        fi

        let removed mut = 0
        let last_removed mut = 0ul
        let output mut = 0ul

        if vm_trailing_zeros \/ vr_trailing_zeros then
            // The general case, rarely taken: track whether the digits removed
            // are all zeros, for the exact tie and for an inclusive lower bound.
            while vp / 10ul > vm / 10ul do
                vm_trailing_zeros = vm_trailing_zeros /\ vm % 10ul == 0ul
                vr_trailing_zeros = vr_trailing_zeros /\ last_removed == 0ul
                last_removed = vr % 10ul
                vr = vr / 10ul
                vp = vp / 10ul
                vm = vm / 10ul
                removed = removed + 1
            od

            if vm_trailing_zeros then
                while vm % 10ul == 0ul do
                    vr_trailing_zeros = vr_trailing_zeros /\ last_removed == 0ul
                    last_removed = vr % 10ul
                    vr = vr / 10ul
                    vp = vp / 10ul
                    vm = vm / 10ul
                    removed = removed + 1
                od
            fi

            if vr_trailing_zeros /\ last_removed == 5ul /\ vr % 2ul == 0ul then
                // An exact tie rounds to even.
                last_removed = 4ul
            fi

            let round_up = (vr == vm /\ (!accept_bounds \/ !vm_trailing_zeros)) \/ last_removed >= 5ul

            output = if round_up then vr + 1ul else vr fi
        else
            let round_up mut = false

            if vp / 100ul > vm / 100ul then
                round_up = vr % 100ul >= 50ul
                vr = vr / 100ul
                vp = vp / 100ul
                vm = vm / 100ul
                removed = removed + 2
            fi

            while vp / 10ul > vm / 10ul do
                round_up = vr % 10ul >= 5ul
                vr = vr / 10ul
                vp = vp / 10ul
                vm = vm / 10ul
                removed = removed + 1
            od

            output = if vr == vm \/ round_up then vr + 1ul else vr fi
        fi

        return SHORTEST_DECIMAL(output, e10 + removed)
    si

    // The shortest decimal of a finite, non-zero single's magnitude, from
    // its biased exponent and fraction fields.
    _single_shortest(biased: int, fraction: ulong) -> SHORTEST_DECIMAL is
        let e2 = if biased == 0 then 1 - 127 - 23 - 2 else biased - 127 - 23 - 2 fi
        let m2 = if biased == 0 then fraction else fraction | (1ul << 23) fi
        let accept_bounds = (m2 & 1ul) == 0ul

        let mv = 4ul * m2
        let mp = 4ul * m2 + 2ul
        let mm_shift = if fraction != 0ul \/ biased <= 1 then 1ul else 0ul fi
        let mm = 4ul * m2 - 1ul - mm_shift

        let vr mut = 0ul
        let vp mut = 0ul
        let vm mut = 0ul
        let e10 mut = 0
        let vm_trailing_zeros mut = false
        let vr_trailing_zeros mut = false
        let last_removed mut = 0ul

        if e2 >= 0 then
            let q = _log10_pow2(e2)
            let k = 59 + _pow5_bits(q) - 1
            let i = -e2 + q + k

            e10 = q
            vr = _mul_shift_32(mv, RYU_TABLES.FLOAT_POW5_INV_SPLIT[q], i)
            vp = _mul_shift_32(mp, RYU_TABLES.FLOAT_POW5_INV_SPLIT[q], i)
            vm = _mul_shift_32(mm, RYU_TABLES.FLOAT_POW5_INV_SPLIT[q], i)

            if q != 0 /\ (vp - 1ul) / 10ul <= vm / 10ul then
                // At most one digit is removed below, so the digit it would
                // be is computed from one more power of ten.
                let l = 59 + _pow5_bits(q - 1) - 1

                last_removed = _mul_shift_32(mv, RYU_TABLES.FLOAT_POW5_INV_SPLIT[q - 1], -e2 + q - 1 + l) % 10ul
            fi

            if q <= 9 then
                if mv % 5ul == 0ul then
                    vr_trailing_zeros = _multiple_of_power_of_5(mv, q)
                elif accept_bounds then
                    vm_trailing_zeros = _multiple_of_power_of_5(mm, q)
                elif _multiple_of_power_of_5(mp, q) then
                    vp = vp - 1ul
                fi
            fi
        else
            let q = _log10_pow5(-e2)
            let i = -e2 - q
            let k = _pow5_bits(i) - 61
            let j mut = q - k

            e10 = q + e2
            vr = _mul_shift_32(mv, RYU_TABLES.FLOAT_POW5_SPLIT[i], j)
            vp = _mul_shift_32(mp, RYU_TABLES.FLOAT_POW5_SPLIT[i], j)
            vm = _mul_shift_32(mm, RYU_TABLES.FLOAT_POW5_SPLIT[i], j)

            if q != 0 /\ (vp - 1ul) / 10ul <= vm / 10ul then
                j = q - 1 - (_pow5_bits(i + 1) - 61)
                last_removed = _mul_shift_32(mv, RYU_TABLES.FLOAT_POW5_SPLIT[i + 1], j) % 10ul
            fi

            if q <= 1 then
                vr_trailing_zeros = true

                if accept_bounds then
                    vm_trailing_zeros = mm_shift == 1ul
                else
                    vp = vp - 1ul
                fi
            elif q < 31 then
                vr_trailing_zeros = _multiple_of_power_of_2(mv, q - 1)
            fi
        fi

        let removed mut = 0
        let output mut = 0ul

        if vm_trailing_zeros \/ vr_trailing_zeros then
            while vp / 10ul > vm / 10ul do
                vm_trailing_zeros = vm_trailing_zeros /\ vm % 10ul == 0ul
                vr_trailing_zeros = vr_trailing_zeros /\ last_removed == 0ul
                last_removed = vr % 10ul
                vr = vr / 10ul
                vp = vp / 10ul
                vm = vm / 10ul
                removed = removed + 1
            od

            if vm_trailing_zeros then
                while vm % 10ul == 0ul do
                    vr_trailing_zeros = vr_trailing_zeros /\ last_removed == 0ul
                    last_removed = vr % 10ul
                    vr = vr / 10ul
                    vp = vp / 10ul
                    vm = vm / 10ul
                    removed = removed + 1
                od
            fi

            if vr_trailing_zeros /\ last_removed == 5ul /\ vr % 2ul == 0ul then
                last_removed = 4ul
            fi

            let round_up = (vr == vm /\ (!accept_bounds \/ !vm_trailing_zeros)) \/ last_removed >= 5ul

            output = if round_up then vr + 1ul else vr fi
        else
            while vp / 10ul > vm / 10ul do
                last_removed = vr % 10ul
                vr = vr / 10ul
                vp = vp / 10ul
                vm = vm / 10ul
                removed = removed + 1
            od

            output = if vr == vm \/ last_removed >= 5ul then vr + 1ul else vr fi
        fi

        return SHORTEST_DECIMAL(output, e10 + removed)
    si

    // floor(log2(5^e)) + 1, the bit length of 5^e, for 0 <= e <= 3528.
    _pow5_bits(e: int) -> int pure => ((e * 1217359) >>> 19) + 1

    // floor(log10(2^e)), for 0 <= e <= 1650.
    _log10_pow2(e: int) -> int pure => (e * 78913) >>> 18

    // floor(log10(5^e)), for 0 <= e <= 2620.
    _log10_pow5(e: int) -> int pure => (e * 732923) >>> 20

    _multiple_of_power_of_5(value: ulong, p: int) -> bool pure is
        let rest mut = value
        let count mut = 0

        while rest % 5ul == 0ul do
            rest = rest / 5ul
            count = count + 1

            if count >= p then
                return true
            fi
        od

        return count >= p
    si

    _multiple_of_power_of_2(value: ulong, p: int) -> bool pure =>
        (value & ((1ul << p) - 1ul)) == 0ul

    // The 192-bit product of `m` and the 128-bit `high:low`, shifted right
    // by `j`, which is between 64 and 128: Ryū's mulShift64, with the 128-bit
    // products built from 32-bit halves.
    _mul_shift_64(m: ulong, low: ulong, high: ulong, j: int) -> ulong pure is
        let low_high = _multiply_high(m, low)
        let high_low = m * high
        let high_high = _multiply_high(m, high)

        let sum = low_high + high_low
        let carried = if sum < low_high then high_high + 1ul else high_high fi
        let shift = j - 64

        return (carried << (64 - shift)) | (sum >> shift)
    si

    // The high 64 bits of the 128-bit product of `a` and `b`.
    _multiply_high(a: ulong, b: ulong) -> ulong pure is
        let mask = 4294967295ul
        let a_low = a & mask
        let a_high = a >> 32
        let b_low = b & mask
        let b_high = b >> 32

        let low_low = a_low * b_low
        let high_low = a_high * b_low
        let low_high = a_low * b_high
        let high_high = a_high * b_high

        let middle = high_low + (low_low >> 32)
        let middle_2 = low_high + (middle & mask)

        return high_high + (middle >> 32) + (middle_2 >> 32)
    si

    // The 96-bit product of the 32-bit `m` and the 64-bit `factor`, shifted
    // right by `shift`, which is more than 32: Ryū's mulShift32.
    _mul_shift_32(m: ulong, factor: ulong, shift: int) -> ulong pure is
        let bits_0 = m * (factor & 4294967295ul)
        let bits_1 = m * (factor >> 32)
        let sum = (bits_0 >> 32) + bits_1

        return sum >> (shift - 32)
    si
si
