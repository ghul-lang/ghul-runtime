namespace Ghul is
    use Collections.LIST

    /// What `split` does with the pieces it finds.
    enum StringSplitOptions is
        /// Keep every piece as found.
        NONE = 0,
        /// Leave out pieces that are empty.
        REMOVE_EMPTY_ENTRIES = 1,
        /// Trim white space from each piece.
        TRIM_ENTRIES = 2,
        /// Trim each piece, then leave out the ones left empty.
        REMOVE_EMPTY_AND_TRIM_ENTRIES = 3,
    si

    partial string is
        /// The pieces between each occurrence of any of `separators`, in
        /// order. With no separators, the pieces are split at white space.
        ///
        /// - separators: the code units to split at
        split(separators: char[]) -> string[] pure => split(separators, StringSplitOptions.NONE)

        /// The pieces between each occurrence of any of `separators`, in
        /// order, kept or trimmed as `options` says. With no separators, the
        /// pieces are split at white space.
        ///
        /// - separators: the code units to split at
        /// - options: whether to trim the pieces and leave out empty ones
        split(separators: char[], options: StringSplitOptions) -> string[] pure is
            if options == StringSplitOptions.NONE then
                return _split_exact(separators)
            fi

            let pieces = LIST[string]()
            let start mut = 0
            let i mut = 0

            while i < length do
                if _is_separator(self[i], separators) then
                    _add_piece(pieces, substring(start, i - start), options)
                    start = i + 1
                fi

                i = i + 1
            od

            _add_piece(pieces, substring(start), options)

            return _to_array(pieces)
        si

        /// The pieces between each `separator`, kept or trimmed as `options`
        /// says.
        ///
        /// - separator: the code unit to split at
        /// - options: whether to trim the pieces and leave out empty ones
        split(separator: char, options: StringSplitOptions) -> string[] pure =>
            split(_string_from_char(separator), options)

        /// The pieces between each `separator`, kept or trimmed as `options`
        /// says.
        ///
        /// - separator: the text to split at
        /// - options: whether to trim the pieces and leave out empty ones
        split(separator: string, options: StringSplitOptions) -> string[] pure is
            let pieces = LIST[string]()

            for piece in split(separator) do
                _add_piece(pieces, piece, options)
            od

            return _to_array(pieces)
        si

        /// The pieces between each occurrence of any of `separators`, kept or
        /// trimmed as `options` says. Where two separators match at the same
        /// place, the earlier in `separators` is taken.
        ///
        /// - separators: the texts to split at
        /// - options: whether to trim the pieces and leave out empty ones
        split(separators: string[], options: StringSplitOptions) -> string[] pure is
            let pieces = LIST[string]()
            let start mut = 0
            let i mut = 0

            while i < length do
                let matched = _separator_at(i, separators)

                if matched > 0 then
                    _add_piece(pieces, substring(start, i - start), options)
                    i = i + matched
                    start = i
                else
                    i = i + 1
                fi
            od

            _add_piece(pieces, substring(start), options)

            return _to_array(pieces)
        si

        // Every piece between separators, into an array sized by counting
        // the separators first, so no piece is copied twice.
        _split_exact(separators: char[]) -> string[] pure is
            let single = separators.count == 1
            let only = if single then separators[0] else ' ' fi
            let count mut = 1
            let i mut = 0

            while i < length do
                let unit = self[i]

                if (if single then unit == only else _is_separator(unit, separators) fi) then
                    count = count + 1
                fi

                i = i + 1
            od

            let result = _array_new[string](count)
            let start mut = 0
            let next mut = 0

            i = 0

            while i < length do
                let unit = self[i]

                if (if single then unit == only else _is_separator(unit, separators) fi) then
                    _array_set(result, next, _string_substring(self, start, i - start))
                    next = next + 1
                    start = i + 1
                fi

                i = i + 1
            od

            _array_set(result, next, _string_substring(self, start, length - start))

            return result
        si

        /// The string's code units, as a new array.
        to_char_array() -> char[] pure is
            let result = _array_new[char](length)
            let i mut = 0

            while i < length do
                _array_set(result, i, self[i])
                i = i + 1
            od

            return result
        si

        /// The string without the code units from `start` to its end.
        ///
        /// - start: where to start removing
        remove(start: int) -> string pure => substring(0, start)

        /// The string without `count` code units from `start`.
        ///
        /// - start: where to start removing
        /// - count: how many code units to remove
        remove(start: int, count: int) -> string pure =>
            _string_concat(substring(0, start), substring(start + count))

        /// The string with `value` inserted at `start`.
        ///
        /// - start: where to insert, from 0 to the string's length
        /// - value: the text to insert
        insert(start: int, value: string) -> string =>
            _string_concat(_string_concat(substring(0, start), value), substring(start))

        /// The string without leading and trailing occurrences of `trim_char`.
        ///
        /// - trim_char: the code unit to remove
        trim(trim_char: char) -> string pure => trim([trim_char])

        /// The string without leading and trailing occurrences of any of
        /// `trim_chars`; with none given, without white space.
        ///
        /// - trim_chars: the code units to remove
        trim(trim_chars: char[]) -> string pure is
            let start = _first_not_in(trim_chars)
            let end = _last_not_in(trim_chars)

            if start > end then
                return ""
            fi

            return substring(start, end - start + 1)
        si

        /// The string without leading occurrences of `trim_char`.
        ///
        /// - trim_char: the code unit to remove
        trim_start(trim_char: char) -> string pure => trim_start([trim_char])

        /// The string without leading occurrences of any of `trim_chars`;
        /// with none given, without white space.
        ///
        /// - trim_chars: the code units to remove
        trim_start(trim_chars: char[]) -> string pure => substring(_first_not_in(trim_chars))

        /// The string without trailing occurrences of `trim_char`.
        ///
        /// - trim_char: the code unit to remove
        trim_end(trim_char: char) -> string pure => trim_end([trim_char])

        /// The string without trailing occurrences of any of `trim_chars`;
        /// with none given, without white space.
        ///
        /// - trim_chars: the code units to remove
        trim_end(trim_chars: char[]) -> string pure => substring(0, _last_not_in(trim_chars) + 1)

        /// The string with each letter made upper case under the invariant
        /// culture.
        to_upper_invariant() -> string pure => to_upper()

        /// The string with each letter made lower case under the invariant
        /// culture.
        to_lower_invariant() -> string pure => to_lower()

        /// The order of `a` and `b` by their code units: negative where `a`
        /// orders first, zero where they are equal, positive otherwise. An
        /// absent string orders before any other.
        ///
        /// - a: the first string
        /// - b: the second string
        compare_ordinal(a: string?, b: string?) -> int static => compare(a, b)

        _first_not_in(units: char[]) -> int is
            let i mut = 0

            while i < length /\ _is_separator(self[i], units) do
                i = i + 1
            od

            return i
        si

        _last_not_in(units: char[]) -> int is
            let i mut = length - 1

            while i >= 0 /\ _is_separator(self[i], units) do
                i = i - 1
            od

            return i
        si

        _separator_at(position: int, separators: string[]) -> int is
            for separator in separators do
                if separator.length > 0 /\ _matches_at(position, separator) then
                    return separator.length
                fi
            od

            return 0
        si
    si

    // Whether `unit` is one of `units`, or white space where `units` is empty.
    _is_separator(unit: char, units: char[]) -> bool is
        if units.count == 0 then
            return _is_white_space(unit)
        fi

        for candidate in units do
            if candidate == unit then
                return true
            fi
        od

        return false
    si

    _add_piece(pieces: LIST[string], piece: string, options: StringSplitOptions) is
        let trimmed = if cast int(options) % 4 >= 2 then piece.trim() else piece fi

        if cast int(options) % 2 == 1 /\ trimmed.length == 0 then
            return
        fi

        pieces.add(trimmed)
    si

    _to_array(pieces: LIST[string]) -> string[] is
        let result = _array_new[string](pieces.count)
        let i mut = 0

        while i < pieces.count do
            _array_set(result, i, pieces[i])
            i = i + 1
        od

        return result
    si
si
