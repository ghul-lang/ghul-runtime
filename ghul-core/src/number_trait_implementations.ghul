namespace Ghul.Math is
    // The scalar types and bigint implement the generic-math traits as
    // the .NET types do. Their operators are the built-in ones, and
    // `min_value` and `max_value` are the static properties each type
    // already declares.

    impl BinaryInteger[byte] for byte is
        /// Zero.
        zero: byte static => cast byte(0)

        /// One.
        one: byte static => cast byte(1)

        /// Zero, which leaves a value unchanged when added.
        additive_identity: byte static => cast byte(0)

        /// One, which leaves a value unchanged when multiplied.
        multiplicative_identity: byte static => cast byte(1)
    si

    impl SignedNumber[byte] for byte is
        /// Minus one.
        negative_one: byte static => cast byte(-1)
    si

    impl MinMaxValue[byte] for byte is si

    impl BinaryInteger[short] for short is
        /// Zero.
        zero: short static => cast short(0)

        /// One.
        one: short static => cast short(1)

        /// Zero, which leaves a value unchanged when added.
        additive_identity: short static => cast short(0)

        /// One, which leaves a value unchanged when multiplied.
        multiplicative_identity: short static => cast short(1)
    si

    impl SignedNumber[short] for short is
        /// Minus one.
        negative_one: short static => cast short(-1)
    si

    impl MinMaxValue[short] for short is si

