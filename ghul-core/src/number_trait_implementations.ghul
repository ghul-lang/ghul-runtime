    impl BinaryInteger[bigint] for bigint is
        /// Zero, which leaves a value unchanged when added.
        additive_identity: bigint static => zero

        /// One, which leaves a value unchanged when multiplied.
        multiplicative_identity: bigint static => one
    si

    impl SignedNumber[bigint] for bigint is
        /// Minus one.
        negative_one: bigint static => minus_one
    si
si
