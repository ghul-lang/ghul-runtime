namespace Collections is
    /// A last-in, first-out collection: the element added most recently is
    /// the first one removed. This is .NET's `Stack<T>`, which ghūl names
    /// `STACK` on .NET as well.
    class STACK[T]: Bag[T] is
        _items: T[];
        _count: int;

        /// An empty stack.
        init() is
            _items = Ghul._array_new[T](0);
            _count = 0;
        si

        /// A stack holding the elements of `source`, pushed in order, so
        /// the last of them is on top.
        ///
        /// - source: the elements to push
        init(source: Iterable[T]) is
            _items = Ghul._array_new[T](0);
            _count = 0;

            for value in source do
                push(value);
            od
        si

        /// The number of elements.
        count: int pure => _count;

        /// Adds `value` on top.
        ///
        /// - value: the element to add
        push(value: T) is
            if _count == _items.count then
                _grow();
            fi

            Ghul._array_set(_items, _count, value);
            _count = _count + 1;
        si

        /// Removes and returns the element on top. Throws
        /// `Ghul.InvalidOperationException` when the stack is empty.
        pop() -> T is
            if _count == 0 then
                throw Ghul.InvalidOperationException("Stack empty.");
            fi

            _count = _count - 1;

            let value = _items[_count];

            Ghul._array_set(_items, _count, _[T]);

            return value;
        si

        /// The element on top, left in place. Throws
        /// `Ghul.InvalidOperationException` when the stack is empty.
        peek() -> T pure is
            if _count == 0 then
                throw Ghul.InvalidOperationException("Stack empty.");
            fi

            return _items[_count - 1];
        si

        /// Removes every element.
        clear() is
            let i mut = 0;

            while i < _count do
                Ghul._array_set(_items, i, _[T]);
                i = i + 1;
            od

            _count = 0;
        si

        /// Whether any element is `=~` to `value`.
        ///
        /// - value: the element to look for
        contains(value: T) -> bool is
            let i mut = 0;

            while i < _count do
                if _items[i] =~ value then
                    return true;
                fi

                i = i + 1;
            od

            return false;
        si

        /// The elements from the top down, copied into a new array.
        to_array() -> T[] is
            let result = Ghul._array_new[T](_count);
            let i mut = 0;

            while i < _count do
                Ghul._array_set(result, i, _items[_count - 1 - i]);
                i = i + 1;
            od

            return result;
        si

        /// An iterator over the elements from the top down.
        iterator: Iterator[T] => LIST_ITERATOR[T](to_array(), _count);

        _grow() is
            let grown = Ghul._array_new[T](if _items.count == 0 then 4 else _items.count * 2 fi);
            let i mut = 0;

            while i < _count do
                Ghul._array_set(grown, i, _items[i]);
                i = i + 1;
            od

            _items = grown;
        si
    si
si
