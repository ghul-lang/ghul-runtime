namespace Ghul is
    use Collections

    // Ranges over the integer types other than int and long, which .NET
    // gives through its generic ranges over `IBinaryInteger`.

    /// The `byte` values from `from` up to but not including `to`, as an iterable range.
    struct BYTE_RANGE: Range[byte], Iterable[byte], Iterator[byte] is
        /// This range, as its own iterator.
        iterator: Iterator[byte] => self

        /// The first element.
        from: byte
        /// The exclusive upper bound.
        to: byte

        /// The element the range is currently at.
        current: byte

        _next: byte
        _finished: bool

        /// Creates a range from `from` up to but not including `to`.
        init(from: byte, to: byte) is
            self.from = from
            self.to = to

            _next = from
            _finished = from >= to
        si

        /// Advances to the next element, and returns whether one was reached.
        move_next() -> bool is
            if _finished then
                return false
            fi

            current = _next

            if _next == to - 1b then
                _finished = true
            else
                _next = _next + 1b
            fi

            return true
        si

        /// Has no effect; the range holds no resource to release.
        dispose() is
        si
    si

    /// The `byte` values from `from` to `to`, including both, as an iterable range.
    struct BYTE_RANGE_INCLUSIVE: Range[byte], Iterable[byte], Iterator[byte] is
        /// This range, as its own iterator.
        iterator: Iterator[byte] => self

        /// The first element.
        from: byte
        /// The inclusive upper bound.
        to: byte

        /// The element the range is currently at.
        current: byte

        _next: byte
        _finished: bool

        /// Creates a range from `from` to `to`, including both.
        init(from: byte, to: byte) is
            self.from = from
            self.to = to

            _next = from
            _finished = from > to
        si

        /// Advances to the next element, and returns whether one was reached.
        move_next() -> bool is
            if _finished then
                return false
            fi

            current = _next

            if _next == to then
                _finished = true
            else
                _next = _next + 1b
            fi

            return true
        si

        /// Has no effect; the range holds no resource to release.
        dispose() is
        si
    si

