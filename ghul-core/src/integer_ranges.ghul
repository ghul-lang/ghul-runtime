namespace Ghul.Intrinsics is
    use Ghul

    /// The range from `from` up to but not including `to`.
    ..(from: byte, to: byte) -> BYTE_RANGE pure => BYTE_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: byte, to: byte) -> BYTE_RANGE_INCLUSIVE pure => BYTE_RANGE_INCLUSIVE(from, to)

    /// The range from `from` up to but not including `to`.
    ..(from: ubyte, to: ubyte) -> UBYTE_RANGE pure => UBYTE_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: ubyte, to: ubyte) -> UBYTE_RANGE_INCLUSIVE pure => UBYTE_RANGE_INCLUSIVE(from, to)

    /// The range from `from` up to but not including `to`.
    ..(from: short, to: short) -> SHORT_RANGE pure => SHORT_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: short, to: short) -> SHORT_RANGE_INCLUSIVE pure => SHORT_RANGE_INCLUSIVE(from, to)

    /// The range from `from` up to but not including `to`.
    ..(from: ushort, to: ushort) -> USHORT_RANGE pure => USHORT_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: ushort, to: ushort) -> USHORT_RANGE_INCLUSIVE pure => USHORT_RANGE_INCLUSIVE(from, to)

    /// The range from `from` up to but not including `to`.
    ..(from: uint, to: uint) -> UINT_RANGE pure => UINT_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: uint, to: uint) -> UINT_RANGE_INCLUSIVE pure => UINT_RANGE_INCLUSIVE(from, to)

    /// The range from `from` up to but not including `to`.
    ..(from: ulong, to: ulong) -> ULONG_RANGE pure => ULONG_RANGE(from, to)

    /// The range from `from` to `to`, including both.
    ::(from: ulong, to: ulong) -> ULONG_RANGE_INCLUSIVE pure => ULONG_RANGE_INCLUSIVE(from, to)

si
