namespace Ghul is
    // The text .NET gives a double or a single: the shortest digits that
    // parse back to the same value, in plain or E notation as .NET chooses.
    // The digits come from Ryū (ryu.ghul), and are written straight into a
    // string of exactly the length they take.

    _format_double(value: double) -> string is
        let length = _double_length(value)
        let chars = _array_new[char](length)

        _write_double(chars, 0, value)

        return _string_from_chars(chars, 0, length)
    si

    _format_single(value: single) -> string is
        let length = _single_length(value)
        let chars = _array_new[char](length)

        _write_single(chars, 0, value)

        return _string_from_chars(chars, 0, length)
    si

    // The number of code units `value` takes as text.
    _double_length(value: double) -> int is
        let bits = _double_bits(value)
        let negative = (bits >> 63) != 0ul
        let biased = cast int((bits >> 52) & 2047ul)
        let fraction = bits & ((1ul << 52) - 1ul)

        if biased == 2047 then
            return _non_finite_text(fraction != 0ul, negative).length
        elif biased == 0 /\ fraction == 0ul then
            return if negative then 2 else 1 fi
        fi

        return _layout_length(_double_shortest(biased, fraction), 17, negative)
    si

    // Writes `value` as text into `chars` from `at` on, taking exactly
    // `_double_length(value)` code units. Answers the position after it.
    _write_double(chars: ARRAY[char], at: int, value: double) -> int is
        let bits = _double_bits(value)
        let negative = (bits >> 63) != 0ul
        let biased = cast int((bits >> 52) & 2047ul)
        let fraction = bits & ((1ul << 52) - 1ul)

        if biased == 2047 then
            return _write_text(chars, at, _non_finite_text(fraction != 0ul, negative))
        elif biased == 0 /\ fraction == 0ul then
            return _write_text(chars, at, if negative then "-0" else "0" fi)
        fi

        return _write_layout(chars, at, _double_shortest(biased, fraction), 17, negative)
    si

    // The number of code units `value` takes as text.
    _single_length(value: single) -> int is
        let bits = _single_bits(value)
        let negative = (bits >> 31) != 0u
        let biased = cast int((bits >> 23) & 255u)
        let fraction = cast ulong(bits & ((1u << 23) - 1u))

        if biased == 255 then
            return _non_finite_text(fraction != 0ul, negative).length
        elif biased == 0 /\ fraction == 0ul then
            return if negative then 2 else 1 fi
        fi

        return _layout_length(_single_shortest(biased, fraction), 9, negative)
    si

    // Writes `value` as text into `chars` from `at` on, taking exactly
    // `_single_length(value)` code units. Answers the position after it.
    _write_single(chars: ARRAY[char], at: int, value: single) -> int is
        let bits = _single_bits(value)
        let negative = (bits >> 31) != 0u
        let biased = cast int((bits >> 23) & 255u)
        let fraction = cast ulong(bits & ((1u << 23) - 1u))

        if biased == 255 then
            return _write_text(chars, at, _non_finite_text(fraction != 0ul, negative))
        elif biased == 0 /\ fraction == 0ul then
            return _write_text(chars, at, if negative then "-0" else "0" fi)
        fi

        return _write_layout(chars, at, _single_shortest(biased, fraction), 9, negative)
    si

    _non_finite_text(is_nan: bool, negative: bool) -> string =>
        if is_nan then
            "NaN"
        elif negative then
            "-Infinity"
        else
            "Infinity"
        fi

    // .NET's layout of `decimal`, whose value is 0.d1d2...dn times ten to
    // the `point`, where `point` is the decimal exponent plus the digit
    // count n: plain while the decimal point falls from three places before
    // the first digit to `widest` places after it, E notation otherwise,
    // with at least two exponent digits.
    _layout_length(decimal: SHORTEST_DECIMAL, widest: int, negative: bool) -> int is
        let count = _decimal_length(decimal.digits)
        let point = decimal.exponent + count
        let sign = if negative then 1 else 0 fi

        if point >= -3 /\ point <= widest then
            if point <= 0 then
                return sign + 2 - point + count
            elif point >= count then
                return sign + point
            fi

            return sign + count + 1
        fi

        let magnitude = if point - 1 < 0 then 1 - point else point - 1 fi
        let exponent_digits = if magnitude < 10 then 2 else _decimal_length(cast long(magnitude)) fi
        let fraction = if count > 1 then count + 1 else 1 fi

        return sign + fraction + 2 + exponent_digits
    si

    _write_layout(chars: ARRAY[char], at: int, decimal: SHORTEST_DECIMAL, widest: int, negative: bool) -> int is
        let count = _decimal_length(decimal.digits)
        let point = decimal.exponent + count
        let position mut = at

        if negative then
            position = _write_char(chars, position, '-')
        fi

        if point >= -3 /\ point <= widest then
            if point <= 0 then
                position = _write_char(chars, position, '0')
                position = _write_char(chars, position, '.')
                position = _write_repeated(chars, position, '0', -point)

                return _write_decimal(chars, position, count, decimal.digits)
            elif point >= count then
                position = _write_decimal(chars, position, count, decimal.digits)

                return _write_repeated(chars, position, '0', point - count)
            fi

            // the digits with the point inserted after the first `point`
            _write_decimal(chars, position + 1, count, decimal.digits)

            let i mut = 0

            while i < point do
                _array_set(chars, position + i, chars[position + i + 1])
                i = i + 1
            od

            _array_set(chars, position + point, '.')

            return position + count + 1
        fi

        // E notation: d.ddd, then E, a sign and the exponent
        if count > 1 then
            _write_decimal(chars, position + 1, count, decimal.digits)
            _array_set(chars, position, chars[position + 1])
            _array_set(chars, position + 1, '.')
            position = position + count + 1
        else
            position = _write_decimal(chars, position, 1, decimal.digits)
        fi

        let scientific = point - 1
        let magnitude = if scientific < 0 then -scientific else scientific fi

        position = _write_char(chars, position, 'E')
        position = _write_char(chars, position, if scientific < 0 then '-' else '+' fi)

        if magnitude < 10 then
            position = _write_char(chars, position, '0')
        fi

        return _write_decimal(chars, position, _decimal_length(cast long(magnitude)), cast long(magnitude))
    si

    _write_repeated(chars: ARRAY[char], at: int, unit: char, count: int) -> int is
        let i mut = 0

        while i < count do
            _array_set(chars, at + i, unit)
            i = i + 1
        od

        return at + count
    si

    _zeros(count: int) -> string is
        let chars = _array_new[char](if count > 0 then count else 0 fi)

        _write_repeated(chars, 0, '0', count)

        return _string_from_chars(chars, 0, chars.count)
    si

    _digit_text(digit: int) -> string => _string_from_char(cast char(48 + digit))

    _decimal_text(value: int) -> string =>
        if value < 10 then
            _digit_text(value)
        else
            _string_concat(_decimal_text(value / 10), _digit_text(value % 10))
        fi

    _bit_length(value: ulong) -> int is
        let length mut = 0
        let rest mut = value

        while rest != 0ul do
            length = length + 1
            rest = rest >> 1
        od

        return length
    si

    _ceiling(value: double) -> int is
        let truncated = cast int(value)

        return if cast double(truncated) < value then truncated + 1 else truncated fi
    si

    // A non-negative integer as 32-bit limbs, least significant first, with
    // no zero limb at the top.

    _big_of(value: ulong) -> Collections.LIST[uint] is
        let result = Collections.LIST[uint]()

        if value != 0ul then
            result.add(cast uint(value & 4294967295ul))

            if (value >> 32) != 0ul then
                result.add(cast uint(value >> 32))
            fi
        fi

        return result
    si

    _big_multiplied(value: Collections.LIST[uint], factor: ulong) -> Collections.LIST[uint] is
        let result = Collections.LIST[uint]()
        let carry mut = 0ul
        let i mut = 0

        while i < value.count do
            let product = cast ulong(value[i]) * factor + carry

            result.add(cast uint(product & 4294967295ul))
            carry = product >> 32
            i = i + 1
        od

        while carry != 0ul do
            result.add(cast uint(carry & 4294967295ul))
            carry = carry >> 32
        od

        return result
    si

    _big_shifted(value: Collections.LIST[uint], places: int) -> Collections.LIST[uint] is
        let result = Collections.LIST[uint]()
        let whole = places / 32
        let part = places % 32
        let i mut = 0

        while i < whole do
            result.add(0u)
            i = i + 1
        od

        let carry mut = 0ul
        i = 0

        while i < value.count do
            let shifted = (cast ulong(value[i]) << part) | carry

            result.add(cast uint(shifted & 4294967295ul))
            carry = shifted >> 32
            i = i + 1
        od

        if carry != 0ul then
            result.add(cast uint(carry))
        fi

        return _big_trimmed(result)
    si

    _big_trimmed(value: Collections.LIST[uint]) -> Collections.LIST[uint] is
        while value.count > 0 /\ value[value.count - 1] == 0u do
            value.remove_at(value.count - 1)
        od

        return value
    si
si
