// .NET's names for these types are kept, so source written against .NET
// builds here unchanged.
@@suppress("non-upper-snake-case-name")

namespace System is

    /// Marks a declaration that should no longer be used, as .NET's
    /// `System.ObsoleteAttribute` does. Written `@System.Obsolete()` or
    /// `@System.Obsolete("use something else")`.
    class ObsoleteAttribute: Attribute is
        /// What to use instead, or null.
        message: string?

        /// Whether a use should be an error rather than a warning.
        is_error: bool

        /// Marks a declaration obsolete with no message.
        init() is
            message = null
            is_error = false
        si

        /// Marks a declaration obsolete with `message`.
        ///
        /// - message: what to use instead
        init(message: string?) is
            self.message = message
            is_error = false
        si

        /// Marks a declaration obsolete with `message`, as an error where
        /// `error` is true.
        ///
        /// - message: what to use instead
        /// - error: whether a use should be an error
        init(message: string?, error: bool) is
            self.message = message
            is_error = error
        si
    si

    /// The percent-encoding of URIs, as .NET's `System.Uri` gives it. Only the
    /// static escaping members are here; a `Uri` cannot be constructed.
    class Uri is
        init() is si

        /// `text` with every character except the unreserved ones (letters,
        /// digits, `-`, `.`, `_` and `~`) written as the percent-encoded bytes
        /// of its UTF-8, in upper-case hexadecimal.
        ///
        /// - text: the text to escape
        escape_data_string(text: string) -> string static is
            let digits = "0123456789ABCDEF"
            let bytes = System.Text.Encoding.utf8.get_bytes(text)
            let builder = Ghul.Internal.SYSTEM_TEXT.builder()
            let i mut = 0

            while i < bytes.count do
                let b = cast int(bytes[i])

                if _is_unreserved(b) then
                    builder.append(cast char(b))
                else
                    builder.append('%')
                    builder.append(digits[b >> 4])
                    builder.append(digits[b & 0xF])
                fi

                i = i + 1
            od

            return builder.to_string()
        si

        /// `text` with each percent-encoded byte sequence that is valid UTF-8
        /// replaced by the characters it encodes. A `%` not followed by two
        /// hexadecimal digits, and an encoded sequence that is not valid
        /// UTF-8, are left as they are.
        ///
        /// - text: the text to unescape
        unescape_data_string(text: string) -> string static is
            if text.index_of('%') < 0 then
                return text
            fi

            let builder = Ghul.Internal.SYSTEM_TEXT.builder()
            let i mut = 0

            while i < text.length do
                if text[i] != '%' \/ _escaped_byte(text, i) < 0 then
                    builder.append(text[i])
                    i = i + 1
                    continue
                fi

                // A run of escaped bytes, decoded one UTF-8 sequence at a time.
                let bytes = Collections.LIST[int]()
                let start = i
                let j mut = i

                while j < text.length /\ text[j] == '%' /\ _escaped_byte(text, j) >= 0 do
                    bytes.add(_escaped_byte(text, j))
                    j = j + 3
                od

                let k mut = 0

                while k < bytes.count do
                    let length = _sequence_length(bytes, k)

                    if length == 0 then
                        builder.append(text.substring(start + 3 * k, 3))
                        k = k + 1
                    else
                        let code_point = _decode(bytes, k, length)

                        if code_point >= 0x10000 then
                            let offset = code_point - 0x10000

                            builder.append(cast char(0xD800 + (offset >> 10)))
                            builder.append(cast char(0xDC00 + (offset & 0x3FF)))
                        else
                            builder.append(cast char(code_point))
                        fi

                        k = k + length
                    fi
                od

                i = j
            od

            return builder.to_string()
        si

        _is_unreserved(b: int) -> bool static is
            let c = cast char(b)

            return
                (c >= 'A' /\ c <= 'Z') \/ (c >= 'a' /\ c <= 'z') \/ (c >= '0' /\ c <= '9') \/
                c == '-' \/ c == '.' \/ c == '_' \/ c == '~'
        si

        // The byte the escape at `i` stands for, or -1 where `%` is not
        // followed by two hexadecimal digits.
        _escaped_byte(text: string, i: int) -> int static is
            if i + 2 >= text.length then
                return -1
            fi

            let high = _hex(text[i + 1])
            let low = _hex(text[i + 2])

            if high < 0 \/ low < 0 then
                return -1
            fi

            return high * 16 + low
        si

        _hex(c: char) -> int static =>
            if c >= '0' /\ c <= '9' then cast int(c) - cast int('0')
            elif c >= 'a' /\ c <= 'f' then cast int(c) - cast int('a') + 10
            elif c >= 'A' /\ c <= 'F' then cast int(c) - cast int('A') + 10
            else -1
            fi

        // The length of the valid UTF-8 sequence starting at `k`, or 0 where
        // the bytes there do not start one.
        _sequence_length(bytes: Collections.LIST[int], k: int) -> int static is
            let lead = bytes[k]

            let length =
                if lead < 0x80 then 1
                elif lead >= 0xC2 /\ lead <= 0xDF then 2
                elif lead >= 0xE0 /\ lead <= 0xEF then 3
                elif lead >= 0xF0 /\ lead <= 0xF4 then 4
                else 0
                fi

            if length == 0 \/ k + length > bytes.count then
                return 0
            fi

            let n mut = 1

            while n < length do
                if bytes[k + n] & 0xC0 != 0x80 then
                    return 0
                fi

                n = n + 1
            od

            if length == 1 then
                return 1
            fi

            let second = bytes[k + 1]

            // Overlong forms, surrogates and code points past U+10FFFF.
            if length == 3 /\ ((lead == 0xE0 /\ second < 0xA0) \/ (lead == 0xED /\ second >= 0xA0)) then
                return 0
            fi

            if length == 4 /\ ((lead == 0xF0 /\ second < 0x90) \/ (lead == 0xF4 /\ second >= 0x90)) then
                return 0
            fi

            return length
        si

        _decode(bytes: Collections.LIST[int], k: int, length: int) -> int static is
            if length == 1 then
                return bytes[k]
            fi

            let result mut =
                bytes[k] & (if length == 2 then 0x1F elif length == 3 then 0x0F else 0x07 fi)

            let n mut = 1

            while n < length do
                result = (result << 6) | (bytes[k + n] & 0x3F)
                n = n + 1
            od

            return result
        si
    si

    /// A version number of two to four parts, as .NET's `System.Version` is:
    /// major, minor, and optionally build and revision.
    class Version: Ghul.Comparable[Version], Ghul.Equatable[Version] is
        /// The first part.
        major: int

        /// The second part.
        minor: int

        /// The third part, or -1 where there is none.
        build: int

        /// The fourth part, or -1 where there is none.
        revision: int

        /// The version 0.0.
        init() is
            major = 0
            minor = 0
            build = -1
            revision = -1
        si

        /// The version `major`.`minor`.
        ///
        /// - major: the first part
        /// - minor: the second part
        init(major: int, minor: int) is
            self.major = _part(major, "major")
            self.minor = _part(minor, "minor")
            build = -1
            revision = -1
        si

        /// The version `major`.`minor`.`build`.
        ///
        /// - major: the first part
        /// - minor: the second part
        /// - build: the third part
        init(major: int, minor: int, build: int) is
            self.major = _part(major, "major")
            self.minor = _part(minor, "minor")
            self.build = _part(build, "build")
            revision = -1
        si

        /// The version `major`.`minor`.`build`.`revision`.
        ///
        /// - major: the first part
        /// - minor: the second part
        /// - build: the third part
        /// - revision: the fourth part
        init(major: int, minor: int, build: int, revision: int) is
            self.major = _part(major, "major")
            self.minor = _part(minor, "minor")
            self.build = _part(build, "build")
            self.revision = _part(revision, "revision")
        si

        /// The version `text` writes, such as `1.2` or `1.2.3.4`. Throws
        /// `Ghul.FormatException` where it is not one.
        ///
        /// - text: the text to read
        parse(text: string) -> Version static is
            if let version = _read(text) then
                return version
            fi

            throw Ghul.FormatException("'{text}' is not a version of two to four non-negative parts")
        si

        /// Whether `text` writes a version, as `parse` reads it; `result` is
        /// that version, or null where it is not one.
        ///
        /// - text: the text to read
        /// - result: where the version goes
        try_parse(text: string?, result: Version? ref) -> bool static is
            let version = if let t = text then _read(t) else null fi

            result! = version

            return version?
        si

        /// The parts there are, joined with `.`.
        to_string() -> string =>
            to_string(if revision >= 0 then 4 elif build >= 0 then 3 else 2 fi)

        /// The first `field_count` parts joined with `.`. Throws
        /// `Ghul.ArgumentException` where the version has fewer parts.
        ///
        /// - field_count: how many parts, from 0 to 4
        to_string(field_count: int) -> string is
            let have = if revision >= 0 then 4 elif build >= 0 then 3 else 2 fi

            if field_count < 0 \/ field_count > have then
                throw Ghul.ArgumentException("field_count must be from 0 to {have}")
            fi

            return
                case field_count
                when 0 then ""
                when 1 then "{major}"
                when 2 then "{major}.{minor}"
                when 3 then "{major}.{minor}.{build}"
                else "{major}.{minor}.{build}.{revision}"
                esac
        si

        /// A negative number, zero or a positive number as this version is
        /// earlier than, the same as or later than `other`; a part that is
        /// missing is earlier than any that is there.
        ///
        /// - other: the version to compare with
        compare_to(other: Version?) -> int is
            if other == null then
                return 1
            fi

            let o = other!

            return
                if major != o.major then _sign(major, o.major)
                elif minor != o.minor then _sign(minor, o.minor)
                elif build != o.build then _sign(build, o.build)
                elif revision != o.revision then _sign(revision, o.revision)
                else 0
                fi
        si

        /// Orders this version against `other`, as `compare_to` does.
        ///
        /// - other: the version to compare with
        <>(other: Version) -> int => compare_to(other)

        /// Whether `other` has the same parts.
        ///
        /// - other: the version to compare with
        =~(other: Version) -> bool => compare_to(other) == 0

        /// A hash of the parts.
        get_hash_code() -> int =>
            ((major & 0xF) << 28) | ((minor & 0xFF) << 20) | ((build & 0xFF) << 12) | (revision & 0xFFF)

        _sign(a: int, b: int) -> int static => if a < b then -1 else 1 fi

        _part(value: int, name: string) -> int static is
            if value < 0 then
                throw Ghul.ArgumentOutOfRangeException(name, "a version part must not be negative")
            fi

            return value
        si

        _read(text: string) -> Version? static is
            let parts = text.split(['.'])

            if parts.count < 2 \/ parts.count > 4 then
                return null
            fi

            let values = Ghul._array_new[int](parts.count)
            let i mut = 0

            while i < parts.count do
                let value mut = 0

                if !int.try_parse(parts[i], value ref) \/ value < 0 then
                    return null
                fi

                Ghul._array_set(values, i, value)
                i = i + 1
            od

            return
                case parts.count
                when 2 then Version(values[0], values[1])
                when 3 then Version(values[0], values[1], values[2])
                else Version(values[0], values[1], values[2], values[3])
                esac
        si
    si
si

namespace Ghul.Internal is
    use Text.STRING_BUILDER

    // A builder for the System types, whose namespace hides `Text` behind
    // `System.Text`.
    class SYSTEM_TEXT is
        builder() -> STRING_BUILDER static => STRING_BUILDER()
    si
si
