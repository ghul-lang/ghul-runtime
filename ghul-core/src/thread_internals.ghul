namespace Ghul.Internal is
    // What the core library keeps for each thread rather than for the
    // program: on llvm, held in the runtime's slot for the calling thread
    // and made the first time the thread asks; on wasm, which runs one
    // thread, one of them.
    class THREAD_LOCALS is
        // The state rendering a value by its own `to_string`, and that
        // value, while it does.
        display_host: DISPLAY_STATE? field public
        display_value: object? field public

        // The thread's queue of task work, once it has one.
        scheduler: Concurrency.SCHEDULER? field public

        // Whether a program thread started this one, rather than it being
        // the program's main thread.
        is_started_thread: bool field public

        init() is si

        @IF.llvm()
        current: THREAD_LOCALS static is
            if let here: THREAD_LOCALS = _state() then
                return here
            fi

            let made = THREAD_LOCALS()

            _set_state(made)

            return made
        si

        @IF.llvm()
        @intrinsic("host.thread_state")
        _state() -> object? static

        @IF.llvm()
        @intrinsic("host.thread_set_state")
        _set_state(state: object) static

        @IF.wasm()
        _only: THREAD_LOCALS static

        @IF.wasm()
        init() static is
            _only = THREAD_LOCALS()
        si

        @IF.wasm()
        current: THREAD_LOCALS static => _only
    si

    // How many threads the program has started that are still running,
    // not counting the main thread.
    @IF.llvm()
    class LIVE_THREADS is
        _running: int field

        _only: LIVE_THREADS static

        init() is si

        init() static is
            _only = LIVE_THREADS()
        si

        count: int static => ATOMICS.load(_only._running ref)

        started() static is
            ATOMICS.add(_only._running ref, 1)
        si

        ended() static is
            ATOMICS.add(_only._running ref, -1)
        si
    si

    // A lock for state the core library shares between threads and the
    // program cannot see, such as a cache. The thread holding it can take
    // it again, as a finalizer that runs during an allocation made under
    // the lock may, and gives it up when it has released it as often. On
    // wasm, which runs one thread, it does nothing.
    class LOCK is
        @IF.llvm()
        _mutex: object

        // The thread holding the lock, or 0, read by other threads; and how
        // many times it has taken it.
        @IF.llvm()
        _owner: long field

        @IF.llvm()
        _depth: int field

        init() is
            _init()
        si

        @IF.llvm()
        _init() is
            _mutex = _new()
        si

        @IF.wasm()
        _init() is si

        // Takes the lock, waiting while another thread holds it.
        @IF.llvm()
        enter() is
            let me = _thread_id()

            if ATOMICS.load(_owner ref) == me then
                _depth = _depth + 1
                return
            fi

            _lock(_mutex)
            ATOMICS.store(_owner ref, me)
            _depth = 1
        si

        @IF.wasm()
        enter() is si

        // Releases the lock once.
        @IF.llvm()
        exit() is
            _depth = _depth - 1

            if _depth == 0 then
                ATOMICS.store(_owner ref, 0L)
                _unlock(_mutex)
            fi
        si

        @IF.wasm()
        exit() is si

        @IF.llvm()
        @intrinsic("host.mutex_new")
        _new() -> object static

        @IF.llvm()
        @intrinsic("host.mutex_lock")
        _lock(mutex: object) -> bool static

        @IF.llvm()
        @intrinsic("host.mutex_unlock")
        _unlock(mutex: object) -> bool static

        @IF.llvm()
        @intrinsic("host.thread_id")
        _thread_id() -> long static
    si

    // The work other threads hand one thread's scheduler, and how many
    // of them the thread still waits on to hand it something. The thread
    // makes it the first time it waits on another thread; until then its
    // scheduler has none.
    @IF.llvm()
    class INBOX is
        _mutex: object
        _condition: object
        _work: Collections.LIST[() -> void]
        _expected: int

        init() is
            _mutex = _new_mutex()
            _condition = _new_condition()
            _work = Collections.LIST[() -> void]()
        si

        // Counts one more piece of work another thread will hand over.
        // Called by the owning thread.
        expect() is
            _lock(_mutex)
            _expected = _expected + 1
            _unlock(_mutex)
        si

        // Counts one piece of expected work as no longer coming. Called by
        // the owning thread.
        withdraw() is
            _lock(_mutex)
            _expected = _expected - 1
            _unlock(_mutex)
        si

        // Hands over `work` that was expected, waking the owning thread if
        // it waits. Called by any thread.
        deliver(work: () -> void) is
            _lock(_mutex)
            _work.add(work)
            _expected = _expected - 1
            _signal(_condition)
            _unlock(_mutex)
        si

        // Whether work has been handed over that has not been taken, or is
        // still expected.
        is_waiting: bool is
            _lock(_mutex)
            let waiting = _work.count > 0 \/ _expected > 0
            _unlock(_mutex)

            return waiting
        si

        // Moves the work handed over into `ready`, answering whether there
        // was any. Called by the owning thread.
        take(ready: Collections.QUEUE[() -> void]) -> bool is
            let fresh = Collections.LIST[() -> void]()

            _lock(_mutex)
            let taken = _work

            // An empty list stays the inbox's own, and another thread can
            // add to it as soon as the lock is released, so it is never
            // read outside the lock.
            if taken.count == 0 then
                _unlock(_mutex)
                return false
            fi

            _work = fresh
            _unlock(_mutex)

            for work in taken do
                ready.enqueue(work)
            od

            return true
        si

        // Waits until work is handed over or `milliseconds` pass, where
        // none is waiting to be taken; a negative `milliseconds` waits as
        // long as it takes. Called by the owning thread.
        wait(milliseconds: long) is
            _lock(_mutex)

            if _work.count == 0 /\ _expected > 0 then
                _wait(_condition, _mutex, milliseconds)
            fi

            _unlock(_mutex)
        si

        @intrinsic("host.mutex_new")
        _new_mutex() -> object static

        @intrinsic("host.mutex_lock")
        _lock(mutex: object) -> bool static

        @intrinsic("host.mutex_unlock")
        _unlock(mutex: object) -> bool static

        @intrinsic("host.condition_new")
        _new_condition() -> object static

        @intrinsic("host.condition_wait")
        _wait(condition: object, mutex: object, milliseconds: long) -> int static

        @intrinsic("host.condition_signal")
        _signal(condition: object) static
    si

    // The atomic operations on a value the caller names by reference, all
    // sequentially consistent. Each public operation calls the intrinsic it
    // is named for: an intrinsic outside a type's own operators is also
    // declared in Ghul.Intrinsics, which every program sees, so a public
    // intrinsic would join the overload group of any program function with
    // the same name.
    @IF.llvm()
    class ATOMICS is
        load[T](location: T ref) -> T static => _load(location)

        store[T](location: T ref, value: T) static is
            _store(location, value)
        si

        exchange[T](location: T ref, value: T) -> T static => _exchange(location, value)

        compare_exchange[T](location: T ref, expected: T, replacement: T) -> bool static =>
            _compare_exchange(location, expected, replacement)

        // Adds `value`, answering the sum.
        add[T](location: T ref, value: T) -> T static => _add(location, value)

        @intrinsic("atomic.load")
        _load[T](location: T ref) -> T static

        @intrinsic("atomic.store")
        _store[T](location: T ref, value: T) static

        @intrinsic("atomic.exchange")
        _exchange[T](location: T ref, value: T) -> T static

        @intrinsic("atomic.compare_exchange")
        _compare_exchange[T](location: T ref, expected: T, replacement: T) -> bool static

        @intrinsic("atomic.add")
        _add[T](location: T ref, value: T) -> T static
    si
si
