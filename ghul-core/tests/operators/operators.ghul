// The scalar operators the core library declares resolve as they do on
// .NET: arithmetic, bitwise and shift operators on the operand types,
// ordering and the boolean connectives as global operators.
f(a: int, b: int, wide: long) -> bool is
    let sum = a + b * 2 - (a << 1) % 3
    let masked = (wide >>> 4) & 255L

    return sum < 100 /\ masked >= 0L \/ !(a == b)
si

entry() is
    IO.Std.write_line("{f(3, 4, 4096L)}")
    IO.Std.write_line("{3 + 4 * 2 - (3 << 1) % 3} {(4096L >>> 4) & 255L} {-7 / 2} {-7 % 2} {7u / 2u} {200ub + 50ub}")
si
