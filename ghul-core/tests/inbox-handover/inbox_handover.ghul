use default

// Another thread hands this one work through its inbox while this thread
// takes from it; every piece of work must run exactly once, however the
// handing over and the taking interleave.

class COUNT is
    runs: int field public

    init() is si
si

let rounds = 1000
let per_round = 2000
let all_once mut = true

for _ in 0..rounds do
    let count = COUNT()
    let done = Tasks.TASK_STATE()
    let inbox = Tasks.SCHEDULER.expect_from_another_thread()

    for _ in 1..per_round do
        Tasks.SCHEDULER.expect_from_another_thread()
    od

    let producer = Ghul.Threads.start(() is
        for _ in 0..per_round do
            inbox.deliver(() is
                count.runs = count.runs + 1

                if count.runs == per_round then
                    done.complete()
                fi
            si)
        od
    si)

    Tasks.SCHEDULER.run_until(done)
    producer.join()

    // Anything handed over twice is still waiting in the inbox: one more
    // delivery from this thread brings it out.
    let settled = Tasks.TASK_STATE()
    Tasks.SCHEDULER.expect_from_another_thread()
    inbox.deliver(() is settled.complete() si)
    Tasks.SCHEDULER.run_until(settled)

    if count.runs != per_round then
        all_once = false
    fi
od

write_line("{rounds} rounds of {per_round} deliveries, each ran once: {all_once}")
