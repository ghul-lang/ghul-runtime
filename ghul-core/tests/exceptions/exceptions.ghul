// Each exception the compiler constructs or catches on the wasm target
// resolves to a class the library declares, with the constructors the
// compiler uses: one taking a message, and none for those it makes with
// no operands.
//
// try is not yet compiled for the wasm target, so this records the
// diagnostics that say so until it is.
entry() is
    let assert_failed: Ghul.Exception = Ghul.AssertFailedException("assert")
    let not_implemented: Ghul.Exception = Ghul.NotImplementedException("member")
    let not_supported: Ghul.Exception = Ghul.NotSupportedException()
    let invalid_cast: Ghul.Exception = Ghul.InvalidCastException()
    let overflow: Ghul.ArithmeticException = Ghul.OverflowException()

    try
        throw overflow
    catch e: Ghul.OverflowException
        let _ = e.message
    catch e: Ghul.InvalidCastException
        let _ = e.message
    yrt
si
