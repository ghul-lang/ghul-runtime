// The string builder's members print what the same program prints on .NET,
// and an interpolated string still builds through it.
use IO.Std.write_line
use Text.STRING_BUILDER

entry() is
    let builder = STRING_BUILDER()

    builder.append("ab").append('c').append(12).append(3000000000L).append(true)
    write_line(builder.to_string())
    write_line("{builder.length} {builder[2]}")

    builder.clear().append('-', 3).append_line("x").append_line()
    write_line("[{builder.to_string()}]")

    builder[0] = 'A'
    write_line(builder.to_string())

    builder.clear().append("hello").insert(0, "[").insert(6, ']').remove(1, 2)
    write_line(builder.to_string())

    let name = "builder"
    write_line("still {name} {42}")
si
