// object.equals(a, b) and Tasks.TASK.from_exception[T], as on .NET.
use IO.Std.write_line

class Key(id: int public) is
    equals(other: object?) -> bool =>
        if let k: Key = other then k.id == id else false fi;

    get_hash_code() -> int => id;
si

let a = Key(1)
let none: object? = null

write_line("{object.equals(a, Key(1))} {object.equals(a, Key(2))} {object.equals(a, a)}")
write_line("{object.equals(none, none)} {object.equals(a, none)} {object.equals(none, a)}")

let failed: Tasks.TASK[int] = Tasks.TASK.from_exception[int](Ghul.Exception("inner cause"))

try
    let _ = failed.result;
catch e: Ghul.Exception
    write_line("threw: {e.get_base_exception().message}")
yrt

let inferred: Tasks.TASK[string] = Tasks.TASK.from_exception(Ghul.Exception("by context"))

try
    let _ = inferred.result;
catch e: Ghul.Exception
    write_line("threw: {e.get_base_exception().message}")
yrt
