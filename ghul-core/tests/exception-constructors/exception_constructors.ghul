// An exception constructed with no message, whose message names its
// runtime type, and a subclass that passes none on. The subclass is declared
// in a namespace, since a type in a file with none is named after the path
// it is built from.
namespace Test is
    use IO.Std.write_line

    class QUIET: Ghul.Exception is
        init() is
            super.init()
        si
    si

    entry() is
        try
            throw Ghul.Exception()
        catch e: Ghul.Exception
            write_line(e.message)
        yrt

        try
            throw QUIET()
        catch e: Ghul.Exception
            write_line(e.message)
        yrt

        try
            throw Ghul.NotImplementedException()
        catch e: Ghul.NotImplementedException
            write_line(e.message)
        yrt
    si
si
