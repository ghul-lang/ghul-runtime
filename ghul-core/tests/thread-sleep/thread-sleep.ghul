use IO.Std.write_line

let start = System.Environment.tick_count64

System.Threading.Thread.sleep(50)

write_line("{System.Environment.tick_count64 - start >= 50L}")

let watch = System.Diagnostics.Stopwatch.start_new()

System.Threading.Thread.sleep(System.TimeSpan.from_milliseconds(30.0))

write_line("{watch.elapsed_milliseconds >= 30L}")

try
    System.Threading.Thread.sleep(-2)
catch _: System.ArgumentOutOfRangeException
    write_line("rejected")
yrt
