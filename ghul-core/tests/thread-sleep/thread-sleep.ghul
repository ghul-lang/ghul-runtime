use IO.Std.write_line

let start = System.Environment.tick_count64

Tasks.Thread.sleep(50)

write_line("{System.Environment.tick_count64 - start >= 50L}")

let watch = Time.Stopwatch.start_new()

Tasks.Thread.sleep(Time.TimeSpan.from_milliseconds(30.0))

write_line("{watch.elapsed_milliseconds >= 30L}")

try
    Tasks.Thread.sleep(-2)
catch _: Ghul.ArgumentOutOfRangeException
    write_line("rejected")
yrt
