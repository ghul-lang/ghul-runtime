// The character predicates classify by Unicode general category, as .NET's
// do: letters with no case, digits in other scripts, numbers, punctuation,
// symbols, separators and controls, beside the ASCII ones.
use IO.Std.write_line

flags(c: char) -> string is
    let result = Text.STRING_BUILDER()

    result.append("U+{cast int(c):X4} category {cast int(char.get_unicode_category(c))}:")

    if c.is_letter then result.append(" letter") fi
    if c.is_upper then result.append(" upper") fi
    if c.is_lower then result.append(" lower") fi
    if c.is_digit then result.append(" digit") fi
    if c.is_number then result.append(" number") fi
    if c.is_letter_or_digit then result.append(" letter-or-digit") fi
    if c.is_punctuation then result.append(" punctuation") fi
    if c.is_symbol then result.append(" symbol") fi
    if c.is_separator then result.append(" separator") fi
    if c.is_control then result.append(" control") fi
    if c.is_white_space then result.append(" white-space") fi

    return result.to_string()
si

for c in "aZ5 !$\tªǅʰ中אا٣Ⅷ½—«€∀  ́\uD800￿" do
    write_line(flags(c))
od
