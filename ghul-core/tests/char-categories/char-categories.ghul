// The character predicates classify by Unicode general category, as .NET's
// do: letters with no case, digits in other scripts, numbers, punctuation,
// symbols, separators and controls, beside the ASCII ones.
use IO.Std.write_line

flags(c: char) -> string is
    let result = Text.STRING_BUILDER()

    result.append("U+{cast int(c):X4} category {cast int(char.get_unicode_category(c))}:")

    if char.is_letter(c) then result.append(" letter") fi
    if char.is_upper(c) then result.append(" upper") fi
    if char.is_lower(c) then result.append(" lower") fi
    if char.is_digit(c) then result.append(" digit") fi
    if char.is_number(c) then result.append(" number") fi
    if char.is_letter_or_digit(c) then result.append(" letter-or-digit") fi
    if char.is_punctuation(c) then result.append(" punctuation") fi
    if char.is_symbol(c) then result.append(" symbol") fi
    if char.is_separator(c) then result.append(" separator") fi
    if char.is_control(c) then result.append(" control") fi
    if char.is_white_space(c) then result.append(" white-space") fi

    return result.to_string()
si

for c in "aZ5 !$\tªǅʰ中אا٣Ⅷ½—«€∀  ́\uD800￿" do
    write_line(flags(c))
od
