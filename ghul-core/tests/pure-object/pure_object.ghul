// A field narrowed by a presence test stays narrowed across reading an
// object's type, which cannot be overridden and stores nothing.
use IO.Std.write_line

class HOLDER is
    _name: string?

    init(name: string) is
        _name = name
    si

    report(value: object) -> string is
        if _name? then
            let type = value.get_type()

            return "{_name.length} {type == typeof HOLDER}"
        fi

        return "absent"
    si
si

entry() is
    let holder = HOLDER("name")

    write_line(holder.report(holder))
si
