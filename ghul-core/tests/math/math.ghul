// Ghul.Math answers as .NET's System.Math does, rounding a value halfway between
// two integers to the even one.
use IO.Std.write_line
use Ghul.Math

entry() is
    write_line("{sqrt(2.0)} {cbrt(27.0)} {pow(2.0, 10.0)}")
    write_line("{abs(-3)} {abs(-3L)} {abs(-2.5)} {sign(-7)} {sign(0.0)}")
    write_line("{min(4, 9)} {max(4L, 9L)} {min(2.5, 1.5)} {max(2.5, 1.5)} {clamp(15, 0, 10)}")
    write_line("{round(2.5)} {round(3.5)} {round(-2.5)} {round(2.6)} {round(1.23456, 2)}")
    write_line("{floor(-1.5)} {ceiling(1.2)} {truncate(-1.7)}")
    write_line("{sin(0.0)} {cos(0.0)} {atan2(1.0, 1.0)} {exp(0.0)}")
    write_line("{log(e)} {log10(1000.0)} {log2(8.0)} {log(8.0, 2.0)}")
    write_line("{pi} {tau} {e}")
    write_line("{min(0.0s, -0.0s)} {max(-0.0s, 0.0s)} {min(0.0, -0.0)} {max(-0.0, 0.0)}")

    write_line("{ieee_remainder(10.0, 3.0)} {ieee_remainder(11.0, 3.0)} {ieee_remainder(5.0, 1.0 / 0.0)} {SCORE(3) <> SCORE(-5)}")

    write_line("{is_nan(0.0 / 0.0)} {is_nan(1.0)} {is_infinity(-1.0 / 0.0)} {is_positive_infinity(-1.0 / 0.0)} {is_negative_infinity(-1.0 / 0.0)} {is_finite(1.0 / 0.0)} {is_finite(2.0)} {is_nan(0.0s / 0.0s)} {is_finite(1.0s)}")
    write_line("{bit_increment(1.0) - 1.0} {1.0 - bit_decrement(1.0)} {bit_increment(0.0)} {bit_decrement(0.0)} {bit_increment(-1.0 / 0.0)} {bit_decrement(1.0 / 0.0)} {bit_increment(1.0 / 0.0)}")
    write_line("{bit_increment(1.0s) - 1.0s} {bit_increment(0.0s)} {bit_decrement(2.0s)} {bit_increment(-2.0)} {bit_increment(1.7976931348623157e308)}")

    try
        abs(-2147483647 - 1)
        write_line("no throw")
    catch ex: Ghul.OverflowException
        write_line("abs of the least int throws")
    yrt

    try
        sign(0.0 / 0.0)
        write_line("no throw")
    catch ex: Ghul.ArithmeticException
        write_line("sign of NaN throws")
    yrt
si

// An ordering a program declares without `pure` has to be provably
// store-free, so the functions it calls must be.
class SCORE(value: int) is
    <>(other: SCORE) -> int => sign(cast double(abs(value) - abs(other.value)))
si
