// Object identity, and letter case beyond ASCII, behave as on .NET.
use IO.Std.write_line

class THING is
    init() is si
si

code(c: char) -> int => cast int(c)

show(value: bool) -> string => if value then "true" else "false" fi

entry() is
    let a = THING()
    let b = THING()
    let o = object()

    write_line("{show(a.equals(a))} {show(a.equals(b))} {show(object.reference_equals(a, a))} {show(object.reference_equals(null, null))}")
    write_line("{show(a.get_hash_code() == a.get_hash_code())} {show(o.equals(o))}")

    // Greek, Cyrillic and Latin Extended-A, written as code points.
    write_line("{code((cast char(0x3B1)).to_upper())} {code((cast char(0x3A9)).to_lower())} {code((cast char(0x3C2)).to_upper())}")
    write_line("{code((cast char(0x3AC)).to_upper())} {code((cast char(0x38F)).to_lower())}")
    write_line("{code((cast char(0x436)).to_upper())} {code((cast char(0x401)).to_lower())}")
    write_line("{code((cast char(0x101)).to_upper())} {code((cast char(0x139)).to_lower())} {code((cast char(0x17F)).to_upper())} {code((cast char(0x130)).to_lower())}")
    write_line("{show((cast char(0x3B2)).is_letter)} {show((cast char(0x416)).is_upper)} {show((cast char(0xDF)).is_lower)} {show('3'.is_letter)}")
    write_line("{"straße".to_upper()} {"ABC".to_lower()}")
si
