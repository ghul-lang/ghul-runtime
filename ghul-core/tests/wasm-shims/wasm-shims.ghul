use IO.Std.write_line
use System.Globalization.CultureInfo

let invariant = CultureInfo.invariant_culture
let whole = 1234
let wide = 9876543210L
let mask = 255L
let half = 2.5
let pi = 3.14159

write_line("name: [{invariant.name}] same: {CultureInfo.current_culture == invariant}")
write_line("int: {whole.to_string("N0", invariant)}")
write_line("long: {wide.to_string("D", invariant)} {mask.to_string("X", invariant)}")
write_line("double: {half.to_string("G", invariant)} {pi.to_string("F2", invariant)}")
write_line("parse: {int.parse("42", invariant)} {long.parse("-7", invariant)} {double.parse("1.5", invariant)}")
write_line("date: {Time.DATE_TIME.parse("2024-02-29", invariant).to_string("yyyy-MM-dd")}")
write_line("title: {invariant.text_info.to_title_case("alphaBETA and NASA, ok")}")
write_line("case: {invariant.text_info.to_upper("ab")} {invariant.text_info.to_lower("CD")}")

System.Environment.set_environment_variable("WASM_SHIM_TEST", "set")
write_line("variable: {System.Environment.get_environment_variable("WASM_SHIM_TEST")}")
System.Environment.set_environment_variable("WASM_SHIM_TEST", "")
write_line("removed: {System.Environment.get_environment_variable("WASM_SHIM_TEST") == null}")
write_line("processors: {System.Environment.processor_count}")
write_line("directory: {System.Environment.current_directory.length > 0}")
let here = System.Environment.current_directory
System.Environment.current_directory = here
write_line("directory again: {System.Environment.current_directory =~ here}")
write_line("bigint: {12345678901234567890n.to_string("N0", invariant)}")

let total = [1, 2, 3] |> Ghul.Pipes.sum_by(n => bigint(n) * 1_000_000_000_000n)
write_line("bigint sum_by: {total}")

System.Environment.exit(0)
write_line("not reached")
