use IO.Std.write_line

// TimeSpan, DateTime and Stopwatch measure and print time as .NET does.
entry() is
    let span = Time.TIME_SPAN(15_000_000L)

    write_line("{span.total_milliseconds} {span.total_seconds}")
    write_line("{span.add(Time.TIME_SPAN.from_milliseconds(500.0)).to_string()}")
    write_line("{span.subtract(Time.TIME_SPAN.from_seconds(3.0)).to_string()}")
    write_line("{span.divide(4.0).ticks}")
    write_line("{Time.TIME_SPAN(900_000_000_123L).to_string()}")
    write_line("{span <> Time.TIME_SPAN.zero} {span =~ Time.TIME_SPAN(15_000_000L)}")

    let started = Time.DATE_TIME.now

    write_line(if started.ticks > 637_134_336_000_000_000L then "after 2020" else "before 2020" fi)

    let watch = Time.STOPWATCH.start_new()
    let first = watch.elapsed_milliseconds

    write_line("{watch.is_running} {first >= 0L}")

    watch.stop()

    let stopped = watch.elapsed_milliseconds

    write_line("{watch.is_running} {stopped >= first} {watch.elapsed_milliseconds == stopped}")

    watch.reset()
    write_line("{watch.elapsed_milliseconds}")

    let later = Time.DATE_TIME.now.subtract(started)

    write_line(if later.ticks >= 0L then "time goes forward" else "time went back" fi)
si
