use default
use Ghul.Threads

// An asynchronous function awaits a thread's result; waiting for the task
// blocks until the thread hands its completion back, rather than throwing
// because nothing on this thread can complete it.
answer() -> Tasks.TASK[int] is
    let worker = start(() => (Tasks.Thread.sleep(20); 6 * 7))
    let result = await worker

    return result
si

write_line("awaited {answer().result}")

// A thread that throws throws again where it is awaited.
failing() -> Tasks.TASK[string] is
    try
        await start(() -> int is throw Ghul.InvalidOperationException("worker failed") si)
        return "no exception"
    catch e: Ghul.InvalidOperationException
        return "caught {e.message}"
    yrt
si

write_line(failing().result)

// A thread that has already finished is awaited without waiting.
finished() -> Tasks.TASK[string] is
    let done = start(() => "early")
    done.join()

    return await done
si

write_line("finished {finished().result}")

// A delay falls due while another task waits on a thread, and both carry
// on, in the order they complete.
let order = LIST[string]()

slow() -> Tasks.TASK is
    await start(() is Tasks.Thread.sleep(200) si)
    order.add("thread")
si

quick() -> Tasks.TASK is
    await Tasks.TASK.delay(10)
    order.add("delay")
si

let both = [slow(), quick()]
both |> each(t => t.wait())
write_line("order {order |> join(", ")}")

// Joining runs the joining thread's own queued work while it waits: the
// worker waits for a flag only that queued work sets.
let flag = AtomicBool(false)

Tasks.TASK.run(() is flag.store(true) si)

let waiter = start(() -> int is
    while !flag.load() do
        Tasks.Thread.sleep(1)
    od

    return 7
si)

write_line("joined {waiter.join()}")

// Several threads awaited from one function, each resuming it in turn.
sum() -> Tasks.TASK[int] is
    let workers = [start(() => (Tasks.Thread.sleep(5 * i); i)) for i in 1::4] |> LIST()
    let total mut = 0

    for w in workers do
        total = total + await w
    od

    return total
si

write_line("sum {sum().result}")
