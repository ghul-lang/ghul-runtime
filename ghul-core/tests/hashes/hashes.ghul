// MD5, SHA-1 and SHA-256 digests, across the message lengths where padding
// spills into a second block, answering as .NET does.
use IO.Std.write_line
use Ghul.Pipes
use System.Security.Cryptography.MD5
use System.Security.Cryptography.SHA1
use System.Security.Cryptography.SHA256

hex(bytes: ARRAY[ubyte]) -> string => bytes |> map(b => "{int(b):x2}") |> join("")

text(length: int) -> ARRAY[ubyte] => System.Text.Encoding.utf8.get_bytes(string('a', length))

entry() is
    let messages = [
        System.Text.Encoding.utf8.get_bytes("abc"),
        System.Text.Encoding.utf8.get_bytes("The quick brown fox jumps over the lazy dog"),
        text(0), text(55), text(56), text(63), text(64), text(65), text(1000)
    ]

    for message in messages do
        write_line("{message.count} {hex(MD5.hash_data(message))}")
        write_line("{message.count} {hex(SHA1.hash_data(message))}")
        write_line("{message.count} {hex(SHA256.hash_data(message))}")
    od
si
