// Tasks on a target with one thread: asynchronous functions returning Future
// and Future[T], awaits on yields, delays and other tasks, results read by
// running queued work, failures through await and through result, and the
// combinators the library offers.
use IO.Std.write_line

double_later(n: int) -> Concurrency.Future[int] is
    await Concurrency.Future.`yield()

    return n * 2
si

sum_of_doubles(count: int) -> Concurrency.Future[int] is
    let total mut = 0

    for i in 1::count do
        total = total + await double_later(i)
    od

    return total
si

after_delay(label: string) -> Concurrency.Future is
    await Concurrency.Future.delay(1)

    write_line("after a delay: {label}")
si

fails() -> Concurrency.Future[int] is
    await Concurrency.Future.`yield()

    throw Ghul.InvalidOperationException("failed inside")
si

awaits_through_the_base() -> Concurrency.Future is
    let task: Concurrency.Future = double_later(5)

    await task

    write_line("awaited through the base: {task.is_completed}")
si

catches() -> Concurrency.Future[string] is
    try
        await fails()

        return "not reached"
    catch e: Ghul.InvalidOperationException
        return "caught: {e.message}"
    yrt
si

entry() is
    write_line("sum: {sum_of_doubles(4).result}")

    after_delay("first").wait()

    write_line(catches().result)

    awaits_through_the_base().wait()

    let tasks: ARRAY[Concurrency.Future] = [Concurrency.Future.from_result(1), Concurrency.Future.completed_task]

    write_line("a task with a result is a task: {tasks[0].is_completed} {tasks[1].is_completed}")

    try
        let _ = fails().result
    catch e: Ghul.AggregateException
        write_line("aggregate: {e.inner_exception?.message}")
    yrt

    write_line("from_result: {Concurrency.Future.from_result(7).result}")
    write_line("completed: {Concurrency.Future.completed_task.is_completed}")

    let continued = Concurrency.Future.from_result(20).continue_with((t: Concurrency.Future[int]) -> int => t.result + 1)

    write_line("continue_with: {continued.result}")

    let all = Concurrency.Future.when_all([double_later(1), double_later(2), double_later(3)])

    write_line("when_all: {all.result[0]} {all.result[1]} {all.result[2]}")

    let nested = Concurrency.Future.from_result(5).continue_with((t: Concurrency.Future[int]) -> Concurrency.Future[int] => double_later(t.result))

    write_line("unwrap: {Tasks.TaskExtensions.unwrap(nested).result}")

    write_line("run: {Concurrency.Future.run(() => 41 + 1).result}")

    try
        Concurrency.Future().wait()
    catch e: Ghul.InvalidOperationException
        write_line("never completes: {e.message}")
    yrt
si
