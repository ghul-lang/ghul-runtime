// Runes and text elements: System.Text.Rune's members, and
// System.Globalization.StringInfo splitting text where .NET splits it, with
// what each throws, against what the same program prints on .NET.
use IO.Std.write_line
use System.Text.Rune
use System.Globalization.StringInfo

// The code points of `text`, in hexadecimal, so the output is plain ASCII.
codes(text: string) -> string is
    let result = Text.STRING_BUILDER()
    let at mut = 0

    while at < text.length do
        if at > 0 then
            result.append(" ")
        fi

        let c = text[at]

        if char.is_high_surrogate(c) /\ at + 1 < text.length /\ char.is_low_surrogate(text[at + 1]) then
            result.append("{char.convert_to_utf32(c, text[at + 1]):X}")
            at = at + 2
        else
            result.append("{cast int(c):X}")
            at = at + 1
        fi
    od

    return result.to_string()
si

elements(text: string) -> string is
    let result = Text.STRING_BUILDER()
    let at mut = 0

    while at < text.length do
        let element = StringInfo.get_next_text_element(text, at)

        result.append("[{codes(element)}]")
        at = at + element.length
    od

    return result.to_string()
si

attempt(name: string, f: () -> string) is
    try
        write_line("{name}: {f()}")
    catch e: Ghul.Exception
        // .NET adds the parameter's name, and sometimes its value, after the
        // message; only the message itself is compared.
        let cut = e.message.index_of(" (Parameter")
        let message = if cut >= 0 then e.message.substring(0, cut) else e.message fi

        write_line("{name}: {e.get_type().name}: {message}")
    yrt
si

let samples = [
    "knights",
    "\uD835\uDD28\uD835\uDD2B\uD835\uDD26",
    "e\u0301te\u0301",
    "a\r\nb\n\rc",
    "\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67!",
    "\uD83C\uDDEC\uD83C\uDDE7\uD83C\uDDEB\uD83C\uDDF7\uD83C\uDDEE",
    "\uD83D\uDC4D\uD83C\uDFFD\uD83D\uDC4D",
    "\u1100\u1161\u11A8\uAC00\u11A8\uAC01\u1161",
    "\u0915\u094D\u0937\u093F",
    "\u0600\u0661\u0662",
    "a\uD800b\uDC00\u0301",
    "\u0001\u0301\u00AD\u0300",
    "\uD81B\uDD63\uD81B\uDD67x",
    ""
]

for text in samples do
    let info = StringInfo(text)
    write_line("{codes(text)} => {info.length_in_text_elements}: {elements(text)}")
    write_line("    starts {StringInfo.parse_combining_characters(text) |> string(",")}")
od

let fraktur = StringInfo(samples[1])
attempt("no first", () => codes(fraktur.substring_by_text_elements(1)))
attempt("no last", () => codes(fraktur.substring_by_text_elements(0, fraktur.length_in_text_elements - 1)))
attempt("no ends", () => codes(fraktur.substring_by_text_elements(1, fraktur.length_in_text_elements - 2)))
attempt("none taken", () => codes(fraktur.substring_by_text_elements(2, 0)))
attempt("start below", () => StringInfo("abc").substring_by_text_elements(-1))
attempt("start past", () => StringInfo("abc").substring_by_text_elements(3))
attempt("start in empty", () => StringInfo().substring_by_text_elements(0))
attempt("too long", () => StringInfo("abc").substring_by_text_elements(1, 3))
attempt("negative length", () => StringInfo("abc").substring_by_text_elements(1, -1))
attempt("length at end", () => "{StringInfo.get_next_text_element_length("abc", 3)}")
attempt("length below", () => "{StringInfo.get_next_text_element_length("abc", -1)}")
attempt("length past", () => "{StringInfo.get_next_text_element_length("abc", 4)}")
attempt("first element", () => codes(StringInfo.get_next_text_element(samples[2])))
attempt("first length", () => "{StringInfo.get_next_text_element_length(samples[4])}")

let face = Rune.get_rune_at("a\uD83D\uDE00", 1)
write_line("{face.value:X} {face.utf16_sequence_length} {face.utf8_sequence_length} {face.is_ascii} {face.is_bmp} {face.plane}")
write_line("{codes(face.to_string())} {codes("{face}")} {codes(Rune.replacement_char.to_string())}")

let a = Rune('a')
let e_acute = Rune(0xE9)
let euro = Rune(0x20AC)
write_line("{a} {a.value} {a.utf8_sequence_length} {a.is_ascii} {e_acute.utf8_sequence_length} {euro.utf8_sequence_length} {euro.utf16_sequence_length}")
write_line("{Rune(cast char(0xD83D), cast char(0xDE00)) =~ face} {a =~ Rune(97)} {a =~ euro} {a.get_hash_code() == Rune(97).get_hash_code()}")
write_line("{a.compare_to(Rune('d'))} {euro.compare_to(a) > 0} {a.compare_to(a)}")
write_line("{Rune.is_valid(0x10FFFF)} {Rune.is_valid(0x110000)} {Rune.is_valid(0xD800)} {Rune.is_valid(-1)}")

attempt("surrogate value", () => "{Rune(0xDC00)}")
attempt("value too big", () => "{Rune(0x110000)}")
attempt("surrogate char", () => "{Rune(cast char(0xD800))}")
attempt("not a pair", () => "{Rune('a', 'b')}")
attempt("lone surrogate", () => "{Rune.get_rune_at(samples[10], 1)}")
attempt("index past", () => "{Rune.get_rune_at("a", 5)}")
