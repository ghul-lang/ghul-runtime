{
    // How the tests are run: each is a ghul-cli project, built by the
    // ghul-cli the tool manifest pins, with the compiler it pins. `tests`
    // runs by default and builds each project for the first target its
    // manifest lists; `llvm` builds every project that lists llvm as a
    // native executable, with the ghul-llvm release ghul-cli fetches for
    // the compiler. Each llvm build runs as its own variant, so an
    // expectation named for the target (`run.llvm.expected`,
    // `fail.llvm.expected`) records where llvm differs.
    "default": "tests",
    "configurations": {
        "tests": {
            "build": "ghul-cli",
            "ghul": "dotnet ghul"
        },
        "llvm": {
            "extends": "tests",
            "build_targets": ["llvm"]
        },

        // The tests that compare the library's own code with .NET's: they
        // build for .NET, which ghul-cli does not, so each is an SDK
        // project with its sources named in a .ghulproj and is built with
        // `dotnet build`, by the compiler the tool manifest pins.
        "dotnet": {
            "build": "msbuild",
            "compiler": "project"
        }
    }
}
